# ==========================================
# SATUSITE STUDIO ENVIRONMENT VARIABLES
# ==========================================

# 1. MongoDB Connection (Cloud Atlas / Local)
# Dapatkan connection string dari MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=satusite_db

# 2. AI Model API Key (Gemini Pro / Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Environment Mode
NODE_ENV=development
