---
interface Props {
  activePage?:
    | "home"
    | "product"
    | "templates"
    | "resources"
    | "pricing"
    | "about"
    | "studio";
}

const { activePage = "home" } = Astro.props;
---

<header
  id="main-header-nav"
  class="sticky top-0 z-50 px-4 sm:px-6 py-3.5 bg-transparent border-b border-transparent transition-[transform,background-color,border-color,box-shadow] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform translate-y-0"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0">
      <img
        src="/logo.png"
        alt="satusitE Logo"
        class="w-5 h-5 sm:w-5.5 sm:h-5.5 object-contain transition-transform group-hover:scale-105"
      />
      <span
        class="font-agus text-sm sm:text-base font-normal tracking-[0.35em] text-white"
      >
        satusitE
      </span>
    </a>

    <!-- Desktop Navigation Links with Clean Minimalist Mega Menus -->
    <nav
      class="hidden lg:flex items-center gap-1 text-xs font-medium text-zinc-300"
    >
      <!-- 1. PRODUCT DROPDOWN (FULL WIDTH CLEAN MEGA MENU) -->
      <div class="group/nav">
        <button
          type="button"
          class={`px-3.5 py-2 rounded-lg hover:text-white hover:bg-zinc-900/70 transition-all flex items-center gap-1.5 cursor-pointer ${activePage === "product" ? "text-white bg-zinc-900/60 font-semibold" : ""}`}
          aria-haspopup="true"
        >
          <span>Product</span>
          <i
            class="fa-solid fa-chevron-down text-[9px] text-zinc-500 group-hover/nav:text-zinc-300 group-hover/nav:rotate-180 transition-transform duration-200"
          ></i>
        </button>

        <!-- Full-Width Dropdown Bar -->
        <div
          class="invisible opacity-0 group-hover/nav:visible group-hover/nav:opacity-100 transition-all duration-200 absolute top-full left-0 right-0 w-full bg-[#08080a]/95 border-b border-zinc-800/80 shadow-[0_30px_90px_rgba(0,0,0,0.95)] backdrop-blur-3xl z-50 before:content-[''] before:absolute before:-top-3 before:left-0 before:right-0 before:h-3"
        >
          <div class="max-w-7xl mx-auto px-6 py-6 sm:py-7">
            <div class="grid grid-cols-12 gap-8 items-center">
              <!-- Left Sidebar Overview (3 cols) -->
              <div class="col-span-3 border-r border-zinc-800/70 pr-6">
                <div
                  class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-[10px] font-medium text-zinc-400 mb-2"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
                  <span>PRODUCT PLATFORM</span>
                </div>
                <h3 class="text-sm font-bold text-white mb-1">
                  Autonomous AI Studio
                </h3>
                <p class="text-xs text-zinc-400 leading-relaxed mb-4">
                  Pilih mode pengembangan untuk merancang antarmuka, logika
                  full-stack, atau blueprint spesifikasi.
                </p>
                <a
                  href="/studio"
                  class="inline-flex items-center gap-2 text-xs font-semibold text-white hover:text-blue-400 transition-colors cursor-pointer"
                >
                  <span>Buka Pilihan Studio</span>
                  <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
              </div>

              <!-- Right 4-Grid Cards Clean & Minimalist (9 cols) -->
              <div class="col-span-9 grid grid-cols-2 gap-3">
                <!-- Item 1: AI Recommended Studio -->
                <a
                  href="/app?mode=ai-recommended"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3.5">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
                    </div>
                    <div>
                      <div
                        class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >
                        AI Recommended
                      </div>
                    </div>
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- Item 2: Studio Frontend -->
                <a
                  href="/studio/frontend"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3.5">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-table-columns text-xs"></i>
                    </div>
                    <div>
                      <div
                        class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >
                        Studio Frontend
                      </div>
                    </div>
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- Item 3: Studio Fullstack -->
                <a
                  href="/studio/fullstack"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3.5">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-database text-xs"></i>
                    </div>
                    <div>
                      <div
                        class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >
                        Studio Fullstack
                      </div>
                    </div>
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- Item 4: Studio PRD -->
                <a
                  href="/studio/prd"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3.5">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-regular fa-file-lines text-xs"></i>
                    </div>
                    <div>
                      <div
                        class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >
                        Studio PRD & Blueprint
                      </div>
                    </div>
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. TEMPLATE LINK (DIRECT LINK, NO DROPDOWN) -->
      <a
        href="/templates"
        class={`px-3.5 py-2 rounded-lg hover:text-white hover:bg-zinc-900/70 transition-all cursor-pointer ${activePage === "templates" ? "text-white bg-zinc-900/60 font-semibold" : ""}`}
      >
        <span>Template</span>
      </a>

      <!-- 3. RESOURCE DROPDOWN (FULL WIDTH CLEAN MEGA MENU) -->
      <div class="group/nav">
        <button
          type="button"
          class={`px-3.5 py-2 rounded-lg hover:text-white hover:bg-zinc-900/70 transition-all flex items-center gap-1.5 cursor-pointer ${activePage === "resources" ? "text-white bg-zinc-900/60 font-semibold" : ""}`}
          aria-haspopup="true"
        >
          <span>Resource</span>
          <i
            class="fa-solid fa-chevron-down text-[9px] text-zinc-500 group-hover/nav:text-zinc-300 group-hover/nav:rotate-180 transition-transform duration-200"
          ></i>
        </button>

        <!-- Full-Width Dropdown Bar -->
        <div
          class="invisible opacity-0 group-hover/nav:visible group-hover/nav:opacity-100 transition-all duration-200 absolute top-full left-0 right-0 w-full bg-[#08080a]/95 border-b border-zinc-800/80 shadow-[0_30px_90px_rgba(0,0,0,0.95)] backdrop-blur-3xl z-50 before:content-[''] before:absolute before:-top-3 before:left-0 before:right-0 before:h-3"
        >
          <div class="max-w-7xl mx-auto px-6 py-6 sm:py-7">
            <div class="grid grid-cols-12 gap-8 items-center">
              <!-- Left Sidebar Overview (3 cols) -->
              <div class="col-span-3 border-r border-zinc-800/70 pr-6">
                <div
                  class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-[10px] font-medium text-zinc-400 mb-2"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
                  <span>RESOURCE & TOOLING</span>
                </div>
                <h3 class="text-sm font-bold text-white mb-1">
                  Ekosistem & Otomasi
                </h3>
                <p class="text-xs text-zinc-400 leading-relaxed mb-4">
                  Dukungan terintegrasi untuk QA testing, kontrol versi Git,
                  dokumentasi, dan deployment cloud.
                </p>
                <a
                  href="/deploy"
                  class="inline-flex items-center gap-2 text-xs font-semibold text-white hover:text-blue-400 transition-colors cursor-pointer"
                >
                  <span>Buka Deploy Hub</span>
                  <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
              </div>

              <!-- Right 5-Grid Items Clean & Minimalist (9 cols) -->
              <div class="col-span-9 grid grid-cols-3 gap-3">
                <!-- Resource 1: GitHub -->
                <a
                  href="/github"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-brands fa-github text-xs"></i>
                    </div>
                    <span
                      class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >GitHub</span
                    >
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- Resource 2: Testing -->
                <a
                  href="/testing"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-shield-halved text-xs"></i>
                    </div>
                    <span
                      class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >Testing QA</span
                    >
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- Resource 3: Deploy -->
                <a
                  href="/deploy"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-rocket text-xs"></i>
                    </div>
                    <span
                      class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >Deploy Hub</span
                    >
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- Resource 4: Tutorial -->
                <a
                  href="/tutorial"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-book-open text-xs"></i>
                    </div>
                    <span
                      class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >Tutorial & Docs</span
                    >
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- Resource 5: Connectors -->
                <a
                  href="/connectors"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item col-span-2"
                >
                  <div class="flex items-center gap-3">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-plug text-xs"></i>
                    </div>
                    <span
                      class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >Connectors & API</span
                    >
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. PRICING LINK (HALAMAN KHUSUS TERPISAH) -->
      <a
        href="/pricing"
        class={`px-3.5 py-2 rounded-lg hover:text-white hover:bg-zinc-900/70 transition-all cursor-pointer ${activePage === "pricing" ? "text-white bg-zinc-900/60 font-semibold" : ""}`}
      >
        <span>Pricing</span>
      </a>

      <!-- 5. ABOUT DROPDOWN (FULL WIDTH CLEAN MEGA MENU) -->
      <div class="group/nav">
        <button
          type="button"
          class={`px-3.5 py-2 rounded-lg hover:text-white hover:bg-zinc-900/70 transition-all flex items-center gap-1.5 cursor-pointer ${activePage === "about" ? "text-white bg-zinc-900/60 font-semibold" : ""}`}
          aria-haspopup="true"
        >
          <span>About</span>
          <i
            class="fa-solid fa-chevron-down text-[9px] text-zinc-500 group-hover/nav:text-zinc-300 group-hover/nav:rotate-180 transition-transform duration-200"
          ></i>
        </button>

        <!-- Full-Width Dropdown Bar -->
        <div
          class="invisible opacity-0 group-hover/nav:visible group-hover/nav:opacity-100 transition-all duration-200 absolute top-full left-0 right-0 w-full bg-[#08080a]/95 border-b border-zinc-800/80 shadow-[0_30px_90px_rgba(0,0,0,0.95)] backdrop-blur-3xl z-50 before:content-[''] before:absolute before:-top-3 before:left-0 before:right-0 before:h-3"
        >
          <div class="max-w-7xl mx-auto px-6 py-6 sm:py-7">
            <div class="grid grid-cols-12 gap-8 items-center">
              <!-- Left Sidebar Overview (3 cols) -->
              <div class="col-span-3 border-r border-zinc-800/70 pr-6">
                <div
                  class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-[10px] font-medium text-zinc-400 mb-2"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
                  <span>ABOUT PLATFORM</span>
                </div>
                <h3 class="text-sm font-bold text-white mb-1">
                  Tentang Satusite
                </h3>
                <p class="text-xs text-zinc-400 leading-relaxed mb-4">
                  Platform perancangan aplikasi otonom berbasis generative AI
                  berstandar web modern.
                </p>
                <a
                  href="/about#contact"
                  class="inline-flex items-center gap-2 text-xs font-semibold text-white hover:text-blue-400 transition-colors cursor-pointer"
                >
                  <span>Hubungi Tim Kami</span>
                  <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
              </div>

              <!-- Right 4-Grid Cards Clean & Minimalist (9 cols) -->
              <div class="col-span-9 grid grid-cols-2 gap-3">
                <!-- About 1: Profil Satusite -->
                <a
                  href="/about"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3.5">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-circle-info text-xs"></i>
                    </div>
                    <span
                      class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >Tentang Satusite</span
                    >
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- About 2: Contact Us -->
                <a
                  href="/about#contact"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3.5">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-regular fa-envelope text-xs"></i>
                    </div>
                    <span
                      class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >Contact Us</span
                    >
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- About 3: Developer Profile -->
                <a
                  href="/about#developer"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3.5">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-laptop-code text-xs"></i>
                    </div>
                    <span
                      class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >Developer & Tim</span
                    >
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>

                <!-- About 4: Tech Stack -->
                <a
                  href="/about#tech"
                  class="p-3.5 rounded-xl bg-zinc-900/40 hover:bg-zinc-900/90 border border-zinc-800/60 hover:border-zinc-700/80 transition-all flex items-center justify-between group/item"
                >
                  <div class="flex items-center gap-3.5">
                    <div
                      class="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 group-hover/item:text-white group-hover/item:border-zinc-700 group-hover/item:bg-zinc-800 flex items-center justify-center shrink-0 transition-all"
                    >
                      <i class="fa-solid fa-microchip text-xs"></i>
                    </div>
                    <span
                      class="text-xs font-semibold text-zinc-200 group-hover/item:text-white transition-colors"
                      >Teknologi & Engine</span
                    >
                  </div>
                  <i
                    class="fa-solid fa-chevron-right text-[9px] text-zinc-600 group-hover/item:text-zinc-300 group-hover/item:translate-x-0.5 transition-all"
                  ></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Right Action Items -->
    <div class="flex items-center gap-2.5">
      <!-- 1. Logged-out Login Button -->
      <a
        id="nav-btn-login"
        href="/login"
        class="px-3 py-1.5 rounded-lg border border-zinc-800 hover:border-zinc-700 bg-zinc-900/60 text-xs font-medium text-zinc-300 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer"
      >
        <i class="fa-regular fa-user text-zinc-400 text-xs"></i>
        <span>Masuk</span>
      </a>

      <!-- 2. Logged-in Account Dropdown Menu (Hidden if not logged in) -->
      <div class="relative hidden" id="nav-account-dropdown-container">
        <button
