<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // 0. Seamless Header Scroll & Smooth Auto-Hide Effect
    const headerNav = document.getElementById("main-header-nav");
    const mobileNavDrawer = document.getElementById("mobile-nav-drawer");

    if (headerNav) {
      let lastScrollY = window.scrollY;
      let isTicking = false;

      const handleScroll = () => {
        const currentScrollY = window.scrollY;
        const isMobileDrawerOpen =
          mobileNavDrawer && !mobileNavDrawer.classList.contains("hidden");

        // 1. Glassmorphism Background Transition (no height jump, smooth colors)
        if (currentScrollY > 20) {
          headerNav.classList.add(
            "bg-[#08080a]/90",
            "backdrop-blur-xl",
            "border-zinc-800/80",
            "shadow-[0_10px_30px_rgba(0,0,0,0.6)]",
          );
          headerNav.classList.remove(
            "bg-transparent",
            "border-transparent",
            "shadow-none",
          );
        } else {
          headerNav.classList.remove(
            "bg-[#08080a]/90",
            "backdrop-blur-xl",
            "border-zinc-800/80",
            "shadow-[0_10px_30px_rgba(0,0,0,0.6)]",
          );
          headerNav.classList.add(
            "bg-transparent",
            "border-transparent",
            "shadow-none",
          );
        }

        // 2. Smooth Auto-Hide: Reveal near top, hide on deliberate scroll down, reveal on scroll up
        if (currentScrollY <= 60) {
          // Near top: always reveal header smoothly
          headerNav.classList.remove("-translate-y-full");
          headerNav.classList.add("translate-y-0");
        } else if (!isMobileDrawerOpen) {
          const delta = currentScrollY - lastScrollY;
          if (delta > 10 && currentScrollY > 100) {
            // Deliberate scroll down -> Auto hide
            headerNav.classList.add("-translate-y-full");
            headerNav.classList.remove("translate-y-0");
          } else if (delta < -8) {
            // Deliberate scroll up -> Smooth reveal
            headerNav.classList.remove("-translate-y-full");
            headerNav.classList.add("translate-y-0");
          }
        }

        lastScrollY = Math.max(0, currentScrollY);
        isTicking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (!isTicking) {
            window.requestAnimationFrame(handleScroll);
            isTicking = true;
          }
        },
        { passive: true },
      );

      handleScroll();
    }

    // 1. Mobile Menu Toggle
    const btnMobileToggle = document.getElementById("btn-mobile-menu-toggle");
    const iconMobileMenu = document.getElementById("icon-mobile-menu");

    if (btnMobileToggle && mobileNavDrawer) {
      btnMobileToggle.addEventListener("click", () => {
        const isHidden = mobileNavDrawer.classList.contains("hidden");
        if (isHidden) {
          mobileNavDrawer.classList.remove("hidden");
          if (iconMobileMenu) {
            iconMobileMenu.classList.remove("fa-bars");
            iconMobileMenu.classList.add("fa-xmark");
          }
        } else {
          mobileNavDrawer.classList.add("hidden");
          if (iconMobileMenu) {
            iconMobileMenu.classList.remove("fa-xmark");
            iconMobileMenu.classList.add("fa-bars");
          }
        }
      });
    }

    // 2. Auth State Sync
    try {
      const storedUser = localStorage.getItem("satusite_auth_user");
      const btnLogin = document.getElementById("nav-btn-login");
      const accountContainer = document.getElementById(
        "nav-account-dropdown-container",
      );
      const btnAccount = document.getElementById("nav-btn-account");
      const accountMenu = document.getElementById("nav-account-menu");
      const accountChevron = document.getElementById("nav-account-chevron");

      if (storedUser) {
        const user = JSON.parse(storedUser);
        if (btnLogin) btnLogin.classList.add("hidden");
        if (accountContainer) accountContainer.classList.remove("hidden");

        const navUserName = document.getElementById("nav-user-name");
        const navMenuUserName = document.getElementById("nav-menu-user-name");
        const navMenuUserEmail = document.getElementById("nav-menu-user-email");
        const navMenuUserRole = document.getElementById("nav-menu-user-role");
        const navUserAvatar = document.getElementById("nav-user-avatar");
        const navMenuAvatar = document.getElementById("nav-menu-avatar");

        const displayName = user.name || user.email?.split("@")[0] || "Akun";
        if (navUserName) navUserName.textContent = displayName;
        if (navMenuUserName) navMenuUserName.textContent = displayName;
        if (navMenuUserEmail) navMenuUserEmail.textContent = user.email || "";

        const avatarUrl =
          user.avatar ||
          `https://api.dicebear.com/7.x/initials/svg?seed=${encodeURIComponent(displayName)}&backgroundColor=18181b`;
        if (navUserAvatar) navUserAvatar.src = avatarUrl;
        if (navMenuAvatar) navMenuAvatar.src = avatarUrl;

        const role = user.role || "user";
        if (navMenuUserRole) {
          navMenuUserRole.textContent =
            role === "superadmin"
              ? "Superadmin"
              : role === "admin"
                ? "Admin"
                : "Gratis";
        }

        const adminLink = document.getElementById("nav-link-admin-panel");
        if (
          adminLink &&
          (role === "admin" ||
            role === "superadmin" ||
            (user.email && user.email.toLowerCase() === "dekaze08@gmail.com"))
        ) {
          adminLink.classList.remove("hidden");
        }

        if (btnAccount && accountMenu) {
          btnAccount.addEventListener("click", (e) => {
            e.stopPropagation();
            const isMenuHidden = accountMenu.classList.contains("hidden");
            if (isMenuHidden) {
              accountMenu.classList.remove("hidden");
              if (accountChevron) accountChevron.classList.add("rotate-180");
            } else {
              accountMenu.classList.add("hidden");
              if (accountChevron) accountChevron.classList.remove("rotate-180");
            }
          });

          document.addEventListener("click", (e) => {
            if (accountContainer && !accountContainer.contains(e.target)) {
              accountMenu.classList.add("hidden");
              if (accountChevron) accountChevron.classList.remove("rotate-180");
            }
          });
        }

        const btnLogout = document.getElementById("nav-btn-logout");
        if (btnLogout) {
          btnLogout.addEventListener("click", () => {
            localStorage.removeItem("satusite_auth_user");
            localStorage.removeItem("satusite_auth_token");
            window.location.reload();
          });
        }
      } else {
        if (btnLogin) btnLogin.classList.remove("hidden");
        if (accountContainer) accountContainer.classList.add("hidden");
      }

      // Studio Auth Gate for Header and CTA Links
      const btnHeaderStudio = document.getElementById("btn-header-open-studio");
      if (btnHeaderStudio) {
        btnHeaderStudio.addEventListener("click", (e) => {
          const isAuthed = localStorage.getItem("satusite_auth_user");
          if (!isAuthed) {
            e.preventDefault();
            window.location.href = "/login";
          }
        });
      }

      // Global interceptor for studio and app links
      document
        .querySelectorAll('a[href="/app"], a[href^="/app?"], a[href="/studio"], a[href^="/studio/"], a[href^="/studio?"]')
        .forEach((link) => {
          link.addEventListener("click", (e) => {
            const isAuthed = localStorage.getItem("satusite_auth_user");
            if (!isAuthed) {
              e.preventDefault();
              window.location.href = "/login";
            }
          });
        });
    } catch (err) {
      console.warn("Header auth init warning:", err);
    }
  });
</script>
