---
import Layout from '../layouts/Layout.astro';
import PrdSheetViewer from '@/components/PrdSheetViewer';
import FrontendCanvasViewer from '@/components/FrontendCanvasViewer';
---

<Layout>
    <!-- ============================= -->
    <!-- SCREEN 2: STEP-BY-STEP APP    -->
    <!-- ============================= -->
    <div id="screen-app" class="relative min-h-screen">
        <!-- ✦ Cinematic: Grid Background for app screen -->
        <div class="app-bg-grid"></div>

    <!-- Hero Section -->
    <section class="relative pt-16 pb-16 lg:pt-20 lg:pb-24 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-panel border border-white/10 text-xs font-medium text-gray-300 mb-3 mx-auto reveal">
                <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                <span id="active-project-name">Project</span>
            </div>
            <button id="btn-back-to-landing" type="button" class="block mx-auto mb-5 text-[11px] text-white/90 hover:text-white transition-colors">
                <i class="fa-solid fa-arrow-left mr-1"></i>Ganti Project
            </button>
            <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 reveal" style="animation-delay: 0.1s;">
                Langkah-Langkah <br class="hidden md:block" />
                <span class="gradient-text inline-flex flex-col items-center justify-center align-top leading-none">
                    <span class="font-sans uppercase">SASITE</span>
                    <span class="text-cyan-400 drop-shadow-[0_0_12px_rgba(34,211,238,0.4)]" style="font-family: 'Dancing Script', cursive; font-weight: 400; font-size: 0.65em; margin-top: -0.4em;">Studio</span>
                </span>
            </h1>
            <p class="mt-4 max-w-2xl text-lg text-gray-400 mx-auto mb-10 reveal" style="animation-delay: 0.2s;">
                Centang setiap prosesnya. Progres Anda akan otomatis tersimpan di browser. Mari kita bangun website luar biasa mulai dari Planning hingga Testing.
            </p>
        </div>
    </section>

    <!-- Main Content Container -->
    <div id="app-layout-wrapper" class="max-w-7xl mx-auto px-6 lg:px-8 relative pb-20 flex gap-6 transition-all duration-500">
    <div id="task-column" class="w-full max-w-4xl mx-auto transition-all duration-500">

        <!-- Progres Proyek (Above navigation) -->
        <div class="mb-6 md:mb-8">
            <div class="glass-panel p-4 rounded-2xl shadow-[0_10px_40px_-10px_rgba(0,0,0,0.8)] border-white/20">
                <div class="flex justify-between items-end mb-2">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-spinner animate-spin text-gray-300" id="progress-spinner"></i>
                            Progres Proyek
                        </h3>
                    </div>
                    <span id="progress-text" class="text-xs font-bold text-gray-200 bg-white/10 px-2 py-1 rounded-md">0 / 22 Selesai</span>
                </div>
                
                <!-- Progress Bar -->
                <div class="w-full h-2.5 bg-gray-800 rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-white transition-all duration-500 ease-out" style="width: 0%;"></div>
                </div>
                
                <!-- Congratulation Message (Hidden by default) -->
                <div id="congrats-msg" class="hidden mt-3 text-center text-xs text-white font-medium animate-fade-in-up">
                    <i class="fa-solid fa-party-horn mr-1"></i> Luar biasa! Semua proses telah selesai!
                </div>
            </div>
        </div>

        <!-- Stepper Nav (Centered single item with animation) -->
        <div id="stepper-nav" class="mb-8 md:mb-12 select-none relative">
            <div class="flex items-center justify-center gap-6 md:gap-12">
                <!-- Kembali -->
                <button id="btn-slide-prev" type="button" class="shrink-0 w-10 h-10 md:w-11 md:h-11 rounded-full glass-panel border border-white/10 text-gray-300 hover:border-white/30 hover:text-white transition-all duration-300 flex items-center justify-center disabled:opacity-30 disabled:pointer-events-none z-10" aria-label="Kembali ke langkah sebelumnya">
                    <i class="fa-solid fa-arrow-left text-sm"></i>
                </button>

                <!-- Dynamic Centered Nav -->
                <div id="dynamic-nav-container" class="w-40 md:w-56 flex justify-center items-center relative h-16 md:h-20 overflow-hidden">
                    <!-- Dynamic content injected via JS -->
                </div>

                <!-- Lanjut -->
                <button id="btn-slide-next" type="button" class="shrink-0 w-10 h-10 md:w-11 md:h-11 rounded-full glass-panel border border-white/10 text-gray-300 hover:border-white/30 hover:text-white transition-all duration-300 flex items-center justify-center z-10" aria-label="Lanjut ke langkah berikutnya">
                    <i class="fa-solid fa-arrow-right text-sm"></i>
                </button>
            </div>

            <div class="text-center mt-3">
                <span id="slide-position-label" class="text-xs text-gray-500 font-medium tracking-wide">1 / 6</span>
            </div>
        </div>

        <!-- Slides Viewport -->
        <div id="slides-viewport" class="relative">

        <!-- 1. Planning Section -->
        <section id="prd" class="slide-panel slide-active relative z-10 pb-4">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center shrink-0 text-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.2)]">
                    <i class="fa-solid fa-lightbulb text-sm"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-white">1. Planning</h2>
                    <span class="text-xs text-cyan-400 font-semibold tracking-wide">Konsep & Rencana Website</span>
                </div>
            </div>
            <p class="text-gray-400 mb-6 text-sm">Susun konsep, halaman, dan fitur website impianmu secara instan bersama AI. Pilih salah satu metode di bawah.</p>
            
            <div class="flex flex-col gap-4">
                
                <!-- Task PRD 1: Wizard Kilat AI (⭐ Rekomendasi Utama) -->
                <div class="prd-task-wrapper">
                    <label class="task-container flex items-start gap-4 p-5 rounded-xl glass-panel cursor-pointer border border-cyan-500/30 bg-gradient-to-r from-cyan-950/20 via-neutral-900/40 to-neutral-900/60" onclick="togglePrdInput('wizard')">
                        <input type="checkbox" data-group="prd-method" id="task-prd-1" class="task-checkbox hidden">
                        <div class="w-6 h-6 rounded border-2 border-cyan-400/60 flex items-center justify-center shrink-0 transition-colors mt-0.5">
                            <i class="fa-solid fa-check text-cyan-400 text-xs opacity-0 transition-opacity"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 mb-1">
                                <h4 class="task-title font-bold text-white transition-all duration-300">Wizard Kilat AI</h4>
                                <span class="px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 text-[10px] font-bold tracking-wide border border-cyan-500/30">⭐ Paling Mudah</span>
                            </div>
                            <p class="text-sm text-gray-300 mt-1 task-desc">Cukup pilih kategori, nama bisnis, dan fitur siap pakai. AI akan otomatis meracik Cetak Biru Planning lengkap dalam hitungan detik.</p>
                            <button type="button" class="prd-gen-toggle mt-4 px-4 py-2 text-xs font-semibold rounded-lg bg-cyan-500 hover:bg-cyan-400 text-neutral-950 transition-all shadow-[0_0_20px_rgba(6,182,212,0.3)] flex items-center gap-2" onclick="event.preventDefault(); event.stopPropagation(); togglePrdInput('wizard')">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Buka Wizard Kilat AI
                            </button>
                        </div>
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-cyan-400 hover:bg-cyan-500/10 transition-all duration-300 self-center" data-task="task-prd-1" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-prd-1');" aria-label="Lihat detail proses Wizard Kilat AI"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                    <!-- Inline expandable input for Wizard -->
                    <div id="prd-input-wizard" class="prd-inline-input hidden overflow-hidden transition-all duration-400 ease-out" style="max-height:0; opacity:0;">
                        <div class="mt-2 p-5 rounded-xl glass-panel border border-cyan-500/30 bg-[#16161a]">
                            <div class="flex items-center gap-2 mb-4">
                                <i class="fa-solid fa-wand-magic-sparkles text-cyan-400 text-sm"></i>
                                <span class="text-sm font-bold text-white">AI Planning Wizard — 3 Langkah Mudah</span>
                            </div>

                            <!-- Step 1: Category Chips -->
                            <div class="mb-4">
                                <label class="block text-xs font-semibold text-gray-300 mb-2">1. Pilih Kategori Website</label>
                                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="wizard-category-group">
                                    <button type="button" class="wizard-cat-btn px-3 py-2 rounded-lg border border-cyan-400/50 bg-cyan-500/15 text-cyan-300 text-xs font-semibold text-left transition-all" data-value="Toko Online & UMKM" onclick="selectWizardCat(this)">🏪 Toko & UMKM</button>
                                    <button type="button" class="wizard-cat-btn px-3 py-2 rounded-lg border border-white/10 bg-white/5 text-gray-300 text-xs font-semibold text-left hover:border-white/20 transition-all" data-value="Jasa & Profil Bisnis" onclick="selectWizardCat(this)">💼 Jasa & Bisnis</button>
                                    <button type="button" class="wizard-cat-btn px-3 py-2 rounded-lg border border-white/10 bg-white/5 text-gray-300 text-xs font-semibold text-left hover:border-white/20 transition-all" data-value="Portofolio & Kreatif" onclick="selectWizardCat(this)">🎨 Portofolio / CV</button>
                                    <button type="button" class="wizard-cat-btn px-3 py-2 rounded-lg border border-white/10 bg-white/5 text-gray-300 text-xs font-semibold text-left hover:border-white/20 transition-all" data-value="Resto, Cafe & Kuliner" onclick="selectWizardCat(this)">🍽️ Resto & Kafe</button>
                                    <button type="button" class="wizard-cat-btn px-3 py-2 rounded-lg border border-white/10 bg-white/5 text-gray-300 text-xs font-semibold text-left hover:border-white/20 transition-all" data-value="Sekolah & Edukasi" onclick="selectWizardCat(this)">🏫 Sekolah / Edukasi</button>
                                    <button type="button" class="wizard-cat-btn px-3 py-2 rounded-lg border border-white/10 bg-white/5 text-gray-300 text-xs font-semibold text-left hover:border-white/20 transition-all" data-value="Event & Undangan" onclick="selectWizardCat(this)">📅 Event & Undangan</button>
                                </div>
                                <input type="hidden" id="prd-wizard-category" value="Toko Online & UMKM">
                            </div>

                            <!-- Step 2: Name & Brief Info -->
                            <div class="mb-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-300 mb-1">2. Nama Bisnis / Website</label>
                                    <input type="text" id="prd-wizard-name" placeholder="Contoh: Kopi Senja Bandung" class="w-full bg-black/40 border border-white/10 rounded-lg px-3.5 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-cyan-400 transition-colors">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-300 mb-1">Gaya Desain & Nuansa Warna</label>
                                    <select id="prd-wizard-style" class="w-full bg-neutral-900 border border-white/10 rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-cyan-400 transition-colors">
                                        <option value="Modern Cyan & Dark Luxury">🌙 Gelap & Mewah (Dark Luxury & Cyan)</option>
                                        <option value="Clean Minimalist Light">☀️ Terang & Bersih (Clean Minimalist)</option>
                                        <option value="Natural Organic Pastel">🌿 Natural & Pastel (Fresh Emerald)</option>
                                        <option value="High-Tech Futuristic Neon">⚡ Modern High-Tech (Cyber Blue)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Step 3: Feature Checkboxes -->
                            <div class="mb-4">
                                <label class="block text-xs font-semibold text-gray-300 mb-2">3. Centang Fitur yang Dibutuhkan</label>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-gray-300" id="wizard-features-container">
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/5 cursor-pointer hover:bg-white/10">
                                        <input type="checkbox" value="Tombol Order / Chat WhatsApp Langsung" checked class="wizard-feat-check rounded bg-black/40 border-white/20 text-cyan-500 focus:ring-0">
                                        <span>💬 Tombol Chat / Order WhatsApp</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/5 cursor-pointer hover:bg-white/10">
                                        <input type="checkbox" value="Galeri Foto & Showcase Produk" checked class="wizard-feat-check rounded bg-black/40 border-white/20 text-cyan-500 focus:ring-0">
                                        <span>🖼️ Galeri Foto & Showcase</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/5 cursor-pointer hover:bg-white/10">
                                        <input type="checkbox" value="Formulir Booking & Kontak" checked class="wizard-feat-check rounded bg-black/40 border-white/20 text-cyan-500 focus:ring-0">
                                        <span>📝 Formulir Pesan / Booking</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/5 cursor-pointer hover:bg-white/10">
                                        <input type="checkbox" value="Peta Google Maps & Jam Buka" checked class="wizard-feat-check rounded bg-black/40 border-white/20 text-cyan-500 focus:ring-0">
                                        <span>📍 Peta Lokasi & Jam Buka</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/5 cursor-pointer hover:bg-white/10">
                                        <input type="checkbox" value="Katalog Produk & Daftar Harga" checked class="wizard-feat-check rounded bg-black/40 border-white/20 text-cyan-500 focus:ring-0">
                                        <span>📋 Katalog & Daftar Harga</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/5 cursor-pointer hover:bg-white/10">
                                        <input type="checkbox" value="Ulasan & Testimoni Pelanggan" checked class="wizard-feat-check rounded bg-black/40 border-white/20 text-cyan-500 focus:ring-0">
                                        <span>⭐ Ulasan & Testimoni</span>
                                    </label>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="block text-xs font-semibold text-gray-300 mb-1">Catatan Khusus (Opsional)</label>
                                <textarea id="prd-wizard-notes" rows="2" placeholder="Contoh: Tambahkan info diskon 20% untuk pelanggan baru..." class="w-full bg-black/40 border border-white/10 rounded-lg px-3.5 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-cyan-400 transition-colors resize-none"></textarea>
                            </div>

                            <div class="flex items-center gap-3">
                                <button type="button" class="prd-submit-btn px-5 py-2.5 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-neutral-950 font-bold text-xs transition-all shadow-[0_0_15px_rgba(6,182,212,0.3)] flex items-center gap-2" onclick="handleInlineGenerate('wizard')">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Generate Planning Instan</span>
                                </button>
                                <button type="button" class="prd-view-btn px-4 py-2.5 rounded-lg bg-white/10 hover:bg-white/15 border border-white/15 text-white transition-colors text-xs font-semibold flex items-center gap-2 hidden" onclick="openSavedPrd()">
                                    <i class="fa-solid fa-file-lines"></i> <span>Buka Planning</span>
                                </button>
                                <p class="prd-inline-error text-red-400 text-xs hidden"></p>
                            </div>

                            <!-- Shimmer status card -->
                            <div class="prd-gen-status-card hidden mt-4" style="opacity:0; transition: opacity 0.3s ease;">
                                <div class="prd-gen-status">
                                    <div class="prd-gen-header">
                                        <span class="prd-shimmer-text text-xs">Menyusun Cetak Biru Planning...</span>
                                        <span class="text-[11px] text-gray-500 inline-flex items-center gap-0.5">
                                            <span class="prd-dot">.</span><span class="prd-dot">.</span><span class="prd-dot">.</span>
                                        </span>
                                    </div>
                                    <div class="prd-gen-body">
                                        <p class="text-xs text-gray-400 mb-3">AI sedang merancang sitemap, fitur, dan spesifikasi visual website Anda...</p>
                                        <div class="prd-gen-bar-track"><div class="prd-gen-bar-fill"></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Task PRD 2: Manual (Tulis Ide Bebas) -->
                <div class="prd-task-wrapper">
                    <label class="task-container flex items-start gap-4 p-5 rounded-xl glass-panel cursor-pointer" onclick="togglePrdInput('manual')">
                        <input type="checkbox" data-group="prd-method" id="task-prd-2" class="task-checkbox hidden">
                        <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors mt-0.5">
                            <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="task-title font-medium text-gray-200 transition-all duration-300">Tulis Ide Bebas</h4>
                            <p class="text-sm text-gray-400 mt-1 task-desc">Sudah punya gambaran detail? Tuliskan ide, visi, atau fitur impianmu secara bebas. AI akan merapikannya menjadi rencana terstruktur.</p>
                            <button type="button" class="prd-gen-toggle mt-4 px-4 py-2 text-xs font-semibold rounded-lg bg-white/5 border border-white/15 text-gray-300 hover:text-white hover:border-white/40 hover:bg-white/10 transition-all shadow-[0_0_15px_rgba(255,255,255,0.05)] flex items-center gap-2" onclick="event.preventDefault(); event.stopPropagation(); togglePrdInput('manual')">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Tulis Ide dengan AI
                            </button>
                        </div>
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-prd-2" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-prd-2');" aria-label="Lihat detail proses task-prd-2"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                    <!-- Inline expandable input for Manual -->
                    <div id="prd-input-manual" class="prd-inline-input hidden overflow-hidden transition-all duration-400 ease-out" style="max-height:0; opacity:0;">
                        <div class="mt-2 p-5 rounded-xl glass-panel border border-white/15">
                            <div class="flex items-center gap-2 mb-4">
                                <i class="fa-solid fa-wand-magic-sparkles text-gray-300 text-sm"></i>
                                <span class="text-sm font-semibold text-gray-200">AI Planning Generator — Tulis Ide Bebas</span>
                            </div>
                            <div class="mb-4">
                                <label class="block text-xs font-medium text-gray-400 mb-1">Ceritakan Ide Website Anda</label>
                                <textarea id="prd-desc-manual" rows="3" required placeholder="Contoh: Saya ingin membuat website untuk salon kecantikan 'Glow Up' di Jakarta. Ada menu perawatan, galeri foto ruangan, testimoni, dan tombol booking jadwal via WhatsApp..." class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-white/40 transition-colors resize-none"></textarea>
                            </div>
                            <div class="flex items-center gap-3">
                                <button type="button" class="prd-submit-btn px-4 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 border border-white/15 text-white transition-colors text-xs font-semibold flex items-center gap-2" onclick="handleInlineGenerate('manual')">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Generate Planning</span>
                                </button>
                                <button type="button" class="prd-view-btn px-4 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 border border-white/15 text-white transition-colors text-xs font-semibold flex items-center gap-2 hidden" onclick="openSavedPrd()">
                                    <i class="fa-solid fa-file-lines"></i> <span>Buka Planning</span>
                                </button>
                                <p class="prd-inline-error text-red-400 text-xs hidden"></p>
                            </div>
                            <!-- Shimmer status card -->
                            <div class="prd-gen-status-card hidden mt-4" style="opacity:0; transition: opacity 0.3s ease;">
                                <div class="prd-gen-status">
                                    <div class="prd-gen-header">
                                        <span class="prd-shimmer-text text-xs">Generating Planning Blueprint...</span>
                                        <span class="text-[11px] text-gray-500 inline-flex items-center gap-0.5">
                                            <span class="prd-dot">.</span><span class="prd-dot">.</span><span class="prd-dot">.</span>
                                        </span>
                                    </div>
                                    <div class="prd-gen-body">
                                        <p class="text-xs text-gray-400 mb-3">AI sedang menganalisis dan menyusun dokumen planning...</p>
                                        <div class="prd-gen-bar-track"><div class="prd-gen-bar-fill"></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Task PRD 3: Cloning -->
                <div class="prd-task-wrapper">
                    <label class="task-container flex items-start gap-4 p-5 rounded-xl glass-panel cursor-pointer" onclick="togglePrdInput('cloning')">
                        <input type="checkbox" data-group="prd-method" id="task-prd-3" class="task-checkbox hidden">
                        <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors mt-0.5">
                            <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="task-title font-medium text-gray-200 transition-all duration-300">Tiru / Referensi Website Lain</h4>
                            <p class="text-sm text-gray-400 mt-1 task-desc">Punya contoh website kompetitor atau favorit? Masukkan link URL-nya, lalu minta AI membuatkan versi yang lebih baik dengan penyesuaian khusus.</p>
                            <button type="button" class="prd-gen-toggle mt-4 px-4 py-2 text-xs font-semibold rounded-lg bg-white/5 border border-white/15 text-gray-300 hover:text-white hover:border-white/40 hover:bg-white/10 transition-all shadow-[0_0_15px_rgba(255,255,255,0.05)] flex items-center gap-2" onclick="event.preventDefault(); event.stopPropagation(); togglePrdInput('cloning')">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Analisis Link Website
                            </button>
                        </div>
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-prd-3" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-prd-3');" aria-label="Lihat detail proses task-prd-3"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                    <!-- Inline expandable input for Cloning -->
                    <div id="prd-input-cloning" class="prd-inline-input hidden overflow-hidden transition-all duration-400 ease-out" style="max-height:0; opacity:0;">
                        <div class="mt-2 p-5 rounded-xl glass-panel border border-white/15">
                            <div class="flex items-center gap-2 mb-4">
                                <i class="fa-solid fa-wand-magic-sparkles text-gray-300 text-sm"></i>
