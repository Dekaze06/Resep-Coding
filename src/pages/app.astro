---
import Layout from '../layouts/Layout.astro';
import PrdSheetViewer from '@/components/PrdSheetViewer';
---

<Layout>
    <!-- ============================= -->
    <!-- SCREEN 2: STEP-BY-STEP APP    -->
    <!-- ============================= -->
    <div id="screen-app" class="relative min-h-screen">
        <!-- ✦ Cinematic: Grid Background for app screen -->
        <div class="app-bg-grid"></div>

    <!-- Hero Section -->
    <section class="relative pt-16 pb-16 lg:pt-20 lg:pb-24 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-panel border border-white/10 text-xs font-medium text-gray-300 mb-3 mx-auto reveal">
                <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                <span id="active-project-name">Project</span>
            </div>
            <button id="btn-back-to-landing" type="button" class="block mx-auto mb-5 text-[11px] text-white/90 hover:text-white transition-colors">
                <i class="fa-solid fa-arrow-left mr-1"></i>Ganti Project
            </button>
            <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 reveal" style="animation-delay: 0.1s;">
                Langkah-Langkah <br class="hidden md:block" />
                <span class="gradient-text inline-flex flex-col items-center justify-center align-top leading-none">
                    <span class="font-sans uppercase">SASITE</span>
                    <span class="text-cyan-400 drop-shadow-[0_0_12px_rgba(34,211,238,0.4)]" style="font-family: 'Dancing Script', cursive; font-weight: 400; font-size: 0.65em; margin-top: -0.4em;">Studio</span>
                </span>
            </h1>
            <p class="mt-4 max-w-2xl text-lg text-gray-400 mx-auto mb-10 reveal" style="animation-delay: 0.2s;">
                Centang setiap prosesnya. Progres Anda akan otomatis tersimpan di browser. Mari kita bangun website luar biasa mulai dari PRD hingga Testing.
            </p>
        </div>
    </section>

    <!-- Main Content Container -->
    <div id="app-layout-wrapper" class="max-w-7xl mx-auto px-6 lg:px-8 relative pb-20 flex gap-6 transition-all duration-500">
    <div id="task-column" class="w-full max-w-4xl mx-auto transition-all duration-500">

        <!-- Progres Proyek (Above navigation) -->
        <div class="mb-6 md:mb-8">
            <div class="glass-panel p-4 rounded-2xl shadow-[0_10px_40px_-10px_rgba(0,0,0,0.8)] border-white/20">
                <div class="flex justify-between items-end mb-2">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-spinner animate-spin text-gray-300" id="progress-spinner"></i>
                            Progres Proyek
                        </h3>
                    </div>
                    <span id="progress-text" class="text-xs font-bold text-gray-200 bg-white/10 px-2 py-1 rounded-md">0 / 22 Selesai</span>
                </div>
                
                <!-- Progress Bar -->
                <div class="w-full h-2.5 bg-gray-800 rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-white transition-all duration-500 ease-out" style="width: 0%;"></div>
                </div>
                
                <!-- Congratulation Message (Hidden by default) -->
                <div id="congrats-msg" class="hidden mt-3 text-center text-xs text-white font-medium animate-fade-in-up">
                    <i class="fa-solid fa-party-horn mr-1"></i> Luar biasa! Semua proses telah selesai!
                </div>
            </div>
        </div>

        <!-- Stepper Nav (Centered single item with animation) -->
        <div id="stepper-nav" class="mb-8 md:mb-12 select-none relative">
            <div class="flex items-center justify-center gap-6 md:gap-12">
                <!-- Kembali -->
                <button id="btn-slide-prev" type="button" class="shrink-0 w-10 h-10 md:w-11 md:h-11 rounded-full glass-panel border border-white/10 text-gray-300 hover:border-white/30 hover:text-white transition-all duration-300 flex items-center justify-center disabled:opacity-30 disabled:pointer-events-none z-10" aria-label="Kembali ke langkah sebelumnya">
                    <i class="fa-solid fa-arrow-left text-sm"></i>
                </button>

                <!-- Dynamic Centered Nav -->
                <div id="dynamic-nav-container" class="w-40 md:w-56 flex justify-center items-center relative h-16 md:h-20 overflow-hidden">
                    <!-- Dynamic content injected via JS -->
                </div>

                <!-- Lanjut -->
                <button id="btn-slide-next" type="button" class="shrink-0 w-10 h-10 md:w-11 md:h-11 rounded-full glass-panel border border-white/10 text-gray-300 hover:border-white/30 hover:text-white transition-all duration-300 flex items-center justify-center z-10" aria-label="Lanjut ke langkah berikutnya">
                    <i class="fa-solid fa-arrow-right text-sm"></i>
                </button>
            </div>

            <div class="text-center mt-3">
                <span id="slide-position-label" class="text-xs text-gray-500 font-medium tracking-wide">1 / 6</span>
            </div>
        </div>

        <!-- Slides Viewport -->
        <div id="slides-viewport" class="relative">

        <!-- 1. PRD Section -->
        <section id="prd" class="slide-panel slide-active relative z-10 pb-4">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-file-lines text-white text-sm"></i>
                </div>
                <h2 class="text-2xl font-bold">1. Planning & PRD</h2>
            </div>
            <p class="text-gray-400 mb-6 text-sm">Product Requirements Document adalah fondasi. Gunakan AI untuk mempercepat perumusan.</p>
            
            <div class="flex flex-col gap-4">
                <!-- Task PRD 1: Manual -->
                <div class="prd-task-wrapper">
                    <label class="task-container flex items-start gap-4 p-5 rounded-xl glass-panel cursor-pointer">
                        <input type="checkbox" data-group="prd-method" id="task-prd-1" class="task-checkbox hidden">
                        <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors mt-0.5">
                            <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="task-title font-medium text-gray-200 transition-all duration-300">Pembuatan Manual</h4>
                            <p class="text-sm text-gray-400 mt-1 task-desc">Jelaskan visi, misi, target user, dan daftar fitur utama secara rinci. Biarkan Claude menstrukturkannya menjadi dokumen PRD standar.</p>
                            <button type="button" class="prd-gen-toggle mt-4 px-4 py-2 text-xs font-semibold rounded-lg bg-white/5 border border-white/15 text-gray-300 hover:text-white hover:border-white/40 hover:bg-white/10 transition-all shadow-[0_0_15px_rgba(255,255,255,0.05)] flex items-center gap-2" onclick="event.preventDefault(); event.stopPropagation(); togglePrdInput('manual')">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Generate PRD with AI
                            </button>
                        </div>
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-prd-1" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-prd-1');" aria-label="Lihat detail proses task-prd-1"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>
                    <!-- Inline expandable input for Manual -->
                    <div id="prd-input-manual" class="prd-inline-input hidden overflow-hidden transition-all duration-400 ease-out" style="max-height:0; opacity:0;">
                        <div class="mt-2 p-5 rounded-xl glass-panel border border-white/15">
                            <div class="flex items-center gap-2 mb-4">
                                <i class="fa-solid fa-wand-magic-sparkles text-gray-300 text-sm"></i>
                                <span class="text-sm font-semibold text-gray-200">AI PRD Generator — Manual</span>
                            </div>
                            <div class="mb-4">
                                <label class="block text-xs font-medium text-gray-400 mb-1">Deskripsi Aplikasi</label>
                                <textarea id="prd-desc-manual" rows="3" required placeholder="Jelaskan visi, misi, target pengguna, dan fitur utama..." class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-white/40 transition-colors resize-none"></textarea>
                            </div>
                            <div class="flex items-center gap-3">
                                <button type="button" class="prd-submit-btn px-4 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 border border-white/15 text-white transition-colors text-xs font-semibold flex items-center gap-2" onclick="handleInlineGenerate('manual')">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Generate</span>
                                </button>
                                <button type="button" class="prd-view-btn px-4 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 border border-white/15 text-white transition-colors text-xs font-semibold flex items-center gap-2 hidden" onclick="openSavedPrd()">
                                    <i class="fa-solid fa-file-lines"></i> <span>Buka PRD</span>
                                </button>
                                <p class="prd-inline-error text-red-400 text-xs hidden"></p>
                            </div>
                            <!-- Shimmer status card (hidden by default) -->
                            <div class="prd-gen-status-card hidden mt-4" style="opacity:0; transition: opacity 0.3s ease;">
                                <div class="prd-gen-status">
                                    <div class="prd-gen-header">
                                        <span class="prd-shimmer-text text-xs">Generating PRD...</span>
                                        <span class="text-[11px] text-gray-500 inline-flex items-center gap-0.5">
                                            <span class="prd-dot">.</span><span class="prd-dot">.</span><span class="prd-dot">.</span>
                                        </span>
                                    </div>
                                    <div class="prd-gen-body">
                                        <p class="text-xs text-gray-400 mb-3">AI sedang menganalisis dan menyusun dokumen PRD...</p>
                                        <div class="prd-gen-bar-track"><div class="prd-gen-bar-fill"></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Task PRD 2: Cloning -->
                <div class="prd-task-wrapper">
                    <label class="task-container flex items-start gap-4 p-5 rounded-xl glass-panel cursor-pointer">
                        <input type="checkbox" data-group="prd-method" id="task-prd-2" class="task-checkbox hidden">
                        <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors mt-0.5">
                            <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="task-title font-medium text-gray-200 transition-all duration-300">Cloning Ref Link Website Lain</h4>
                            <p class="text-sm text-gray-400 mt-1 task-desc">Berikan URL referensi kompetitor. Prompt: <i>"Analisis website [URL], dan buatkan PRD untuk membuat versi yang lebih baik dengan tambahan fitur khusus."</i></p>
                            <button type="button" class="prd-gen-toggle mt-4 px-4 py-2 text-xs font-semibold rounded-lg bg-white/5 border border-white/15 text-gray-300 hover:text-white hover:border-white/40 hover:bg-white/10 transition-all shadow-[0_0_15px_rgba(255,255,255,0.05)] flex items-center gap-2" onclick="event.preventDefault(); event.stopPropagation(); togglePrdInput('cloning')">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Generate PRD with AI
                            </button>
                        </div>
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-prd-2" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-prd-2');" aria-label="Lihat detail proses task-prd-2"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>
                    <!-- Inline expandable input for Cloning -->
                    <div id="prd-input-cloning" class="prd-inline-input hidden overflow-hidden transition-all duration-400 ease-out" style="max-height:0; opacity:0;">
                        <div class="mt-2 p-5 rounded-xl glass-panel border border-white/15">
                            <div class="flex items-center gap-2 mb-4">
                                <i class="fa-solid fa-wand-magic-sparkles text-gray-300 text-sm"></i>
                                <span class="text-sm font-semibold text-gray-200">AI PRD Generator — Cloning</span>
                            </div>
                            <div class="mb-3">
                                <label class="block text-xs font-medium text-gray-400 mb-1">URL Referensi</label>
                                <input type="url" id="prd-url-cloning" placeholder="https://..." class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-white/40 transition-colors">
                            </div>
                            <div class="mb-4">
                                <label class="block text-xs font-medium text-gray-400 mb-1">Deskripsi / Fitur Tambahan</label>
                                <textarea id="prd-desc-cloning" rows="3" required placeholder="Contoh: clone website ini, tambahkan fitur live chat dan dark mode..." class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-white/40 transition-colors resize-none"></textarea>
                            </div>
                            <div class="flex items-center gap-3">
                                <button type="button" class="prd-submit-btn px-4 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 border border-white/15 text-white transition-colors text-xs font-semibold flex items-center gap-2" onclick="handleInlineGenerate('cloning')">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Generate</span>
                                </button>
                                <button type="button" class="prd-view-btn px-4 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 border border-white/15 text-white transition-colors text-xs font-semibold flex items-center gap-2 hidden" onclick="openSavedPrd()">
                                    <i class="fa-solid fa-file-lines"></i> <span>Buka PRD</span>
                                </button>
                                <p class="prd-inline-error text-red-400 text-xs hidden"></p>
                            </div>
                            <!-- Shimmer status card (hidden by default) -->
                            <div class="prd-gen-status-card hidden mt-4" style="opacity:0; transition: opacity 0.3s ease;">
                                <div class="prd-gen-status">
                                    <div class="prd-gen-header">
                                        <span class="prd-shimmer-text text-xs">Generating PRD...</span>
                                        <span class="text-[11px] text-gray-500 inline-flex items-center gap-0.5">
                                            <span class="prd-dot">.</span><span class="prd-dot">.</span><span class="prd-dot">.</span>
                                        </span>
                                    </div>
                                    <div class="prd-gen-body">
                                        <p class="text-xs text-gray-400 mb-3">AI sedang menganalisis dan menyusun dokumen PRD...</p>
                                        <div class="prd-gen-bar-track"><div class="prd-gen-bar-fill"></div></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. Front End Section -->
        <section id="frontend" class="slide-panel slide-next relative z-10 pb-4">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center shrink-0">
                    <i class="fa-brands fa-react text-white text-sm"></i>
                </div>
                <h2 class="text-2xl font-bold">2. Front-End (Claude/Gemini)</h2>
            </div>
            <p class="text-gray-400 mb-6 text-sm">Menerjemahkan PRD menjadi antarmuka visual. Gunakan AI untuk generate boilerplate code & komponen.</p>
            
            <div class="flex flex-col gap-3">
                <!-- Task FE 1 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-1" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">1. UI/UX</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Tentukan Wireframing & Design System (Warna primer, sekunder, dan Spasi).</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-1" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-1');" aria-label="Lihat detail proses task-fe-1"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 2 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-2" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">2. Header</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Buat Navigasi Utama yang responsif (Hamburger menu di mobile).</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-2" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-2');" aria-label="Lihat detail proses task-fe-2"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 3 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-3" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">3. Title / Hero</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Rancang Hero section dengan Headline yang memikat dan CTA jelas.</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-3" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-3');" aria-label="Lihat detail proses task-fe-3"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 4 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-4" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">4. Layout</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Implementasi Grid System, Container, dan Card components.</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-4" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-4');" aria-label="Lihat detail proses task-fe-4"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 5 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-5" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">5. Fitur Utama</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Bangun komponen interaktif inti sesuai PRD (Tabel, Form, Grafik).</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-5" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-5');" aria-label="Lihat detail proses task-fe-5"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 6 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-6" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">6. Typography</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Atur hierarki font (H1-H6) dan pastikan readability tinggi.</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-6" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-6');" aria-label="Lihat detail proses task-fe-6"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 7 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-7" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">7. Animasi</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Tambahkan micro-interactions (Hover efek, framer-motion/CSS transition).</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-7" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-7');" aria-label="Lihat detail proses task-fe-7"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 8 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-8" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">8. Footer</h4>
