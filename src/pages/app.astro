                `
            }
        };

        // --- AI Generator Logic (Inline Expandable + PRD Viewer Panel) ---
                // --- Wizard Category Selector Helper ---
        window.selectWizardCat = function(btn) {
            const container = document.getElementById('wizard-category-group');
            if (!container) return;
            container.querySelectorAll('.wizard-cat-btn').forEach(b => {
                b.className = 'wizard-cat-btn px-3 py-2 rounded-lg border border-white/10 bg-white/5 text-gray-300 text-xs font-semibold text-left hover:border-white/20 transition-all';
            });
            btn.className = 'wizard-cat-btn px-3 py-2 rounded-lg border border-cyan-400/50 bg-cyan-500/15 text-cyan-300 text-xs font-semibold text-left transition-all';
            const input = document.getElementById('prd-wizard-category');
            if (input) input.value = btn.getAttribute('data-value');
        };

        // --- AI Generator Logic (Inline Expandable + Planning Viewer Panel) ---
        window.togglePrdInput = function(type) {
            const allTypes = ['wizard', 'manual', 'cloning'];
            const currentPanel = document.getElementById('prd-input-' + type);
            if (!currentPanel) return;

            const isCurrentlyHidden = currentPanel.classList.contains('hidden');

            // Close other panels
            allTypes.filter(t => t !== type).forEach(t => {
                const other = document.getElementById('prd-input-' + t);
                if (other && !other.classList.contains('hidden')) {
                    other.style.maxHeight = '0';
                    other.style.opacity = '0';
                    setTimeout(() => other.classList.add('hidden'), 400);
                }
            });

            // Toggle current panel
            if (isCurrentlyHidden) {
                currentPanel.classList.remove('hidden');
                void currentPanel.offsetWidth; // reflow
                currentPanel.style.maxHeight = (currentPanel.scrollHeight + 120) + 'px';
                currentPanel.style.opacity = '1';
                
                // Focus & smooth scroll
                setTimeout(() => {
                    currentPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    const firstInput = currentPanel.querySelector('input[type="text"], textarea');
                    if (firstInput) firstInput.focus();
                }, 150);
            } else {
                currentPanel.style.maxHeight = '0';
                currentPanel.style.opacity = '0';
                setTimeout(() => currentPanel.classList.add('hidden'), 400);
            }
        };

        window.handleInlineGenerate = async function(type) {
            const wrapper = document.getElementById('prd-input-' + type);
            if (!wrapper) return;
            const btn = wrapper.querySelector('.prd-submit-btn');
            const errorEl = wrapper.querySelector('.prd-inline-error');

            let payload = { type };

            if (type === 'wizard') {
                const category = document.getElementById('prd-wizard-category')?.value || 'Toko Online & UMKM';
                const businessName = document.getElementById('prd-wizard-name')?.value || '';
                const colorStyle = document.getElementById('prd-wizard-style')?.value || 'Modern Cyan & Dark Luxury';
                const notes = document.getElementById('prd-wizard-notes')?.value || '';

                const checkedBoxes = wrapper.querySelectorAll('.wizard-feat-check:checked');
                const features = Array.from(checkedBoxes).map(cb => cb.value);

                if (!businessName.trim()) {
                    errorEl.innerText = 'Mohon isi Nama Bisnis / Website terlebih dahulu.';
                    errorEl.classList.remove('hidden');
                    return;
                }

                payload = {
                    type: 'wizard',
                    category,
                    businessName,
                    colorStyle,
                    features,
                    notes
                };
            } else if (type === 'manual') {
                const desc = document.getElementById('prd-desc-manual')?.value || '';
                if (!desc.trim()) {
                    errorEl.innerText = 'Deskripsi ide tidak boleh kosong.';
                    errorEl.classList.remove('hidden');
                    return;
                }
                payload = { type: 'manual', desc };
            } else if (type === 'cloning') {
                const url = document.getElementById('prd-url-cloning')?.value || '';
                const desc = document.getElementById('prd-desc-cloning')?.value || '';
                if (!desc.trim()) {
                    errorEl.innerText = 'Deskripsi / instruksi tidak boleh kosong.';
                    errorEl.classList.remove('hidden');
                    return;
                }
                payload = { type: 'cloning', url, desc };
            }

            btn.parentElement.classList.add('hidden');
            errorEl.classList.add('hidden');

            const statusCard = wrapper.querySelector('.prd-gen-status-card');
            if (statusCard) {
                statusCard.classList.remove('hidden');
                void statusCard.offsetWidth;
                statusCard.style.opacity = '1';
            }

            try {
                const response = await fetch('/api/generate-prd', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                if (!response.ok) throw new Error(data.error || 'Terjadi kesalahan pada server');

                // Save to project store
                if (window.updateActiveProjectPrd) {
                    window.updateActiveProjectPrd(data.markdown);
                }
                // Show the "Buka Planning" buttons
                document.querySelectorAll('.prd-view-btn').forEach(b => b.classList.remove('hidden'));

                // Show in Planning viewer panel
                showPrdViewer(data.markdown);

                // Auto-check task
                const taskId = type === 'wizard' ? 'task-prd-1' : type === 'manual' ? 'task-prd-2' : 'task-prd-3';
                const cb = document.getElementById(taskId);
                if (cb && !cb.checked) cb.click();

            } catch (err) {
                errorEl.innerText = err.message;
                errorEl.classList.remove('hidden');
            } finally {
                if (statusCard) {
                    statusCard.style.opacity = '0';
                    setTimeout(() => {
                        statusCard.classList.add('hidden');
                        btn.parentElement.classList.remove('hidden');
                    }, 300);
                } else {
                    btn.parentElement.classList.remove('hidden');
                }
            }
        };

        window.openSavedPrd = function() {
            const saved = window.getActiveProjectPrd ? window.getActiveProjectPrd() : null;
            if (saved) {
                showPrdViewer(saved);
            }
        };

        // --- PRD Viewer/Editor Panel ---
        window.showPrdViewer = function(markdown) {
            window.dispatchEvent(new CustomEvent('open-prd-sheet', { detail: { markdown } }));
        };

        window.closePrdViewer = function() {
            window.dispatchEvent(new Event('close-prd-sheet'));
        };

        // Note: savePrdManual, downloadPrdFromViewer, and completePrdAndNext are now 
        // handled internally by the React component (PrdSheetViewer), so we don't need 
        // to define them here for the UI, but they might still be called by legacy buttons 
        // if any exist outside the React component. Since they don't, we can leave them out 
        // or just let them be as stubs.
        
        // Remove old vanilla implementations that depended on #prd-editor-textarea

        window.downloadPrdFromViewer = function() {
            const textarea = document.getElementById('prd-editor-textarea');
            const blob = new Blob([textarea.value], { type: 'text/markdown' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'prd.md';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };

        window.completePrdAndNext = function() {
            closePrdViewer();
            setTimeout(() => {
                const nextBtn = document.getElementById('btn-slide-next');
                if(nextBtn && !nextBtn.disabled) {
                    nextBtn.click();
                }
            }, 300); // Wait for the panel transition to almost finish before sliding
        };

        function openTaskModal(id) {
            const data = taskDetails[id];
            if (!data) return;
            document.getElementById('task-modal-category').innerText = data.category;
            document.getElementById('task-modal-title').innerText = data.title;
            document.getElementById('task-modal-body').innerHTML = data.detail;
            document.getElementById('task-modal-icon').innerHTML = `<i class="${data.icon} text-white"></i>`;
            const overlay = document.getElementById('task-modal-overlay');
            overlay.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeTaskModal() {
            document.getElementById('task-modal-overlay').classList.add('hidden');
            document.body.style.overflow = '';
        }

        document.getElementById('task-modal-overlay').addEventListener('click', (e) => {
            if (e.target.id === 'task-modal-overlay') closeTaskModal();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeTaskModal();
        });

        // Initialize PRD Viewer/Editor state
        document.addEventListener('DOMContentLoaded', () => {
            const prdTextarea = document.getElementById('prd-editor-textarea');
            if (prdTextarea) {
                prdTextarea.addEventListener('input', (e) => {
                    // Update saved PRD if it exists
                    if (window.getActiveProjectPrd && window.getActiveProjectPrd() !== null) {
                        window.updateActiveProjectPrd(e.target.value);
                    }
                });
            }
        });
    </script>

    <!-- ============================= -->
    <!-- SLIDE-PER-PAGE NAVIGATION     -->
    <!-- ============================= -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const slidePanels = Array.from(document.querySelectorAll('.slide-panel'));
            const btnSlidePrev = document.getElementById('btn-slide-prev');
            const btnSlideNext = document.getElementById('btn-slide-next');
            const btnSlideNextIcon = btnSlideNext ? btnSlideNext.querySelector('i') : null;
            const slidePosLabel = document.getElementById('slide-position-label');
            const progressLine = document.getElementById('stepper-progress-line');
            const slidesViewport = document.getElementById('slides-viewport');
            const screenApp = document.getElementById('screen-app');
            const totalSlides = slidePanels.length;
            const revealedSlides = new Set();

            let currentSlide = 0;

            const stepsData = [
                { label: 'Planning', icon: 'fa-lightbulb', type: 'fa-solid', color: '#38bdf8' },
                { label: 'Desain Web', icon: 'fa-paintbrush', type: 'fa-solid', color: '#38bdf8' },
                { label: 'Backend', icon: 'fa-database', type: 'fa-solid', color: '#a3a3a3' },
                { label: 'Integrasi', icon: 'fa-plug', type: 'fa-solid', color: '#888888' },
                { label: 'Deploy', icon: 'fa-rocket', type: 'fa-solid', color: '#a3a3a3' },
                { label: 'Testing', icon: 'fa-vial', type: 'fa-solid', color: '#e5e5e5' }
            ];

            const navContainer = document.getElementById('dynamic-nav-container');
            let currentNavEl = null;

            function updateNavUI(index, prevIndex) {
                if (totalSlides === 0 || !navContainer) return;
                
                const step = stepsData[index];
                if (!step) return;

                // For initial load, prevIndex will be -1
                const isForward = index >= prevIndex;
                const enterClass = isForward ? 'translate-x-12 opacity-0' : '-translate-x-12 opacity-0';
                const exitClass = isForward ? '-translate-x-12 opacity-0 scale-95' : 'translate-x-12 opacity-0 scale-95';

                const newEl = document.createElement('div');
                newEl.className = `absolute inset-0 flex flex-col items-center justify-center gap-2 transition-all duration-500 ease-out transform ${enterClass}`;
                newEl.innerHTML = `
                    <span class="stepper-dot w-10 h-10 md:w-12 md:h-12 rounded-full border border-white/20 flex items-center justify-center bg-black/20 backdrop-blur-md shadow-[0_0_15px_rgba(255,255,255,0.1)]" style="box-shadow: 0 0 15px ${step.color}40; border-color: ${step.color}80">
                        <i class="${step.type} ${step.icon} text-sm" style="color: ${step.color}"></i>
                    </span>
                    <span class="stepper-label text-xs md:text-sm font-semibold tracking-wide text-white drop-shadow-md">${step.label}</span>
                `;
                
                navContainer.appendChild(newEl);

                // Force reflow
                void newEl.offsetWidth;

                // Animate in
                newEl.classList.remove('translate-x-12', '-translate-x-12', 'opacity-0');
                newEl.classList.add('translate-x-0', 'opacity-100');

                // Animate out old element
                if (currentNavEl) {
                    const oldEl = currentNavEl;
                    oldEl.classList.remove('translate-x-0', 'opacity-100');
                    oldEl.classList.add(...exitClass.split(' '));
                    setTimeout(() => {
                        if (oldEl && oldEl.parentNode) oldEl.parentNode.removeChild(oldEl);
                    }, 500);
                }
                
                currentNavEl = newEl;
            }

            let __slideIsInit = true;

            function goToSlide(index) {
                if (totalSlides === 0) return;
                index = Math.max(0, Math.min(totalSlides - 1, index));
                
                const prevIndex = currentSlide;
                currentSlide = index;
                
                if (!__slideIsInit && window.updateActiveProjectSlide) {
                    window.updateActiveProjectSlide(index);
                }
                __slideIsInit = false;
                
                // Update navigation visual
                if (prevIndex !== index || !currentNavEl) {
                    updateNavUI(index, prevIndex !== index ? prevIndex : -1);
                }

                slidePanels.forEach((panel, i) => {
                    panel.classList.remove('slide-active', 'slide-prev', 'slide-next');
                    if (i === index) {
                        panel.classList.add('slide-active');
                    } else if (i < index) {
                        panel.classList.add('slide-prev');
                    } else {
                        panel.classList.add('slide-next');
                    }
                    if (i !== index) {
                        panel.classList.remove('reveal');
                    }
                });

                if (progressLine) {
                    const pct = totalSlides <= 1 ? 0 : (index / (totalSlides - 1)) * 100;
                    progressLine.style.width = pct + '%';
                }

                if (slidePosLabel) slidePosLabel.textContent = `${index + 1} / ${totalSlides}`;
                if (btnSlidePrev) btnSlidePrev.disabled = index === 0;
                if (btnSlideNextIcon) {
                    const isLast = index === totalSlides - 1;
                if (btnSlideNext) btnSlideNext.setAttribute('aria-label', index === totalSlides - 1 ? 'Selesai — kembali ke atas' : 'Lanjut ke langkah berikutnya');
                    btnSlideNextIcon.classList.toggle('fa-check', isLast);
                }
                if (btnSlideNext) btnSlideNext.setAttribute('aria-label', index === totalSlides - 1 ? 'Selesai — kembali ke atas' : 'Lanjut ke langkah berikutnya');

                const activePanel = slidePanels[index];
                activePanel.classList.remove('reveal');
                void activePanel.offsetWidth;
                activePanel.classList.add('reveal');
            }

            // Kembali / Lanjut buttons
            if (btnSlidePrev) {
                btnSlidePrev.addEventListener('click', () => goToSlide(currentSlide - 1));
            }
            if (btnSlideNext) {
                btnSlideNext.addEventListener('click', () => {
                    if (currentSlide < totalSlides - 1) {
                        goToSlide(currentSlide + 1);
                    } else {
                        // Last slide: scroll down to the floating progress tracker as a natural "finish" cue
                        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
                    }
                });
            }

            // Keyboard arrow navigation (only while the app screen is visible, no modal open, not typing)
            document.addEventListener('keydown', (e) => {
                if (!screenApp || screenApp.classList.contains('hidden')) return;
                const modalOverlay = document.getElementById('task-modal-overlay');
                if (modalOverlay && !modalOverlay.classList.contains('hidden')) return;
                const activeTag = (document.activeElement && document.activeElement.tagName) || '';
                if (activeTag === 'INPUT' || activeTag === 'TEXTAREA') return;

                if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    goToSlide(currentSlide + 1);
                } else if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    goToSlide(currentSlide - 1);
                }
            });

            // Swipe support for mobile
            if (slidesViewport) {
                let touchStartX = 0;
                let touchStartY = 0;
                const SWIPE_THRESHOLD = 45;

                slidesViewport.addEventListener('touchstart', (e) => {
                    touchStartX = e.changedTouches[0].screenX;
                    touchStartY = e.changedTouches[0].screenY;
                }, { passive: true });

                slidesViewport.addEventListener('touchend', (e) => {
                    const touchEndX = e.changedTouches[0].screenX;
                    const touchEndY = e.changedTouches[0].screenY;
                    const dx = touchEndX - touchStartX;
                    const dy = touchEndY - touchStartY;
                    if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy) * 1.2) {
                        if (dx < 0) {
                            goToSlide(currentSlide + 1);
                        } else {
                            goToSlide(currentSlide - 1);
                        }
                    }
                }, { passive: true });
            }

            goToSlide(0);

            // Expose slide navigation so the checklist logic can auto-advance
            // to the next section once every task in the current one is checked.
            window.__slideNav = {
                goToSlide: goToSlide,
                getCurrentSlide: () => currentSlide,
                getIndexForSection: (section) => slidePanels.indexOf(section),
                total: totalSlides
            };
        });
    </script>


    <!-- ============================= -->
    <!-- PROJECT STORE (App page)      -->
    <!-- ============================= -->
    <script is:inline>
        const PROJECTS_KEY = 'webDevProjectsStore';

        function loadProjectsStore() {
            try {
                const raw = localStorage.getItem(PROJECTS_KEY);
                return raw ? JSON.parse(raw) : { projects: {}, activeId: null };
            } catch (e) {
                return { projects: {}, activeId: null };
            }
        }

        function saveProjectsStore(store) {
            localStorage.setItem(PROJECTS_KEY, JSON.stringify(store));
        }

        window.updateActiveProjectSlide = function (slideIndex) {
            const store = loadProjectsStore();
            if (!store.activeId || !store.projects[store.activeId]) return;
            store.projects[store.activeId].currentSlide = slideIndex;
            saveProjectsStore(store);
        };

        window.updateActiveProjectTasks = function (tasks) {
            const store = loadProjectsStore();
            if (!store.activeId || !store.projects[store.activeId]) return;
            store.projects[store.activeId].tasks = tasks;
            saveProjectsStore(store);
        };

        window.updateActiveProjectPrd = function (prdContent) {
            const store = loadProjectsStore();
            if (!store.activeId || !store.projects[store.activeId]) return;
            store.projects[store.activeId].prd = prdContent;
            saveProjectsStore(store);
        };

        window.getActiveProjectPrd = function () {
            const store = loadProjectsStore();
            if (!store.activeId || !store.projects[store.activeId]) return null;
            return store.projects[store.activeId].prd || null;
        };

        window.openFrontendCanvas = function (prompt) {
            window.dispatchEvent(new CustomEvent('open-frontend-canvas', { detail: { prompt } }));
        };

        window.closeFrontendCanvas = function () {
            window.dispatchEvent(new Event('close-frontend-canvas'));
        };

        window.getActiveProjectName = function () {
            const store = loadProjectsStore();
            if (!store.activeId || !store.projects[store.activeId]) return 'Web App';
            return store.projects[store.activeId].name || 'Web App';
        };

        window.getActiveProjectCanvasState = function () {
            const store = loadProjectsStore();
            if (!store.activeId || !store.projects[store.activeId]) return null;
            const proj = store.projects[store.activeId];
            let rawCode = proj.canvasCode || '';
            
            if (rawCode) {
                const docTypeIdx = rawCode.indexOf('<!DOCTYPE html>');
                const htmlIdx = rawCode.indexOf('<html');
                const startIdx = docTypeIdx !== -1 ? docTypeIdx : htmlIdx;
                if (startIdx > 0) {
                    rawCode = rawCode.slice(startIdx);
                }
                rawCode = rawCode.replace(/```(?:html|HTML)?/gi, '').replace(/```\s*$/g, '').trim();
            }

            return {
                code: rawCode,
                messages: proj.canvasMessages || [],
                title: proj.canvasTitle || (proj.name ? proj.name + ' - Web Canvas' : 'Web Canvas')
            };
        };

        window.updateActiveProjectCanvasState = function (state) {
            const store = loadProjectsStore();
            if (!store.activeId || !store.projects[store.activeId]) return;
            store.projects[store.activeId].canvasCode = state.code;
            store.projects[store.activeId].canvasMessages = state.messages;
            store.projects[store.activeId].canvasTitle = state.title;
            saveProjectsStore(store);
        };

        // Restore project on page load + guard redirect
        document.addEventListener('DOMContentLoaded', () => {
            const store = loadProjectsStore();
            if (!store.activeId || !store.projects[store.activeId]) {
                // No active project — redirect back to landing
                window.location.href = '/';
                return;
            }

            const project = store.projects[store.activeId];
            const projectNameLabel = document.getElementById('active-project-name');
            if (projectNameLabel) projectNameLabel.textContent = project.name;

            // "Ganti Project" button -> redirect to landing
            const btnBack = document.getElementById('btn-back-to-landing');
            if (btnBack) {
                btnBack.addEventListener('click', () => {
                    store.activeId = null;
                    saveProjectsStore(store);
                    window.location.href = '/';
                });
            }

            // Defer task + slide restore to checklist script via pending flags
            window.__pendingRestoreTasks = project.tasks || {};
            window.__pendingRestorePrd = project.prd || '';
            if (project.currentSlide !== undefined) {
                window.__pendingRestoreSlide = project.currentSlide;
            }
        });
    </script>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // Setup dynamic staggered delays for typing animation
            document.querySelectorAll('section').forEach(section => {
                const descs = section.querySelectorAll('.task-desc');
                descs.forEach((desc, index) => {
                    desc.style.animationDelay = `${(index * 0.15) + 0.3}s`;
                });
            });

            // Intersection Observer for scroll animations
            const observer = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('reveal');
                        entry.target.classList.remove('opacity-0');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.observer-target').forEach((elem) => {
                observer.observe(elem);
            });

            // --- CHECKLIST & PROGRESS LOGIC ---
            const checkboxes = document.querySelectorAll('.task-checkbox');
            const progressBar = document.getElementById('progress-bar');
            const progressText = document.getElementById('progress-text');
            const progressSpinner = document.getElementById('progress-spinner');
            const congratsMsg = document.getElementById('congrats-msg');

            // --- PROJECT COMPLETE SCREEN TRANSITION ---
            const screenAppEl = document.getElementById('screen-app');
            const screenCongratsEl = document.getElementById('screen-congrats');
            const congratsTotalEl = document.getElementById('congrats-total');
            const congratsProjectNameEl = document.getElementById('congrats-project-name');
            const activeProjectNameEl = document.getElementById('active-project-name');
            let congratsShown = false;

            function showCongratsScreen() {
                if (congratsShown || !screenAppEl || !screenCongratsEl) return;
                congratsShown = true;

                if (congratsTotalEl) congratsTotalEl.textContent = checkboxes.length;
                if (congratsProjectNameEl && activeProjectNameEl) {
                    congratsProjectNameEl.textContent = activeProjectNameEl.textContent || 'project ini';
                }

                screenAppEl.classList.add('is-leaving-complete');
                setTimeout(() => {
                    screenAppEl.classList.add('hidden');
                    screenCongratsEl.classList.remove('hidden');
                    screenCongratsEl.classList.add('is-hidden-init');
                    void screenCongratsEl.offsetWidth; // force reflow
                    requestAnimationFrame(() => {
                        screenCongratsEl.classList.add('is-entered');
                    });
                }, 550);
            }

            function hideCongratsScreen() {
                if (!congratsShown || !screenAppEl || !screenCongratsEl) return;
                screenCongratsEl.classList.remove('is-entered');
                screenCongratsEl.classList.add('is-hidden-init');
                setTimeout(() => {
                    screenCongratsEl.classList.add('hidden');
                    screenAppEl.classList.remove('hidden');
                    void screenAppEl.offsetWidth; // force reflow
                    requestAnimationFrame(() => {
                        screenAppEl.classList.remove('is-leaving-complete');
                    });
                    congratsShown = false;
                }, 550);
            }

            const btnCongratsReview = document.getElementById('btn-congrats-review');
            if (btnCongratsReview) {
                btnCongratsReview.addEventListener('click', hideCongratsScreen);
            }

            const btnCongratsNewProject = document.getElementById('btn-congrats-newproject');
            if (btnCongratsNewProject) {
                btnCongratsNewProject.addEventListener('click', () => {
                    screenCongratsEl.classList.remove('is-entered');
                    screenCongratsEl.classList.add('is-hidden-init');
                    setTimeout(() => {
                        screenCongratsEl.classList.add('hidden');
                        screenAppEl.classList.remove('is-leaving-complete', 'hidden');
                        congratsShown = false;
                        const backBtn = document.getElementById('btn-back-to-landing');
                        if (backBtn) backBtn.click();
                    }, 550);
                });
            }

            checkboxes.forEach(cb => {
                cb.addEventListener('change', (e) => {
                    if (e.target.checked && e.target.dataset.group) {
                        checkboxes.forEach(otherCb => {
                            if (otherCb !== e.target && otherCb.dataset.group === e.target.dataset.group) {
                                otherCb.checked = false;
                            }
                        });
                    }

                    checkboxes.forEach(box => applyTaskStyle(box));
                    persistCurrentTasks();
                    updateProgress();
                    
                    if(e.target.checked) {
                        const container = e.target.closest('.task-container');
                        container.classList.add('animate-bounce-slight');
                        setTimeout(() => container.classList.remove('animate-bounce-slight'), 300);

                        // All tasks complete via this user action: hand off to the
                        // elegant full-screen "Project Complete" slide.
                        const stats = getTaskStats();
                        const allChecked = stats.checked === stats.total && stats.total > 0;
                        if (allChecked && !congratsShown) {
                            setTimeout(showCongratsScreen, 900);
                        }

                        // Auto-next: once every task in this section is checked,
                        // move on to the next section automatically.
                        const section = e.target.closest('section[id]');
                        if (section && window.__slideNav) {
                            const sectionBoxes = section.querySelectorAll('.task-checkbox');
                            const allDone = (() => {
                                let t = 0, c = 0;
                                const groups = new Set();
                                sectionBoxes.forEach(cb => {
                                    if (cb.dataset.group) {
                                        if (!groups.has(cb.dataset.group)) { groups.add(cb.dataset.group); t++; }
                                        if (cb.checked) c++;
                                    } else {
                                        t++;
                                        if (cb.checked) c++;
                                    }
                                });
                                return t > 0 && c === t;
                            })();
                            if (allDone && section.id !== 'prd') {
                                const idx = window.__slideNav.getIndexForSection(section);
                                const isCurrent = idx === window.__slideNav.getCurrentSlide();
                                const hasNext = idx > -1 && idx < window.__slideNav.total - 1;
                                if (isCurrent && hasNext) {
                                    setTimeout(() => window.__slideNav.goToSlide(idx + 1), 600);
                                }
                            }
                        }
                    }
                });
            });

            function persistCurrentTasks() {
                const state = {};
                checkboxes.forEach(cb => { state[cb.id] = cb.checked; });
                if (window.updateActiveProjectTasks) {
                    window.updateActiveProjectTasks(state);
                }
            }

            window.applyProjectTasks = function (tasksObj) {
                checkboxes.forEach(cb => {
                    cb.checked = !!tasksObj[cb.id];
                    applyTaskStyle(cb);
                });
                updateProgress();
            };

            window.applyProjectPrd = function (prdContent) {
                if (prdContent) {
                    document.querySelectorAll('.prd-view-btn').forEach(btn => btn.classList.remove('hidden'));
                } else {
                    document.querySelectorAll('.prd-view-btn').forEach(btn => btn.classList.add('hidden'));
                }
            };
            
            function applyTaskStyle(checkbox) {
                const container = checkbox.closest('.task-container');
                const title = container.querySelector('.task-title');
                
                // Base state (Normal / Checked)
                container.classList.remove('opacity-50', 'bg-white/5');
                title.classList.remove('line-through', 'text-gray-500');
                title.classList.add('text-gray-200');

                // Special logic for unselected grouped tasks (like PRD)
                if (checkbox.dataset.group) {
                    const groupName = checkbox.dataset.group;
                    const groupBoxes = Array.from(checkboxes).filter(cb => cb.dataset.group === groupName);
                    const anyChecked = groupBoxes.some(cb => cb.checked);
                    
                    const prdWrapper = container.closest('.prd-task-wrapper');
                    const prdBtn = prdWrapper?.querySelector('.prd-gen-toggle');
                    const prdPanel = prdWrapper?.querySelector('.prd-inline-input');
                    
                    if (anyChecked && !checkbox.checked) {
                        // This one was NOT selected, but another in the group WAS.
                        // So cross it out and disable its AI button.
                        container.classList.add('opacity-50', 'bg-white/5');
                        title.classList.add('line-through', 'text-gray-500');
                        title.classList.remove('text-gray-200');
                        if (prdBtn) {
                            prdBtn.disabled = true;
                            prdBtn.classList.add('opacity-30', 'cursor-not-allowed');
                            prdBtn.classList.remove('hover:text-white', 'hover:border-blue-400');
                        }
                        if (prdPanel && !prdPanel.classList.contains('hidden')) {
                            prdPanel.style.maxHeight = '0';
                            prdPanel.style.opacity = '0';
                            setTimeout(() => prdPanel.classList.add('hidden'), 400);
                        }
                    } else {
                        if (prdBtn) {
                            prdBtn.disabled = false;
                            prdBtn.classList.remove('opacity-30', 'cursor-not-allowed');
                            prdBtn.classList.add('hover:text-white', 'hover:border-blue-400');
                        }
                    }
                }
            }
            
            function getTaskStats() {
                let total = 0;
                let checked = 0;
                const radioGroups = new Set();
                checkboxes.forEach(cb => {
                    if (cb.dataset.group) {
                        if (!radioGroups.has(cb.dataset.group)) {
                            radioGroups.add(cb.dataset.group);
                            total++;
                        }
                        if (cb.checked) checked++;
                    } else {
                        total++;
                        if (cb.checked) checked++;
                    }
                });
                return { total, checked };
            }

            function updateProgress() {
                const { total, checked } = getTaskStats();
                const percentage = total === 0 ? 0 : Math.round((checked / total) * 100);
                
                progressBar.style.width = percentage + '%';
                progressText.innerText = `${checked} / ${total} Selesai`;
                
                if(checked === total && total > 0) {
                    progressSpinner.classList.remove('fa-spinner', 'animate-spin', 'text-primary');
                    progressSpinner.classList.add('fa-check-circle', 'text-white');
                    progressText.classList.remove('text-primary', 'bg-primary/10');
                    progressText.classList.add('text-white', 'bg-white/20');
                    congratsMsg.classList.remove('hidden');
                } else {
                    progressSpinner.classList.add('fa-spinner', 'animate-spin', 'text-primary');
                    progressSpinner.classList.remove('fa-check-circle', 'text-white');
                    progressText.classList.add('text-primary', 'bg-primary/10');
                    progressText.classList.remove('text-white', 'bg-white/20');
                    congratsMsg.classList.add('hidden');
                    if (congratsShown) {
                        hideCongratsScreen();
                    }
                }
            }
            
            updateProgress();

            // Restore saved project state AFTER applyProjectTasks + __slideNav are ready
            if (window.__pendingRestoreTasks !== undefined) {
                window.applyProjectTasks(window.__pendingRestoreTasks);
                delete window.__pendingRestoreTasks;
            }
            if (window.__pendingRestorePrd !== undefined) {
                window.applyProjectPrd(window.__pendingRestorePrd);
                delete window.__pendingRestorePrd;
            }
            if (window.__pendingRestoreSlide !== undefined && window.__slideNav) {
                window.__slideNav.goToSlide(window.__pendingRestoreSlide);
                delete window.__pendingRestoreSlide;
            }
        });
    </script>

</Layout>

