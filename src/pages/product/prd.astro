---
import Layout from '../../layouts/Layout.astro';
import HeaderNav from '../../components/HeaderNav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="PRD & Planning - Panduan & Fitur Satusite Studio" description="Pelajari cara menyusun dokumen PRD (Product Requirements Document) komprehensif, skema arsitektur data, dan roadmap teknis.">
    <!-- Subtle Ambient Background Glows -->
    <div class="fixed top-[-10%] left-[20%] w-[500px] h-[400px] bg-amber-600/5 rounded-full blur-[140px] pointer-events-none z-0"></div>
    <div class="fixed bottom-[-10%] right-[15%] w-[500px] h-[400px] bg-blue-500/5 rounded-full blur-[140px] pointer-events-none z-0"></div>

    <div class="relative z-10 flex flex-col min-h-screen bg-black text-white selection:bg-amber-500/30 selection:text-amber-200">
        <!-- Unified Top Header Nav -->
        <HeaderNav activePage="product" />

        <main class="flex-1">
            <!-- Hero Header -->
            <section class="pt-12 pb-12 sm:pt-20 sm:pb-16 px-4 sm:px-6 text-center max-w-5xl mx-auto">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-zinc-800 text-[11px] font-medium text-zinc-300 mb-6">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                    <span>MODE BLUEPRINT & PERENCANAAN TEKNIS</span>
                </div>

                <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white font-sans max-w-4xl mx-auto leading-[1.15]">
                    PRD & Technical Planning
                </h1>
                <p class="mt-4 sm:mt-6 text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed">
                    Hasilkan dokumen *Product Requirements Document* (PRD) profesional, diagram alur pengguna (*user flows*), skema entitas data (ERD), dan rincian arsitektur implementasi.
                </p>

                <div class="mt-8 flex items-center justify-center gap-3">
                    <a
                        href="/app?mode=prd"
                        class="px-6 py-3 rounded-xl bg-white hover:bg-zinc-200 text-zinc-950 font-bold text-xs transition-all shadow-lg shadow-white/10 flex items-center gap-2 cursor-pointer"
                    >
                        <span>Mulai Susun PRD di Studio</span>
                        <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </a>
                    <a
                        href="/tutorial"
                        class="px-5 py-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 text-xs font-semibold transition-all cursor-pointer"
                    >
                        <span>Pelajari Format PRD</span>
                    </a>
                </div>
            </section>

            <!-- Key Pillars Grid (2 columns on mobile) -->
            <section class="max-w-6xl mx-auto px-3 sm:px-6 pb-16">
                <div class="grid grid-cols-2 md:grid-cols-3 gap-2.5 sm:gap-6">
                    
                    <!-- Feature 1 -->
                    <div class="p-3.5 sm:p-6 rounded-xl sm:rounded-2xl bg-[#0c0c0e] border border-zinc-800/80 hover:border-zinc-700 transition-all flex flex-col justify-between">
                        <div>
                            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center mb-3 sm:mb-4">
                                <i class="fa-regular fa-file-lines text-xs sm:text-sm"></i>
                            </div>
                            <h3 class="text-xs sm:text-base font-bold text-white mb-1.5 sm:mb-2">Format Standar</h3>
                            <p class="text-[11px] sm:text-xs text-zinc-400 leading-relaxed line-clamp-3 sm:line-clamp-none">
                                Format PRD terstandarisasi: Executive Summary, Personas, Value Prop, dan KPI.
                            </p>
                        </div>
                        <div class="pt-3 sm:pt-6">
                            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded bg-zinc-900 border border-zinc-800 text-[9px] sm:text-[10px] font-medium text-amber-400">Spec Doc</span>
                        </div>
                    </div>

                    <!-- Feature 2 -->
                    <div class="p-3.5 sm:p-6 rounded-xl sm:rounded-2xl bg-[#0c0c0e] border border-zinc-800/80 hover:border-zinc-700 transition-all flex flex-col justify-between">
                        <div>
                            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center mb-3 sm:mb-4">
                                <i class="fa-solid fa-diagram-project text-xs sm:text-sm"></i>
                            </div>
                            <h3 class="text-xs sm:text-base font-bold text-white mb-1.5 sm:mb-2">Skema & API Contracts</h3>
                            <p class="text-[11px] sm:text-xs text-zinc-400 leading-relaxed line-clamp-3 sm:line-clamp-none">
                                Definisi model database (tabel, relasi) dan spesifikasi REST API siap koding.
                            </p>
                        </div>
                        <div class="pt-3 sm:pt-6">
                            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded bg-zinc-900 border border-zinc-800 text-[9px] sm:text-[10px] font-medium text-amber-400">Data Schema</span>
                        </div>
                    </div>

                    <!-- Feature 3 -->
                    <div class="p-3.5 sm:p-6 rounded-xl sm:rounded-2xl bg-[#0c0c0e] border border-zinc-800/80 hover:border-zinc-700 transition-all col-span-2 md:col-span-1 flex flex-col justify-between">
                        <div>
                            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center mb-3 sm:mb-4">
                                <i class="fa-solid fa-list-check text-xs sm:text-sm"></i>
                            </div>
                            <h3 class="text-xs sm:text-base font-bold text-white mb-1.5 sm:mb-2">Roadmap & Tahapan</h3>
                            <p class="text-[11px] sm:text-xs text-zinc-400 leading-relaxed line-clamp-3 sm:line-clamp-none">
                                Pembagian fase pengembangan MVP, estimasi kompleksitas, dan checklist rilis.
                            </p>
                        </div>
                        <div class="pt-3 sm:pt-6">
                            <span class="px-2 py-0.5 sm:px-2.5 sm:py-1 rounded bg-zinc-900 border border-zinc-800 text-[9px] sm:text-[10px] font-medium text-amber-400">Sprint Ready</span>
                        </div>
                    </div>

                </div>
            </section>

            <!-- How It Works Section -->
            <section class="max-w-4xl mx-auto px-4 sm:px-6 pb-24">
                <div class="p-8 rounded-3xl bg-[#09090b] border border-zinc-800/90 shadow-2xl">
                    <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2.5">
                        <i class="fa-solid fa-sitemap text-zinc-400 text-sm"></i>
                        <span>Cara Kerja Alur PRD / Planning</span>
                    </h2>

                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div class="w-7 h-7 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-xs font-semibold shrink-0">1</div>
                            <div>
                                <h4 class="text-sm font-semibold text-white mb-1">Tuliskan Ide atau Masalah Bisnis</h4>
                                <p class="text-xs text-zinc-400 leading-relaxed">Jelaskan target audiens dan fitur kunci yang ingin dibangun pada prompt wizard onboarding Studio.</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <div class="w-7 h-7 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-xs font-semibold shrink-0">2</div>
                            <div>
                                <h4 class="text-sm font-semibold text-white mb-1">AI Menyusun Blueprint Teknis Terstruktur</h4>
                                <p class="text-xs text-zinc-400 leading-relaxed">AI engine Gemini menganalisis kebutuhan dan menyusun dokumen PRD lengkap dalam format Markdown dan tabel terstruktur.</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <div class="w-7 h-7 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-xs font-semibold shrink-0">3</div>
                            <div>
                                <h4 class="text-sm font-semibold text-white mb-1">Iterasi & Perbaiki dengan AI Agent</h4>
                                <p class="text-xs text-zinc-400 leading-relaxed">Gunakan chat agent untuk menambahkan skema database khusus, alur edge-case, atau validasi aturan bisnis.</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <div class="w-7 h-7 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-xs font-semibold shrink-0">4</div>
                            <div>
                                <h4 class="text-sm font-semibold text-white mb-1">Konversi Langsung ke Kode Aplikasi</h4>
                                <p class="text-xs text-zinc-400 leading-relaxed">Gunakan dokumen PRD yang telah disetujui untuk langsung memerintahkan AI Studio membangun aplikasi full-stacknya.</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t border-zinc-800 flex items-center justify-between">
                        <span class="text-xs text-zinc-400">Siap merencanakan produk digital Anda?</span>
                        <a
                            href="/app?mode=prd"
                            class="group relative inline-flex items-center justify-center overflow-hidden px-3.5 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 text-xs font-semibold text-white transition-all cursor-pointer select-none"
                        >
                            <span class="mr-5 transition-opacity duration-500 group-hover:opacity-0">Open Studio (Mode PRD)</span>
                            <span class="absolute right-1 top-1 bottom-1 rounded-md z-10 grid w-5 place-items-center transition-all duration-500 bg-amber-500/20 group-hover:w-[calc(100%-0.5rem)] group-active:scale-95 text-amber-400">
                                <i class="fa-solid fa-chevron-right text-[9px]" aria-hidden="true"></i>
                            </span>
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <!-- Global Footer -->
        <Footer />
    </div>
</Layout>
