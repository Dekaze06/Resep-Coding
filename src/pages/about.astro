---
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav.astro';
---

<Layout title="Tentang Kami & Developer - Satusite Studio" description="Pelajari lebih lanjut mengenai Satusite Studio, tim pengembang, arsitektur AI, dan informasi kontak.">
    <!-- Subtle Ambient Background Glows -->
    <div class="fixed top-[-10%] left-[20%] w-[500px] h-[400px] bg-blue-600/5 rounded-full blur-[140px] pointer-events-none z-0"></div>
    <div class="fixed bottom-[-10%] right-[15%] w-[500px] h-[400px] bg-purple-500/5 rounded-full blur-[140px] pointer-events-none z-0"></div>

    <div class="relative z-10 flex flex-col min-h-screen bg-black text-white selection:bg-blue-500/30 selection:text-blue-200">
        <HeaderNav activePage="about" />

        <main class="flex-1">
            <!-- Hero Header -->
            <section class="pt-12 pb-12 sm:pt-20 sm:pb-16 px-4 sm:px-6 text-center max-w-5xl mx-auto">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-zinc-800 text-[11px] font-mono text-zinc-300 mb-6">
                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                <span>TENTANG SATUSITE STUDIO & TIM PENGEMBANG</span>
            </div>

            <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white font-sans max-w-4xl mx-auto leading-[1.15]">
                Mendemokratisasi Pembuatan Software dengan Autonomous AI
            </h1>
            <p class="mt-4 sm:mt-6 text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed">
                Satusite Studio adalah platform inovasi perancangan web & aplikasi full-stack otonom yang memungkinkan siapa saja membangun produk digital produksi dalam hitungan detik.
            </p>
        </section>

        <!-- Vision & Core Values -->
        <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="p-6 rounded-2xl bg-[#0c0c0e] border border-zinc-800">
                    <div class="w-10 h-10 rounded-xl bg-blue-600/10 border border-blue-500/20 text-blue-400 flex items-center justify-center mb-4">
                        <i class="fa-solid fa-bolt text-sm"></i>
                    </div>
                    <h3 class="text-base font-bold text-white mb-2">Kecepatan Tanpa Kompromi</h3>
                    <p class="text-xs text-zinc-400 leading-relaxed">
                        Mengubah ide abstrak menjadi antarmuka responsif dan arsitektur kode fullstack siap pakai dalam hitungan detik, bukan hitungan minggu.
                    </p>
                </div>

                <div class="p-6 rounded-2xl bg-[#0c0c0e] border border-zinc-800">
                    <div class="w-10 h-10 rounded-xl bg-emerald-600/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4">
                        <i class="fa-solid fa-code text-sm"></i>
                    </div>
                    <h3 class="text-base font-bold text-white mb-2">Kualitas Kode Produksi</h3>
                    <p class="text-xs text-zinc-400 leading-relaxed">
                        Menghasilkan kode modular, bersih, tanpa dependensi berlebih, serta mendukung standarisasi web modern (HTML5, Vanilla JS, Tailwind CSS, REST API).
                    </p>
                </div>

                <div class="p-6 rounded-2xl bg-[#0c0c0e] border border-zinc-800">
                    <div class="w-10 h-10 rounded-xl bg-purple-600/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mb-4">
                        <i class="fa-solid fa-shield-halved text-sm"></i>
                    </div>
                    <h3 class="text-base font-bold text-white mb-2">Kepemilikan Penuh & Privasi</h3>
                    <p class="text-xs text-zinc-400 leading-relaxed">
                        Seluruh kode dan aset yang dibuat adalah milik Anda 100%. Bebas diekspor, dihosting secara mandiri, atau dipush ke GitHub pribadi.
                    </p>
                </div>
            </div>
        </section>

        <!-- Developer Section -->
        <section id="developer" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-zinc-800/80">
            <div class="text-center mb-12">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-[10px] font-mono text-zinc-400 mb-3">
                    LEAD ARCHITECT & ENGINEERING
                </div>
                <h2 class="text-2xl sm:text-3xl font-bold text-white font-sans">Profil Pengembang</h2>
                <p class="text-xs sm:text-sm text-zinc-400 mt-2">Dibalik arsitektur engine AI dan ekosistem Satusite Studio.</p>
            </div>

            <div class="max-w-3xl mx-auto p-6 sm:p-8 rounded-3xl bg-[#0e0e12] border border-zinc-800 shadow-xl backdrop-blur-xl">
                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
                    <img
                        src="https://api.dicebear.com/7.x/bottts/svg?seed=DekazeStudio&backgroundColor=18181b"
                        alt="Developer Avatar"
                        class="w-24 h-24 rounded-2xl bg-zinc-900 border border-zinc-700 p-2 shrink-0 shadow-inner"
                    />
                    <div class="min-w-0 flex-1 space-y-3">
                        <div>
                            <h3 class="text-xl font-bold text-white">Dekaze / Akmal S.</h3>
                            <p class="text-xs text-blue-400 font-mono">Fullstack AI Systems Engineer & Product Creator</p>
                        </div>
                        <p class="text-xs text-zinc-300 leading-relaxed">
                            Fokus pada rekayasa antarmuka pengguna ultra-responsif, integrasi model bahasa besar (LLM Cascade Engine), optimasi arsitektur frontend modern, dan otomasi deployment cloud.
                        </p>
                        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 pt-1">
                            <span class="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-[11px] text-zinc-400 font-mono">Astro JS</span>
                            <span class="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-[11px] text-zinc-400 font-mono">React TS</span>
                            <span class="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-[11px] text-zinc-400 font-mono">Gemini AI 3.7</span>
                            <span class="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-[11px] text-zinc-400 font-mono">Tailwind CSS</span>
                            <span class="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 text-[11px] text-zinc-400 font-mono">Node.js</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Tech Stack Section -->
        <section id="tech" class="max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-zinc-800/80">
            <div class="text-center mb-12">
                <h2 class="text-2xl sm:text-3xl font-bold text-white font-sans">Teknologi & Engine Arsitektur</h2>
                <p class="text-xs sm:text-sm text-zinc-400 mt-2">Fondasi teknologi modern yang menjamin kecepatan dan keandalan sistem.</p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800/90 text-center">
                    <div class="text-xs font-bold text-white">Google Gemini 3.7 / 3.6</div>
                    <div class="text-[10px] text-zinc-500 mt-1">Multi-tier AI Reasoning Engine</div>
                </div>
                <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800/90 text-center">
                    <div class="text-xs font-bold text-white">Astro 5 & SSR</div>
                    <div class="text-[10px] text-zinc-500 mt-1">Ultra-fast Web Framework</div>
                </div>
                <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800/90 text-center">
                    <div class="text-xs font-bold text-white">React & TypeScript</div>
                    <div class="text-[10px] text-zinc-500 mt-1">Type-safe Dynamic UI</div>
                </div>
                <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800/90 text-center">
                    <div class="text-xs font-bold text-white">Vercel & Netlify Cloud</div>
                    <div class="text-[10px] text-zinc-500 mt-1">Edge Serverless Hosting</div>
                </div>
            </div>
        </section>

        <!-- Contact Us Section -->
        <section id="contact" class="max-w-4xl mx-auto px-4 sm:px-6 py-16 border-t border-zinc-800/80">
            <div class="text-center mb-10">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-[10px] font-mono text-blue-400 mb-3">
                    HUBUNGI KAMI
                </div>
                <h2 class="text-2xl sm:text-3xl font-bold text-white font-sans">Kirim Pesan & Konsultasi</h2>
                <p class="text-xs sm:text-sm text-zinc-400 mt-2">Punya pertanyaan seputar kustomisasi, integrasi API, atau kemitraan? Hubungi kami langsung.</p>
            </div>

            <div class="bg-[#0c0c0e] border border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
                <form id="contact-form" class="space-y-4 text-left text-xs">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label class="font-semibold text-zinc-300">Nama Lengkap</label>
                            <input
                                type="text"
                                id="contact-name"
                                required
                                placeholder="Masukkan nama Anda..."
                                class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500 transition-colors"
                            />
                        </div>
                        <div class="space-y-1.5">
                            <label class="font-semibold text-zinc-300">Email Kontak</label>
                            <input
                                type="email"
                                id="contact-email"
                                required
                                placeholder="nama@email.com..."
                                class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500 transition-colors"
                            />
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-semibold text-zinc-300">Subjek Kebutuhan</label>
                        <input
                            type="text"
                            id="contact-subject"
                            required
                            placeholder="Contoh: Kemitraan Agensi, Fitur Kustom, Pertanyaan Teknis..."
                            class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500 transition-colors"
                        />
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-semibold text-zinc-300">Isi Pesan Detail</label>
                        <textarea
                            id="contact-message"
                            rows={4}
                            required
                            placeholder="Jelaskan kebutuhan atau pertanyaan Anda..."
                            class="w-full p-3.5 rounded-xl bg-zinc-950 border border-zinc-800 text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500 transition-colors resize-none leading-relaxed"
                        ></textarea>
                    </div>

                    <div class="pt-2">
                        <button
                            type="submit"
                            id="btn-submit-contact"
                            class="w-full py-3 px-5 rounded-xl bg-white hover:bg-zinc-200 text-zinc-950 font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md"
                        >
                            <i class="fa-regular fa-paper-plane text-xs"></i>
                            <span>Kirim Pesan Sekarang</span>
                        </button>
                    </div>

                    <div id="contact-status" class="text-center text-xs mt-2"></div>
                </form>
            </div>
        </section>
    </main>
</div>
</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form");
    const name = document.getElementById("contact-name");
    const email = document.getElementById("contact-email");
    const subject = document.getElementById("contact-subject");
    const message = document.getElementById("contact-message");
    const status = document.getElementById("contact-status");
    const btn = document.getElementById("btn-submit-contact");

    if (form && btn && status) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-xs"></i> <span>Mengirimkan Pesan...</span>';

        setTimeout(() => {
          btn.disabled = false;
          btn.className = "w-full py-3 px-5 rounded-xl bg-emerald-500 text-white font-bold text-xs transition-all flex items-center justify-center gap-2";
          btn.innerHTML = '<i class="fa-solid fa-check text-xs"></i> <span>Pesan Berhasil Terkirim!</span>';
          status.innerHTML = '<span class="text-emerald-400 font-medium">Terima kasih! Pesan Anda telah kami terima. Tim kami akan merespons melalui email secepatnya.</span>';
          form.reset();

          setTimeout(() => {
            btn.className = "w-full py-3 px-5 rounded-xl bg-white hover:bg-zinc-200 text-zinc-950 font-bold text-xs transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md";
            btn.innerHTML = '<i class="fa-regular fa-paper-plane text-xs"></i> <span>Kirim Pesan Sekarang</span>';
          }, 5000);
        }, 1000);
      });
    }
  });
</script>
