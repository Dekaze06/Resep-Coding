---
import Layout from "../../layouts/Layout.astro";
import GenerativeArtScene from "../../components/ui/GenerativeArtScene";
import PrdSheetViewer from "../../components/PrdSheetViewer";
---

<Layout
    title="Studio PRD & Blueprint - Satusite AI Studio"
    description="Studio AI Agent khusus penyusunan Product Requirement Document (PRD), spesifikasi sistem komprehensif, dan hierarki blueprint arsitektur."
>
    <!-- Fluid Ambient Canvas Particles Background -->
    <div
        id="particles-bg"
        class="fixed top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none"
    >
        <canvas
            id="particles-canvas"
            class="absolute inset-0 w-full h-full opacity-20"></canvas>
    </div>

    <!-- Subtle Ambient Amber & Blue Gradients -->
    <div
        class="fixed top-[-10%] left-[20%] w-[500px] h-[400px] bg-amber-600/10 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>
    <div
        class="fixed bottom-[-10%] right-[15%] w-[500px] h-[400px] bg-blue-500/10 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>

    <div class="relative z-10 flex flex-col min-h-screen bg-black text-white selection:bg-amber-500/30 selection:text-amber-200">
        <!-- SLEEK COMPACT STUDIO TOPBAR (HEADER HIDDEN) -->
        <header class="h-14 sm:h-16 px-4 sm:px-8 border-b border-zinc-800/60 bg-zinc-950/70 backdrop-blur-xl flex items-center justify-between z-20 shrink-0">
            <div class="flex items-center gap-3">
                <a
                    href="/studio"
                    class="px-2.5 py-1.5 rounded-lg bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800/90 hover:border-zinc-700 text-zinc-400 hover:text-white text-xs font-medium transition-all flex items-center gap-2 cursor-pointer group"
                    title="Kembali ke Pilihan Studio"
                >
                    <i class="fa-solid fa-arrow-left text-[11px] group-hover:-translate-x-0.5 transition-transform"></i>
                    <span>Pilih Studio</span>
                </a>
                <div class="h-4 w-[1px] bg-zinc-800"></div>
                <div class="flex items-center gap-2 select-none">
                    <img src="/logo.png" alt="Satusite Logo" class="w-5 h-5 object-contain" />
                    <span class="text-xs font-semibold text-zinc-300 tracking-tight">Studio PRD & Blueprint</span>
                </div>
            </div>

            <!-- Right Status Indicator -->
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-zinc-900 text-zinc-300 border border-zinc-800">
                    PRD AI AGENT
                </span>
            </div>
        </header>

        <!-- HERO SECTION: DEDICATED PRD PROMPT STUDIO -->
        <section
            id="prd-prompt-studio"
            class="relative flex-1 flex flex-col justify-center py-12 sm:py-16 md:py-20 px-4 sm:px-6 text-center overflow-hidden"
        >
            <!-- 3D GENERATIVE MATTER SPHERE (Behind AI Chat Agent Box) -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] h-[320px] sm:w-[480px] sm:h-[480px] md:w-[720px] md:h-[720px] pointer-events-none z-0 flex items-center justify-center overflow-hidden opacity-60">
                <GenerativeArtScene client:only="react" color="#f59e0b" />
            </div>

            <div class="relative z-10 max-w-4xl mx-auto w-full space-y-4 sm:space-y-6">
                
                <!-- Title with Smooth Blur Fade Up Rotation -->
                <div class="space-y-2 flex items-center justify-center min-h-[44px] sm:min-h-[52px]">
                    <h1
                        id="prd-animated-title"
                        class="text-xl sm:text-2xl md:text-3xl font-normal tracking-tight text-zinc-100 font-sans leading-tight animate-title-in transition-all"
                    >
                        Dokumen Spesifikasi & Blueprint
                    </h1>
                </div>

                <!-- PROMPT STUDIO BOX (PRD DEDICATED) -->
                <div
                    class="mt-4 sm:mt-6 max-w-3xl mx-auto bg-zinc-900/70 border border-zinc-800/90 rounded-2xl p-4 sm:p-5 text-left shadow-2xl backdrop-blur-xl"
                >
                    <form id="studio-prompt-form" class="space-y-3.5">
                        <div class="relative">
                            <textarea
                                id="studio-prompt-input"
                                rows="3"
                                placeholder="Tuliskan konsep atau fitur aplikasi..."
                                class="w-full bg-zinc-950 border border-zinc-800 focus:border-amber-500/60 rounded-xl p-3.5 sm:p-4 text-xs sm:text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none transition-all resize-none font-sans"
                            ></textarea>
                        </div>

                        <!-- Prompt controls bar -->
                        <div class="flex items-center justify-between gap-3 pt-1">
                            <!-- Left: File Upload & Mode Indicator -->
                            <div class="flex items-center gap-1.5">
                                <label
                                    for="studio-file-upload"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Upload Dokumen / Catatan Kebutuhan"
                                >
                                    <i class="fa-solid fa-paperclip text-xs"></i>
                                    <input
                                        id="studio-file-upload"
                                        type="file"
                                        class="hidden"
                                        accept=".md,.markdown,.txt,.json,.csv,.pdf,.doc,.docx,.html,.yaml,.yml,.sql,image/*"
                                    />
                                </label>
                                <span
                                    id="studio-file-indicator"
                                    class="hidden text-[11px] text-zinc-300 bg-zinc-800 px-2 py-0.5 rounded truncate max-w-[140px]"
                                ></span>

                                <!-- Interactive Active Plan Pill Badge with Close Button on Left -->
                                <div
                                    id="container-active-plan-badge"
                                    class="hidden h-8 pl-1.5 pr-2.5 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/30 text-[11px] font-semibold text-amber-300 items-center gap-1.5 shadow-sm transition-all animate-fade-in"
                                >
                                    <!-- Close Button di Ujung Kiri -->
                                    <button
                                        type="button"
                                        id="btn-close-active-plan"
                                        class="w-5 h-5 rounded-md text-amber-400/80 hover:text-amber-200 hover:bg-amber-500/30 flex items-center justify-center transition-colors cursor-pointer"
                                        title="Tutup & Lepas Dokumen Aktif"
                                    >
                                        <i class="fa-solid fa-xmark text-[10px]"></i>
                                    </button>

                                    <!-- Clickable Document Name Trigger -->
                                    <button
                                        type="button"
                                        id="btn-active-plan-badge"
                                        class="flex items-center gap-1.5 cursor-pointer max-w-[140px] sm:max-w-[220px] truncate text-left focus:outline-none"
                                        title="Buka Dokumen Plan (.md)"
                                    >
                                        <i class="fa-solid fa-file-lines text-xs text-amber-400 shrink-0"></i>
                                        <span id="label-plan-badge" class="truncate font-semibold text-amber-300">Plan</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Right: Voice Icon & Generate Button -->
                            <div class="flex items-center gap-1.5">
                                <!-- Voice Dictation Icon -->
                                <button
                                    type="button"
                                    id="btn-studio-voice"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Input Suara"
                                >
                                    <i
                                        id="icon-studio-voice"
                                        class="fa-solid fa-microphone text-xs"
                                    ></i>
                                </button>

                                <!-- Generate Button -->
                                <button
                                    type="submit"
                                    id="btn-studio-generate"
                                    class="h-8 px-3 rounded-lg bg-white hover:bg-zinc-200 text-zinc-950 flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-md text-xs font-semibold"
                                    title="Generate Blueprint PRD (.md)"
                                >
                                    <i
                                        id="btn-studio-generate-icon"
                                        class="fa-solid fa-arrow-up text-xs text-zinc-950"
                                    ></i>
                                    <span id="btn-studio-generate-label" class="hidden sm:inline">Generate PRD</span>
                                </button>
                            </div>
                        </div>

                        <!-- Generation Status Banner (shown during generation) -->
                        <div
                            id="prd-generation-status"
                            class="hidden items-center justify-between p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs transition-all animate-pulse"
                        >
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-circle-notch fa-spin text-amber-400"></i>
                                <span id="prd-status-text">AI sedang menganalisis kebutuhan & menyusun Dokumen PRD (.md)...</span>
                            </div>
                            <span class="text-[10px] font-mono uppercase tracking-wider text-amber-400/80">AI Studio Engine</span>
                        </div>
                    </form>
                </div>
            </div>
        </section>


        <!-- DAFTAR PLAN YANG SUDAH DI-GENERATE (List2 Style Layout) -->
        <section id="prd-history-list-section" class="max-w-5xl mx-auto px-4 pb-20 pt-6">
            <div class="space-y-6">
                <!-- Header with Title and Search Filter at the Top -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-zinc-800/80">
                    <h2 class="text-xl sm:text-2xl font-semibold text-white tracking-tight">Daftar Plan</h2>

                    <!-- Search Filter Input -->
                    <div class="relative w-full sm:w-72">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-xs text-zinc-500"></i>
                        <input
                            type="text"
                            id="search-prd-history"
                            placeholder="Cari plan..."
                            class="w-full pl-8 pr-3 py-2 rounded-xl bg-zinc-900/90 border border-zinc-800 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-amber-500/50 transition-colors shadow-inner"
                        />
                    </div>
                </div>

                <!-- Plan Rows Container with Separator layout -->
                <div id="prd-history-container" class="flex flex-col divide-y divide-zinc-800/80 border-y border-zinc-800/80">
                    <div class="py-12 text-center text-zinc-500 text-xs">
                        <i class="fa-solid fa-circle-notch fa-spin text-sm text-amber-400 mb-2"></i>
                        <p>Memuat daftar plan...</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- PRD Slide-over Sheet Viewer (Smooth from the Right) -->
        <PrdSheetViewer client:load />
    </div>

    <!-- Client Script -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.getElementById("studio-prompt-form");
            const input = document.getElementById("studio-prompt-input");
            const fileUpload = document.getElementById("studio-file-upload");
            const fileIndicator = document.getElementById("studio-file-indicator");
            const voiceBtn = document.getElementById("btn-studio-voice");
            const voiceIcon = document.getElementById("icon-studio-voice");
            const generateBtn = document.getElementById("btn-studio-generate");
            const generateIcon = document.getElementById("btn-studio-generate-icon");
            const generateLabel = document.getElementById("btn-studio-generate-label");
            const statusBanner = document.getElementById("prd-generation-status");
            const statusText = document.getElementById("prd-status-text");

            // Active Plan Button in Prompt Bar
            const containerActivePlanBadge = document.getElementById("container-active-plan-badge");
            const btnCloseActivePlan = document.getElementById("btn-close-active-plan");
            const btnActivePlanBadge = document.getElementById("btn-active-plan-badge");
            const labelPlanBadge = document.getElementById("label-plan-badge");

            // PRD History List Elements
            const prdHistoryContainer = document.getElementById("prd-history-container");
            const searchPrdHistory = document.getElementById("search-prd-history");
            let allPrdProjects = [];

            let attachedFiles = [];
            let isGenerating = false;
            let currentSavedPrd = "";
            let currentSavedTitle = "";

            function updatePlanButton(markdown, customTitle) {
                if (!markdown || !markdown.trim()) {
                    currentSavedPrd = "";
                    currentSavedTitle = "";
                    if (containerActivePlanBadge) {
                        containerActivePlanBadge.classList.add("hidden");
                        containerActivePlanBadge.classList.remove("flex");
                    }
                    return;
                }

                currentSavedPrd = markdown;
                let title = customTitle;
                if (!title) {
                    const titleMatch = markdown.match(/#\s*(?:Planning Blueprint:?|PRD:?|Rencana:?)\s*([^\r\n]+)/i);
                    title = titleMatch ? titleMatch[1].trim() : "Dokumen Plan";
                }
                currentSavedTitle = title;

                try {
                    localStorage.setItem("satusite_active_prd", markdown);
                    localStorage.setItem("satusite_active_prd_title", title);
                } catch (e) {}

                if (labelPlanBadge) {
                    labelPlanBadge.textContent = title;
                }

                if (containerActivePlanBadge) {
                    containerActivePlanBadge.classList.remove("hidden");
                    containerActivePlanBadge.classList.add("flex");
                }
            }

            // Hydrate Plan button on mount if active PRD exists
            try {
                const saved = localStorage.getItem("satusite_active_prd");
                const savedTitle = localStorage.getItem("satusite_active_prd_title") || "";
                if (saved && saved.trim()) {
                    updatePlanButton(saved, savedTitle);
                }
            } catch (e) {}

            // Close / dismiss active Plan badge
            if (btnCloseActivePlan) {
                btnCloseActivePlan.addEventListener("click", (e) => {
                    e.stopPropagation();
                    currentSavedPrd = "";
                    currentSavedTitle = "";
                    try {
                        localStorage.removeItem("satusite_active_prd");
                        localStorage.removeItem("satusite_active_prd_title");
                    } catch (err) {}
                    if (containerActivePlanBadge) {
                        containerActivePlanBadge.classList.add("hidden");
                        containerActivePlanBadge.classList.remove("flex");
                    }
                });
            }

            // Open Plan sheet when Plan badge is clicked
            if (btnActivePlanBadge) {
                btnActivePlanBadge.addEventListener("click", () => {
                    const md = currentSavedPrd || localStorage.getItem("satusite_active_prd") || "";
                    if (md) {
                        window.dispatchEvent(new CustomEvent("open-prd-sheet", {
                            detail: { markdown: md, title: currentSavedTitle }
                        }));
                    }
                });
            }

            // --- PRD HISTORY LIST FETCHER & RENDERER ---
            async function loadPrdHistory() {
                if (!prdHistoryContainer) return;
                try {
                    const res = await fetch("/api/projects?mode=prd");
                    if (res.ok) {
                        const data = await res.json();
                        if (data && Array.isArray(data.projects)) {
                            allPrdProjects = data.projects;
                            renderPrdHistoryList(allPrdProjects);
                            return;
                        }
                    }
                } catch (e) {
                    console.warn("Failed fetching PRD history:", e);
                }

                // Fallback from localStorage
                try {
                    const storeRaw = localStorage.getItem("satusite_projects_store") || localStorage.getItem("emergent_projects_store");
                    if (storeRaw) {
                        const parsed = JSON.parse(storeRaw);
                        if (parsed && parsed.projects) {
                            const list = Object.values(parsed.projects).filter((p) => p.prd || p.mode === "prd");
                            allPrdProjects = list;
                            renderPrdHistoryList(allPrdProjects);
                            return;
                        }
                    }
                } catch (e) {}

                renderPrdHistoryList([]);
            }

            function renderPrdHistoryList(list) {
                if (!prdHistoryContainer) return;

                if (!list || list.length === 0) {
                    prdHistoryContainer.innerHTML = `
                        <div class="py-16 text-center text-zinc-500 text-xs">
                            <i class="fa-solid fa-file-lines text-2xl text-zinc-600 mb-2 block"></i>
                            <p class="font-medium text-zinc-400">Belum ada plan yang di-generate</p>
                            <p class="text-[11px] text-zinc-600 mt-1">Tulis instruksi di atas untuk mulai membuat Plan pertama Anda.</p>
                        </div>
                    `;
                    return;
                }

                prdHistoryContainer.innerHTML = list.map((item, idx) => {
                    const docText = item.prdContext || item.prd || item.code || "";
                    const title = item.name || "Dokumen Plan Blueprint";
                    const wordCount = docText ? docText.split(/\s+/).filter(Boolean).length : 0;
                    const lineCount = docText ? docText.split("\n").length : 0;
                    const dateStr = item.createdAt ? new Date(item.createdAt).toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" }) : "Tersimpan";

                    // Extract clean summary / description from PRD
                    let description = "";
                    const taglineMatch = docText.match(/(?:Tagline\s*\/?\s*Value Proposition|Ringkasan Konsep|Overview|Deskripsi):\s*([^\r\n]+)/i);
                    if (taglineMatch) {
                        description = taglineMatch[1].replace(/[*_#`]/g, "").trim();
                    } else if (item.prompt) {
                        description = item.prompt.replace(/[*_#`]/g, "").trim();
                    } else {
                        const lines = docText.split("\n").map(l => l.replace(/[*_#`]/g, "").trim()).filter(l => l && !l.startsWith("#") && !l.startsWith("-"));
                        description = lines.length > 0 ? lines[0] : "Dokumen Blueprint arsitektur & spesifikasi teknis MVP.";
                    }

                    return `
                        <div data-row-prd-idx="${idx}" class="grid items-center gap-4 px-3 sm:px-5 py-4 sm:py-5 grid-cols-1 md:grid-cols-4 hover:bg-zinc-900/40 transition-colors group cursor-pointer">
                            <!-- Col 1: Icon/Badge + Title + Sub-category -->
                            <div class="order-2 md:order-none flex items-center gap-3 min-w-0">
                                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-zinc-900 border border-zinc-800 text-amber-400 shadow-sm group-hover:border-amber-500/30 group-hover:bg-amber-500/10 transition-all">
                                    <i class="fa-solid fa-file-lines text-sm"></i>
                                </span>
                                <div class="flex flex-col gap-0.5 min-w-0">
                                    <h3 class="font-semibold text-white text-xs sm:text-sm truncate group-hover:text-amber-300 transition-colors">${title}</h3>
                                    <p class="text-[11px] text-zinc-500 flex items-center gap-1.5 flex-wrap">
                                        <span class="px-1.5 py-0.2 rounded text-[9px] font-mono font-bold bg-zinc-800 text-zinc-400 border border-zinc-700">.md</span>
                                        <span>•</span>
                                        <span>${wordCount.toLocaleString()} Kata</span>
                                        <span>•</span>
                                        <span>${dateStr}</span>
                                    </p>
                                </div>
                            </div>

                            <!-- Col 2: Description / Value Proposition (col-span-2) -->
                            <p class="order-1 md:order-none md:col-span-2 text-xs sm:text-sm font-normal text-zinc-300 line-clamp-2 leading-relaxed">
                                ${description}
                            </p>

                            <!-- Col 3: Actions -->
                            <div class="order-3 md:order-none flex items-center justify-end gap-1.5 ml-auto shrink-0" onclick="event.stopPropagation()">
                                <button
                                    type="button"
                                    data-copy-prd-idx="${idx}"
                                    class="w-8 h-8 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 hover:text-white border border-zinc-700/60 flex items-center justify-center transition-colors cursor-pointer"
                                    title="Salin .md"
                                >
                                    <i class="fa-solid fa-copy text-xs"></i>
                                </button>
                                <button
                                    type="button"
                                    data-download-prd-idx="${idx}"
                                    class="w-8 h-8 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 hover:text-white border border-zinc-700/60 flex items-center justify-center transition-colors cursor-pointer"
                                    title="Unduh .md"
                                >
                                    <i class="fa-solid fa-download text-xs"></i>
                                </button>
                                <button
                                    type="button"
                                    data-delete-prd-id="${item.id}"
                                    data-delete-prd-title="${title.replace(/"/g, '&quot;')}"
                                    class="w-8 h-8 rounded-xl bg-zinc-800/80 hover:bg-red-500/20 text-zinc-400 hover:text-red-400 border border-zinc-700/60 flex items-center justify-center transition-colors cursor-pointer"
                                    title="Hapus Plan"
                                >
                                    <i class="fa-solid fa-trash-can text-xs"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }).join("");

                // Wire click on entire document row to open PRD sheet
                prdHistoryContainer.querySelectorAll("[data-row-prd-idx]").forEach((row) => {
                    row.addEventListener("click", () => {
                        const idx = parseInt(row.getAttribute("data-row-prd-idx"), 10);
                        const item = list[idx];
                        if (item) {
                            const docText = item.prdContext || item.prd || item.code || "";
                            updatePlanButton(docText, item.name);
                            window.dispatchEvent(new CustomEvent("open-prd-sheet", {
                                detail: { markdown: docText, prompt: item.prompt || item.name, projectId: item.id }
                            }));
                        }
                    });
                });

                prdHistoryContainer.querySelectorAll("[data-copy-prd-idx]").forEach((btn) => {
                    btn.addEventListener("click", async (e) => {
                        e.stopPropagation();
                        const idx = parseInt(btn.getAttribute("data-copy-prd-idx"), 10);
                        const item = list[idx];
                        if (item) {
                            const docText = item.prdContext || item.prd || item.code || "";
                            try {
                                await navigator.clipboard.writeText(docText);
                                const originalHtml = btn.innerHTML;
                                btn.innerHTML = `<i class="fa-solid fa-check text-xs text-emerald-400"></i>`;
                                setTimeout(() => {
                                    btn.innerHTML = originalHtml;
                                }, 2000);
                            } catch (e) {}
                        }
                    });
                });

                prdHistoryContainer.querySelectorAll("[data-download-prd-idx]").forEach((btn) => {
                    btn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        const idx = parseInt(btn.getAttribute("data-download-prd-idx"), 10);
                        const item = list[idx];
                        if (item) {
                            const docText = item.prdContext || item.prd || item.code || "";
                            const rawTitle = (item.name || "plan-blueprint").toLowerCase().replace(/[^a-z0-9]+/g, "-");
                            const filename = `${rawTitle}.md`;
                            const blob = new Blob([docText], { type: "text/markdown;charset=utf-8" });
                            const url = URL.createObjectURL(blob);
                            const a = document.createElement("a");
                            a.href = url;
                            a.download = filename;
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);
                        }
                    });
                });

                prdHistoryContainer.querySelectorAll("[data-delete-prd-id]").forEach((btn) => {
                    btn.addEventListener("click", async (e) => {
                        e.stopPropagation();
                        const id = btn.getAttribute("data-delete-prd-id");
                        const docTitle = btn.getAttribute("data-delete-prd-title") || "dokumen ini";
                        if (!id) return;

                        if (confirm(`Apakah Anda yakin ingin menghapus "${docTitle}"?`)) {
                            try {
                                const res = await fetch(`/api/projects/${id}`, {
                                    method: "DELETE"
                                });
                                if (res.ok) {
                                    if (currentSavedTitle === docTitle) {
                                        currentSavedPrd = "";
                                        currentSavedTitle = "";
                                        try {
                                            localStorage.removeItem("satusite_active_prd");
                                            localStorage.removeItem("satusite_active_prd_title");
                                        } catch (e) {}
                                        if (containerActivePlanBadge) {
                                            containerActivePlanBadge.classList.add("hidden");
                                            containerActivePlanBadge.classList.remove("flex");
                                        }
                                    }
                                    loadPrdHistory();
                                } else {
                                    alert("Gagal menghapus dokumen plan.");
                                }
                            } catch (err) {
                                console.error("Delete PRD error:", err);
                                alert("Terjadi kesalahan saat menghapus plan.");
                            }
                        }
                    });
                });
            }

            // Search filter listener
            if (searchPrdHistory) {
                searchPrdHistory.addEventListener("input", (e) => {
                    const query = e.target.value.toLowerCase().trim();
                    if (!query) {
                        renderPrdHistoryList(allPrdProjects);
                    } else {
                        const filtered = allPrdProjects.filter((p) => {
                            const name = (p.name || "").toLowerCase();
                            const prd = (p.prdContext || p.prd || p.code || "").toLowerCase();
                            const prompt = (p.prompt || "").toLowerCase();
                            return name.includes(query) || prd.includes(query) || prompt.includes(query);
                        });
                        renderPrdHistoryList(filtered);
                    }
                });
            }

            // Load initial PRD history from database
            loadPrdHistory();

            function readFile(file) {
                return new Promise((resolve) => {
                    const isText = file.type.startsWith("text/") || 
                        file.name.endsWith(".md") || 
                        file.name.endsWith(".markdown") || 
                        file.name.endsWith(".txt") || 
                        file.name.endsWith(".json") || 
                        file.name.endsWith(".csv") || 
                        file.name.endsWith(".html") || 
                        file.name.endsWith(".yaml") || 
                        file.name.endsWith(".yml") || 
                        file.name.endsWith(".sql");
                    if (isText) {
                        const reader = new FileReader();
                        reader.onload = (ev) => resolve(ev.target.result || "");
                        reader.onerror = () => resolve("");
                        reader.readAsText(file);
                    } else {
                        resolve(`[Dokumen Terlampir: ${file.name}, Tipe: ${file.type || 'Dokumen'}, Ukuran: ${(file.size / 1024).toFixed(1)} KB]`);
                    }
                });
            }

            async function handleSelectedFile(file) {
                if (!file) return;
                const sizeKb = (file.size / 1024).toFixed(1) + " KB";
                const content = await readFile(file);
                attachedFiles = [{
                    name: file.name,
                    size: sizeKb,
                    type: file.type || "file",
                    content: content
                }];
                if (fileIndicator) {
                    fileIndicator.textContent = file.name;
                    fileIndicator.classList.remove("hidden");
                }
            }

            if (fileUpload) {
                fileUpload.addEventListener("change", async (e) => {
                    const file = e.target.files && e.target.files[0];
                    if (file) {
                        await handleSelectedFile(file);
                    } else {
                        attachedFiles = [];
                        if (fileIndicator) fileIndicator.classList.add("hidden");
                    }
                });
            }

            // Drag and drop support on form
            if (form) {
                form.addEventListener("dragover", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                });
                form.addEventListener("drop", async (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        await handleSelectedFile(e.dataTransfer.files[0]);
                    }
                });
            }

            // Paste support on input
            if (input) {
                input.addEventListener("paste", async (e) => {
                    if (e.clipboardData.files && e.clipboardData.files.length > 0) {
                        e.preventDefault();
                        await handleSelectedFile(e.clipboardData.files[0]);
                    }
                });
            }

            if (voiceBtn) {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (!SpeechRecognition) {
                    voiceBtn.style.display = "none";
                } else {
                    const recognition = new SpeechRecognition();
                    recognition.lang = "id-ID";
                    let isListening = false;

                    recognition.onresult = (ev) => {
                        const transcript = ev.results[0][0].transcript;
                        if (input) {
                            input.value = input.value ? `${input.value} ${transcript}` : transcript;
                            input.focus();
                        }
                    };

                    recognition.onend = () => {
                        isListening = false;
                        if (voiceIcon) voiceIcon.className = "fa-solid fa-microphone text-xs";
                    };

                    voiceBtn.addEventListener("click", () => {
                        if (isListening) {
                            recognition.stop();
                        } else {
                            try {
                                recognition.start();
                                isListening = true;
                                if (voiceIcon) voiceIcon.className = "fa-solid fa-microphone-slash text-xs text-red-400 animate-pulse";
                            } catch (err) {
                                console.warn("Voice error:", err);
                            }
                        }
                    });
                }
            }

            // Smooth Blur Fade Up Rotating Titles
            const titles = [
                "Dokumen Spesifikasi & Blueprint",
                "Analisis Kebutuhan & User Stories",
                "Pohon Hierarki Modul Sistem",
                "Arsitektur Skema Database & MVP"
            ];
            let currentTitleIdx = 0;
            const titleEl = document.getElementById("prd-animated-title");
            if (titleEl) {
                setInterval(() => {
                    titleEl.classList.remove("animate-title-in");
                    titleEl.classList.add("animate-title-out");
                    setTimeout(() => {
                        currentTitleIdx = (currentTitleIdx + 1) % titles.length;
                        titleEl.textContent = titles[currentTitleIdx];
                        titleEl.classList.remove("animate-title-out");
                        titleEl.classList.add("animate-title-in");
                    }, 400);
                }, 3500);
            }

            // On-Page Asynchronous PRD Generation with Smooth Right Drawer Slide-in
            if (form && input) {
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    if (isGenerating) return;

                    let promptText = input.value.trim();
                    if (!promptText && attachedFiles.length > 0) {
                        promptText = `Rancang dokumen arsitektur dan spesifikasi teknis (PRD) berdasarkan dokumen lampiran ${attachedFiles[0].name}.`;
                    }
                    if (attachedFiles.length > 0) {
                        promptText = `[Lampiran: ${attachedFiles[0].name}] ` + promptText;
                        if (attachedFiles[0].content) {
                            promptText += `\n\nIsi Lampiran:\n${attachedFiles[0].content.slice(0, 8000)}`;
                        }
                    }
                    if (!promptText) {
                        input.focus();
                        return;
                    }

                    isGenerating = true;
                    if (generateBtn) generateBtn.disabled = true;
                    if (generateIcon) generateIcon.className = "fa-solid fa-spinner fa-spin text-xs text-zinc-950";
                    if (generateLabel) generateLabel.textContent = "Menyusun...";
                    if (statusBanner) {
                        statusBanner.classList.remove("hidden");
                        statusBanner.classList.add("flex");
                    }
                    if (statusText) {
                        statusText.textContent = "AI sedang menganalisis kebutuhan & menyusun Dokumen PRD (.md)...";
                    }

                    let ownerEmail = "guest@satusite.com";
                    try {
                        const userRaw = localStorage.getItem("satusite_auth_user");
                        if (userRaw) {
                            const userObj = JSON.parse(userRaw);
                            if (userObj && userObj.email) {
                                ownerEmail = userObj.email;
                            }
                        }
                    } catch (e) {}

                    try {
                        const res = await fetch("/api/generate-prd", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                prompt: promptText,
                                desc: promptText,
                                owner: ownerEmail,
                                webName: promptText.slice(0, 40)
                            })
                        });

                        const data = await res.json();
                        if (res.ok && data && (data.markdown || data.prd)) {
                            const markdownDoc = data.markdown || data.prd;
                            const titleMatch = markdownDoc.match(/#\s*(?:Planning Blueprint:?|PRD:?|Rencana:?)\s*([^\r\n]+)/i);
                            const planTitle = data.name || (titleMatch ? titleMatch[1].trim() : promptText.slice(0, 35));

                            // Update Plan button in prompt bar & local storage with generated PRD name
                            updatePlanButton(markdownDoc, planTitle);

                            // Refresh database list
                            loadPrdHistory();

                            // Dispatch event to open smooth PRD slide-over sheet from the right
                            window.dispatchEvent(new CustomEvent("open-prd-sheet", {
                                detail: {
                                    markdown: markdownDoc,
                                    prompt: promptText,
                                    projectId: data.projectId,
                                    title: planTitle
                                }
                            }));

                            if (statusBanner) {
                                statusBanner.classList.add("hidden");
                                statusBanner.classList.remove("flex");
                            }
                        } else {
                            const errMsg = data?.error || "Gagal menyusun PRD. Silakan coba kembali.";
                            if (statusText) statusText.textContent = errMsg;
                            alert(errMsg);
                        }
                    } catch (err) {
                        console.error("Error generating PRD:", err);
                        const errMsg = "Terjadi gangguan jaringan saat menyusun PRD. Silakan periksa koneksi Anda.";
                        if (statusText) statusText.textContent = errMsg;
                        alert(errMsg);
                    } finally {
                        isGenerating = false;
                        if (generateBtn) generateBtn.disabled = false;
                        if (generateIcon) generateIcon.className = "fa-solid fa-arrow-up text-xs text-zinc-950";
                        if (generateLabel) generateLabel.textContent = "Generate PRD";
                        if (statusBanner) {
                            statusBanner.classList.add("hidden");
                            statusBanner.classList.remove("flex");
                        }
                    }
                });
            }
        });

        // Background Particles
        (function () {
            const canvas = document.getElementById("particles-canvas");
            if (!canvas) return;
            const ctx = canvas.getContext("2d");
            if (!ctx) return;

            let particles = [];
            const count = 45;

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }

            function init() {
                resize();
                particles = Array.from({ length: count }, () => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.35,
                    vy: (Math.random() - 0.5) * 0.35,
                    size: Math.random() * 1.5 + 0.5,
                    opacity: Math.random() * 0.3 + 0.1,
                }));
            }

            function loop() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                for (let i = 0; i < particles.length; i++) {
                    const p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = canvas.width;
                    if (p.x > canvas.width) p.x = 0;
                    if (p.y < 0) p.y = canvas.height;
                    if (p.y > canvas.height) p.y = 0;

                    ctx.fillStyle = `rgba(245, 158, 11, ${p.opacity * 0.35})`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                }

                requestAnimationFrame(loop);
            }

            window.addEventListener("resize", resize);
            document.addEventListener("DOMContentLoaded", () => {
                init();
                loop();
            });
        })();
    </script>

    <style>
        @keyframes titleFadeInUp {
            0% {
                opacity: 0;
                transform: translateY(12px);
                filter: blur(6px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0);
            }
        }
        @keyframes titleFadeOutUp {
            0% {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0);
            }
            100% {
                opacity: 0;
                transform: translateY(-12px);
                filter: blur(6px);
            }
        }
        .animate-title-in {
            animation: titleFadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .animate-title-out {
            animation: titleFadeOutUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</Layout>
