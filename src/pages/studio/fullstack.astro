---
import Layout from "../../layouts/Layout.astro";
import GenerativeArtScene from "../../components/ui/GenerativeArtScene";
---

<Layout
    title="Build App (Fullstack) - Satusite AI Studio"
    description="Studio AI Agent khusus pengembangan aplikasi web fullstack lengkap dengan database in-memory, logika CRUD, manipulasi data, dan panel admin."
>
    <!-- Fluid Ambient Canvas Particles Background -->
    <div
        id="particles-bg"
        class="fixed top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none"
    >
        <canvas
            id="particles-canvas"
            class="absolute inset-0 w-full h-full opacity-20"></canvas>
    </div>

    <!-- Subtle Ambient Purple & Fuchsia Gradients -->
    <div
        class="fixed top-[-10%] left-[20%] w-[500px] h-[400px] bg-purple-600/10 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>
    <div
        class="fixed top-[20%] left-1/2 -translate-x-1/2 w-[650px] h-[350px] bg-purple-600/10 rounded-full blur-[130px] pointer-events-none z-0"
    >
    </div>
    <div
        class="fixed bottom-[-10%] right-[15%] w-[500px] h-[400px] bg-fuchsia-600/10 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>

    <div class="relative z-10 flex flex-col min-h-screen bg-black text-white selection:bg-purple-500/30 selection:text-purple-200">
        <!-- SLEEK COMPACT STUDIO TOPBAR -->
        <header class="h-14 sm:h-16 px-4 sm:px-8 border-b border-zinc-800/60 bg-zinc-950/70 backdrop-blur-xl flex items-center justify-between z-20 shrink-0">
            <div class="flex items-center gap-3">
                <a
                    href="/studio"
                    class="px-3 py-1.5 rounded-xl bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800/90 hover:border-zinc-700 text-zinc-300 hover:text-white text-xs font-medium transition-all flex items-center gap-2 cursor-pointer group shadow-sm"
                    title="Kembali ke Pilihan Studio"
                >
                    <i class="fa-solid fa-arrow-left text-[11px] group-hover:-translate-x-0.5 transition-transform"></i>
                    <span>Pilih Studio</span>
                </a>
                <div class="h-4 w-[1px] bg-zinc-800"></div>
                <div class="flex items-center gap-2 select-none">
                    <img src="/logo.png" alt="Satusite Logo" class="w-5 h-5 object-contain" />
                    <span class="text-xs font-semibold text-zinc-300 tracking-tight">Build App (Fullstack Studio)</span>
                </div>
            </div>

            <!-- Right Status Indicator -->
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-mono font-semibold bg-zinc-900/90 text-zinc-300 border border-zinc-800 shadow-sm">
                    <span class="w-1.5 h-1.5 rounded-full bg-purple-500 animate-pulse"></span>
                    <span>BUILD APP AI AGENT</span>
                </span>
            </div>
        </header>

        <!-- HERO SECTION: DEDICATED FULLSTACK PROMPT STUDIO -->
        <section
            id="fullstack-prompt-studio"
            class="relative flex-1 flex flex-col justify-center py-10 sm:py-14 md:py-16 px-4 sm:px-6 text-center overflow-hidden"
        >
            <!-- 3D GENERATIVE MATTER SPHERE (Smooth radial mask blend) -->
            <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] h-[340px] sm:w-[500px] sm:h-[500px] md:w-[680px] md:h-[680px] pointer-events-none z-0 flex items-center justify-center overflow-hidden opacity-40"
                style="mask-image: radial-gradient(circle at center, black 30%, transparent 70%); -webkit-mask-image: radial-gradient(circle at center, black 30%, transparent 70%);"
            >
                <GenerativeArtScene client:only="react" color="#a855f7" />
            </div>

            <div class="relative z-10 max-w-4xl mx-auto w-full space-y-4 sm:space-y-6">
                <!-- Title Header Area -->
                <div class="space-y-2.5 flex flex-col items-center justify-center">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300 text-xs font-medium backdrop-blur-md shadow-sm">
                        <i class="fa-solid fa-wand-magic-sparkles text-[11px] text-purple-400"></i>
                        <span>Studio Arsitektur Fullstack Web App</span>
                    </div>
                    <h1
                        class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white font-sans leading-tight"
                    >
                        Bangun Aplikasi Web Fullstack
                    </h1>
                    <p
                        id="fullstack-animated-subtitle"
                        class="text-xs sm:text-sm text-zinc-400 max-w-lg mx-auto font-normal leading-relaxed transition-opacity duration-300 min-h-[22px]"
                    >
                        Frontend responsif, logika CRUD in-memory, dan panel kontrol interaktif langsung dari prompt Anda.
                    </p>
                </div>

                <!-- PROMPT STUDIO BOX (UNIFIED CLEAN GLASS CARD) -->
                <div
                    class="mt-2 sm:mt-4 max-w-3xl mx-auto rounded-2xl bg-zinc-900/80 border border-zinc-800/80 hover:border-zinc-700/80 focus-within:border-purple-500/50 focus-within:ring-2 focus-within:ring-purple-500/15 p-4 sm:p-5 text-left shadow-2xl shadow-purple-950/20 backdrop-blur-xl transition-all duration-300"
                >
                    <form id="studio-prompt-form" class="space-y-3.5">
                        <div class="relative">
                            <textarea
                                id="studio-prompt-input"
                                rows="3"
                                placeholder="Tuliskan ide aplikasi atau fitur sistem..."
                                class="w-full bg-transparent border-0 p-0 text-xs sm:text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:ring-0 transition-all resize-none font-sans leading-relaxed min-h-[68px]"
                            ></textarea>
                        </div>

                        <!-- Prompt controls bar -->
                        <div class="flex items-center justify-between gap-3 pt-2.5 border-t border-zinc-800/50">
                            <!-- Left: File Upload & Mode Indicator -->
                            <div class="flex items-center gap-2 flex-wrap">
                                <label
                                    for="studio-file-upload"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800/80 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Upload Skema / File Data"
                                >
                                    <i class="fa-solid fa-paperclip text-xs"></i>
                                    <input
                                        id="studio-file-upload"
                                        type="file"
                                        class="hidden"
                                        accept=".md,.markdown,.txt,.json,.csv,.pdf,.doc,.docx,.html,.yaml,.yml,.sql,image/*"
                                    />
                                </label>
                                <span
                                    id="studio-file-indicator"
                                    class="hidden text-[11px] text-purple-300 bg-purple-950/60 border border-purple-800/60 px-2.5 py-1 rounded-lg truncate max-w-[160px] inline-flex items-center gap-1.5 shadow-sm"
                                >
                                    <i class="fa-solid fa-file-lines text-[10px] text-purple-400 shrink-0"></i>
                                    <span id="studio-file-name" class="truncate"></span>
                                    <button
                                        type="button"
                                        id="btn-remove-attached-file"
                                        class="hover:text-white text-purple-400 ml-0.5 cursor-pointer shrink-0"
                                        title="Hapus lampiran"
                                    >
                                        <i class="fa-solid fa-xmark text-[10px]"></i>
                                    </button>
                                </span>

                                <!-- Static Fullstack Mode Badge -->
                                <div class="h-8 px-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-[11px] font-medium text-zinc-200 flex items-center gap-1.5 shadow-sm">
                                    <i class="fa-solid fa-database text-xs text-purple-400 shrink-0"></i>
                                    <span>Build App (Fullstack)</span>
                                </div>
                            </div>

                            <!-- Right: Voice Icon & Generate Button -->
                            <div class="flex items-center gap-2">
                                <!-- Voice Dictation Icon -->
                                <button
                                    type="button"
                                    id="btn-studio-voice"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800/80 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Input Suara"
                                >
                                    <i
                                        id="icon-studio-voice"
                                        class="fa-solid fa-microphone text-xs"
                                    ></i>
                                </button>

                                <!-- Generate Button -->
                                <button
                                    type="submit"
                                    id="btn-studio-generate"
                                    class="w-8 h-8 rounded-lg bg-purple-600 hover:bg-purple-500 active:scale-95 text-white flex items-center justify-center transition-all cursor-pointer shadow-md shadow-purple-600/30"
                                    title="Generate Fullstack"
                                >
                                    <i
                                        id="btn-studio-generate-icon"
                                        class="fa-solid fa-arrow-up text-xs text-white"
                                    ></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- QUICK PROMPT SUGGESTION CHIPS -->
                <div class="flex items-center justify-center gap-2 flex-wrap pt-1 text-xs">
                    <span class="text-zinc-500 text-[11px] font-medium">Contoh Ide:</span>
                    <button
                        type="button"
                        class="prompt-chip px-2.5 py-1 rounded-lg bg-zinc-900/50 hover:bg-zinc-800/80 border border-zinc-800 hover:border-purple-500/40 text-zinc-400 hover:text-zinc-200 text-[11px] transition-all cursor-pointer"
                        data-prompt="Buat aplikasi Kasir POS & Resto lengkap dengan keranjang belanja, cetak struk, dan panel laporan omzet"
                    >
                        Sistem Kasir POS
                    </button>
                    <button
                        type="button"
                        class="prompt-chip px-2.5 py-1 rounded-lg bg-zinc-900/50 hover:bg-zinc-800/80 border border-zinc-800 hover:border-purple-500/40 text-zinc-400 hover:text-zinc-200 text-[11px] transition-all cursor-pointer"
                        data-prompt="Buat sistem Manajemen Inventori Multi-Gudang dengan pencatatan stok masuk keluar dan alert restock"
                    >
                        Inventory Multi-Gudang
                    </button>
                    <button
                        type="button"
                        class="prompt-chip px-2.5 py-1 rounded-lg bg-zinc-900/50 hover:bg-zinc-800/80 border border-zinc-800 hover:border-purple-500/40 text-zinc-400 hover:text-zinc-200 text-[11px] transition-all cursor-pointer"
                        data-prompt="Buat aplikasi CRM Leads & Manajemen Prospek Klien dengan pipeline kanban stage dan catatan follow up"
                    >
                        CRM Pipeline & Leads
                    </button>
                    <button
                        type="button"
                        class="prompt-chip px-2.5 py-1 rounded-lg bg-zinc-900/50 hover:bg-zinc-800/80 border border-zinc-800 hover:border-purple-500/40 text-zinc-400 hover:text-zinc-200 text-[11px] transition-all cursor-pointer"
                        data-prompt="Buat portal Pendaftaran Siswa PPDB Online dengan form verifikasi berkas, kuota jurusan, dan portal admin seleksi"
                    >
                        PPDB Online Sekolah
                    </button>
                </div>
            </div>
        </section>

        <!-- SUB-HEADER SECTION / FEATURES HIGHLIGHTS -->
        <section class="max-w-4xl mx-auto w-full px-4 py-6 sm:py-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-4 sm:p-5 rounded-2xl bg-zinc-900/30 hover:bg-zinc-900/60 border border-zinc-800/70 hover:border-purple-500/30 backdrop-blur-sm transition-all duration-300 group flex items-start gap-3.5">
                    <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-purple-500/20 transition-all">
                        <i class="fa-solid fa-database text-sm"></i>
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-sm font-semibold text-zinc-100 group-hover:text-purple-300 transition-colors">In-Memory Database & LocalStorage</h3>
                        <p class="text-xs text-zinc-400 leading-relaxed">
                            Manajemen data multi-tabel relasional dengan sinkronisasi otomatis ke penyimpanan browser Anda.
                        </p>
                    </div>
                </div>

                <div class="p-4 sm:p-5 rounded-2xl bg-zinc-900/30 hover:bg-zinc-900/60 border border-zinc-800/70 hover:border-purple-500/30 backdrop-blur-sm transition-all duration-300 group flex items-start gap-3.5">
                    <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-purple-500/20 transition-all">
                        <i class="fa-solid fa-chart-line text-sm"></i>
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-sm font-semibold text-zinc-100 group-hover:text-purple-300 transition-colors">4-Panel Switcher & Live Analytics</h3>
                        <p class="text-xs text-zinc-400 leading-relaxed">
                            Beralih cepat antara panel Kasir POS, Manajemen Master CRUD, Dashboard KPI, dan REST API Console.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- DAFTAR PROYEK FULLSTACK YANG SUDAH DI-GENERATE -->
        <section id="fullstack-history-list-section" class="max-w-4xl mx-auto w-full px-4 pb-20 pt-2">
            <div class="space-y-4">
                <!-- Header with Title and Search Filter at the Top -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-zinc-800/60">
                    <div class="flex items-center gap-2.5">
                        <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-400 border border-purple-500/20 flex items-center justify-center text-xs">
                            <i class="fa-solid fa-database"></i>
                        </span>
                        <h2 class="text-base sm:text-lg font-semibold text-white tracking-tight">Daftar Proyek Build App</h2>
                        <span id="fullstack-project-count-badge" class="px-2 py-0.5 rounded-full bg-zinc-800/80 border border-zinc-700/60 text-[11px] font-mono font-medium text-zinc-400">0</span>
                    </div>

                    <!-- Search Filter Input -->
                    <div class="relative w-full sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-xs text-zinc-500"></i>
                        <input
                            type="text"
                            id="search-fullstack-history"
                            placeholder="Cari proyek build app..."
                            class="w-full pl-8 pr-8 py-1.5 rounded-xl bg-zinc-900/60 border border-zinc-800/80 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-purple-500/50 focus:ring-1 focus:ring-purple-500/20 transition-all"
                        />
                        <button
                            type="button"
                            id="btn-clear-fullstack-search"
                            class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 text-xs transition-colors cursor-pointer"
                            title="Hapus pencarian"
                        >
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>

                <!-- History Rows Container -->
                <div id="fullstack-history-container" class="space-y-3">
                    <div class="py-12 text-center text-zinc-500 text-xs">
                        <i class="fa-solid fa-circle-notch fa-spin text-sm text-purple-400 mb-2"></i>
                        <p>Memuat daftar proyek build app...</p>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Client Script -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.getElementById("studio-prompt-form");
            const input = document.getElementById("studio-prompt-input");
            const fileUpload = document.getElementById("studio-file-upload");
            const fileIndicator = document.getElementById("studio-file-indicator");
            const voiceBtn = document.getElementById("btn-studio-voice");
            const voiceIcon = document.getElementById("icon-studio-voice");
            const generateIcon = document.getElementById("btn-studio-generate-icon");

            let attachedFiles = [];
            let isGeneratingPrompt = false;
            let navTimer = null;

            function readFile(file) {
                return new Promise((resolve) => {
                    const isText = file.type.startsWith("text/") || 
                        file.name.endsWith(".md") || 
                        file.name.endsWith(".markdown") || 
                        file.name.endsWith(".txt") || 
                        file.name.endsWith(".json") || 
                        file.name.endsWith(".csv") || 
                        file.name.endsWith(".html") || 
                        file.name.endsWith(".yaml") || 
                        file.name.endsWith(".yml") || 
                        file.name.endsWith(".sql");
                    if (isText) {
                        const reader = new FileReader();
                        reader.onload = (ev) => resolve(ev.target.result || "");
                        reader.onerror = () => resolve("");
                        reader.readAsText(file);
                    } else {
                        resolve(`[Dokumen Terlampir: ${file.name}, Tipe: ${file.type || 'Dokumen'}, Ukuran: ${(file.size / 1024).toFixed(1)} KB]`);
                    }
                });
            }

            async function handleSelectedFile(file) {
                if (!file) return;
                const sizeKb = (file.size / 1024).toFixed(1) + " KB";
                const content = await readFile(file);
                attachedFiles = [{
                    name: file.name,
                    size: sizeKb,
                    type: file.type || "file",
                    content: content
                }];
                if (fileIndicator) {
                    const nameSpan = document.getElementById("studio-file-name");
                    if (nameSpan) {
                        nameSpan.textContent = file.name;
                    } else {
                        fileIndicator.textContent = file.name;
                    }
                    fileIndicator.classList.remove("hidden");
                }
            }

            const removeFileBtn = document.getElementById("btn-remove-attached-file");
            if (removeFileBtn) {
                removeFileBtn.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    attachedFiles = [];
                    if (fileUpload) fileUpload.value = "";
                    if (fileIndicator) fileIndicator.classList.add("hidden");
                });
            }

            if (fileUpload) {
                fileUpload.addEventListener("change", async (e) => {
                    const file = e.target.files && e.target.files[0];
                    if (file) {
                        await handleSelectedFile(file);
                    } else {
                        attachedFiles = [];
                        if (fileIndicator) fileIndicator.classList.add("hidden");
                    }
                });
            }

            // Drag and drop support on form
            if (form) {
                form.addEventListener("dragover", (e) => {
                    e.preventDefault();
                    form.classList.add("border-purple-500/50");
                });
                form.addEventListener("dragleave", () => {
                    form.classList.remove("border-purple-500/50");
                });
                form.addEventListener("drop", async (e) => {
                    e.preventDefault();
                    form.classList.remove("border-purple-500/50");
                    const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
                    if (file) {
                        await handleSelectedFile(file);
                    }
                });
            }

            // Paste support on input
            if (input) {
                input.addEventListener("paste", async (e) => {
                    if (e.clipboardData.files && e.clipboardData.files.length > 0) {
                        e.preventDefault();
                        await handleSelectedFile(e.clipboardData.files[0]);
                    }
                });
            }

            // Voice Speech-to-Text Support
            if (voiceBtn && input) {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (SpeechRecognition) {
                    const recognition = new SpeechRecognition();
                    recognition.lang = "id-ID";
                    recognition.interimResults = false;

                    recognition.onstart = () => {
                        if (voiceIcon) voiceIcon.className = "fa-solid fa-circle-notch fa-spin text-xs text-purple-400";
                    };
                    recognition.onresult = (event) => {
                        const transcript = event.results[0][0].transcript;
                        input.value = input.value ? `${input.value} ${transcript}` : transcript;
                    };
                    recognition.onend = () => {
                        if (voiceIcon) voiceIcon.className = "fa-solid fa-microphone text-xs";
                    };
                    recognition.onerror = () => {
                        if (voiceIcon) voiceIcon.className = "fa-solid fa-microphone text-xs";
                    };

                    voiceBtn.addEventListener("click", () => {
                        try {
                            recognition.start();
                        } catch (e) {
                            try {
                                recognition.stop();
                            } catch (err) {}
                        }
                    });
                }
            }

            // --- FULLSTACK PROJECTS HISTORY FETCHER & RENDERER ---
            const fullstackHistoryContainer = document.getElementById("fullstack-history-container");
            const searchFullstackInput = document.getElementById("search-fullstack-history");
            const clearSearchBtn = document.getElementById("btn-clear-fullstack-search");
            const countBadge = document.getElementById("fullstack-project-count-badge");
            let allFullstackProjects = [];

            // Sanitize and clean raw titles & prompts (e.g. uploaded PRD document dumps)
            function formatProjectTitle(name, prompt) {
                let raw = (name || "").trim();
                if (!raw || raw.toLowerCase().startsWith("aplikasi fullstack") || raw.length < 3) {
                    raw = (prompt || "").trim();
                }
                raw = raw.replace(/\[(?:Lampiran|Dokumen Terlampir)[^\]]*\]/gi, "");
                raw = raw.replace(/===.*?===/gi, "");
                raw = raw.replace(/[I|V|X]+\.\s*LAMPIRAN\s*DOKUMEN[^\n]*/gi, "");
                raw = raw.replace(/[*_#`>]/g, "");
                raw = raw.trim();

                if (!raw || raw.length < 2) {
                    const orig = name || prompt || "";
                    const m = orig.match(/\[(?:Lampiran|Dokumen Terlampir):\s*([^\]]+)\]/i);
                    if (m && m[1]) {
                        return m[1].replace(/\.[^/.]+$/, "").replace(/[-_]/g, " ").trim();
                    }
                    return "Aplikasi Fullstack Web App";
                }
                return raw;
            }

            function formatProjectExcerpt(prompt, name) {
                let raw = (prompt || "").trim();
                raw = raw.replace(/\[(?:Lampiran|Dokumen Terlampir)[^\]]*\]/gi, "");
                raw = raw.replace(/===.*?===/gi, "");
                raw = raw.replace(/[I|V|X]+\.\s*LAMPIRAN\s*DOKUMEN[^\n]*/gi, "");
                raw = raw.replace(/^#+\s+/gm, "");
                raw = raw.replace(/[*_#`>]/g, " ");
                raw = raw.replace(/\s+/g, " ").trim();

                if (!raw || raw.length < 6) {
                    return "Aplikasi web mandiri dengan database in-memory, logika CRUD multi-tabel, dan panel kontrol terintegrasi.";
                }
                return raw;
            }

            async function loadFullstackHistory() {
                if (!fullstackHistoryContainer) return;
                let fetchedProjects = [];
                try {
                    const res = await fetch("/api/projects?mode=fullstack");
                    if (res.ok) {
                        const data = await res.json();
                        if (data && Array.isArray(data.projects)) {
                            fetchedProjects = data.projects;
                        }
                    }
                } catch (e) {
                    console.warn("Failed fetching fullstack history:", e);
                }

                // Merge fallback from localStorage
                try {
                    const storeRaw = localStorage.getItem("satusite_projects_store") || localStorage.getItem("emergent_projects_store");
                    if (storeRaw) {
                        const parsed = JSON.parse(storeRaw);
                        if (parsed && parsed.projects) {
                            const list = Object.values(parsed.projects).filter((p) => p.mode === "fullstack" || (!p.mode && !p.prd));
                            list.forEach(lp => {
                                if (!fetchedProjects.some(fp => fp.id === lp.id)) {
                                    fetchedProjects.unshift({
                                        id: lp.id,
                                        name: lp.name || "Aplikasi Fullstack",
                                        category: lp.category || "Fullstack App",
                                        mode: "fullstack",
                                        prompt: lp.prompt || (lp.messages && lp.messages[0]?.text) || "",
                                        code: lp.code || "",
                                        createdAt: lp.createdAt || lp.updatedAt || Date.now()
                                    });
                                }
                            });
                        }
                    }
                } catch (e) {}

                allFullstackProjects = fetchedProjects;
                renderFullstackHistoryList(allFullstackProjects);
            }

            function renderFullstackHistoryList(list) {
                if (!fullstackHistoryContainer) return;

                if (countBadge) {
                    countBadge.textContent = `${list.length}`;
                }

                if (!list || list.length === 0) {
                    fullstackHistoryContainer.innerHTML = `
                        <div class="py-14 px-4 text-center rounded-2xl bg-zinc-900/20 border border-zinc-800/40">
                            <div class="w-12 h-12 rounded-2xl bg-zinc-900 border border-zinc-800 text-zinc-500 flex items-center justify-center mx-auto mb-3">
                                <i class="fa-solid fa-database text-lg"></i>
                            </div>
                            <p class="font-medium text-zinc-300 text-xs sm:text-sm">Belum ada proyek Build App yang sesuai</p>
                            <p class="text-[11px] text-zinc-500 mt-1 max-w-sm mx-auto">Tuliskan ide aplikasi di atas atau coba kata kunci pencarian yang lain.</p>
                        </div>
                    `;
                    return;
                }

                fullstackHistoryContainer.innerHTML = list.map((item, idx) => {
                    const rawTitle = item.name || "Aplikasi Fullstack Web App";
                    const rawPrompt = item.prompt || "";
                    const cleanTitleStr = formatProjectTitle(rawTitle, rawPrompt);
                    const cleanDescStr = formatProjectExcerpt(rawPrompt, rawTitle);
                    const dateStr = item.createdAt ? new Date(item.createdAt).toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" }) : "Tersimpan";

                    return `
                        <div data-row-full-idx="${idx}" class="group relative flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 sm:p-5 rounded-2xl bg-zinc-900/40 hover:bg-zinc-900/80 border border-zinc-800/80 hover:border-purple-500/40 backdrop-blur-sm transition-all duration-300 shadow-sm hover:shadow-xl hover:shadow-purple-950/20 cursor-pointer">
                            <div class="flex items-start sm:items-center gap-3.5 min-w-0 flex-1">
                                <div class="w-11 h-11 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center shrink-0 group-hover:scale-105 group-hover:bg-purple-500/20 transition-all shadow-sm">
                                    <i class="fa-solid fa-database text-sm"></i>
                                </div>
                                <div class="min-w-0 flex-1 space-y-1">
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="font-semibold text-white text-sm sm:text-base group-hover:text-purple-300 transition-colors truncate max-w-[280px] sm:max-w-[420px]">
                                            ${cleanTitleStr}
                                        </h3>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-purple-500/15 text-purple-300 border border-purple-500/30">
                                            Build App
                                        </span>
                                        <span class="text-zinc-600 text-xs hidden sm:inline">•</span>
                                        <span class="text-[11px] text-zinc-500 font-medium flex items-center gap-1">
                                            <i class="fa-regular fa-clock text-[10px]"></i>
                                            <span>${dateStr}</span>
                                        </span>
                                    </div>
                                    <p class="text-xs text-zinc-400 line-clamp-1 sm:line-clamp-2 leading-relaxed">
                                        ${cleanDescStr}
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 shrink-0 self-end sm:self-center pt-2 sm:pt-0" onclick="event.stopPropagation()">
                                <a
                                    href="/app?id=${item.id}"
                                    class="px-3.5 py-1.5 rounded-xl bg-zinc-800/90 hover:bg-purple-600 text-zinc-200 hover:text-white border border-zinc-700/80 hover:border-purple-500 flex items-center gap-2 text-xs font-medium transition-all shadow-sm group/btn"
                                    title="Buka di Studio Canvas"
                                >
                                    <span>Studio</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px] group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform"></i>
                                </a>
                                <button
                                    type="button"
                                    data-download-full-idx="${idx}"
                                    class="w-8 h-8 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 hover:text-white border border-zinc-700/70 flex items-center justify-center transition-all cursor-pointer"
                                    title="Unduh HTML"
                                >
                                    <i class="fa-solid fa-download text-xs"></i>
                                </button>
                                <button
                                    type="button"
                                    data-delete-full-id="${item.id}"
                                    data-delete-full-title="${cleanTitleStr.replace(/"/g, '&quot;')}"
                                    class="w-8 h-8 rounded-xl bg-zinc-800/80 hover:bg-red-500/20 text-zinc-400 hover:text-red-400 border border-zinc-700/70 hover:border-red-500/30 flex items-center justify-center transition-all cursor-pointer"
                                    title="Hapus Proyek"
                                >
                                    <i class="fa-solid fa-trash-can text-xs"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }).join("");

                // Row click handler to open studio
                document.querySelectorAll("[data-row-full-idx]").forEach(row => {
                    row.addEventListener("click", () => {
                        const idx = parseInt(row.getAttribute("data-row-full-idx") || "0", 10);
                        const item = allFullstackProjects[idx];
                        if (item && item.id) {
                            window.location.href = `/app?id=${item.id}`;
                        }
                    });
                });

                // Download handler
                document.querySelectorAll("[data-download-full-idx]").forEach(btn => {
                    btn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        const idx = parseInt(btn.getAttribute("data-download-full-idx") || "0", 10);
                        const item = allFullstackProjects[idx];
                        if (!item) return;
                        const code = item.code || `<!DOCTYPE html><html><head><title>${item.name}</title></head><body><h1>${item.name}</h1></body></html>`;
                        const blob = new Blob([code], { type: "text/html;charset=utf-8;" });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement("a");
                        a.href = url;
                        a.download = `${(item.name || "fullstack-project").toLowerCase().replace(/[^a-z0-9]/g, "-")}.html`;
                        a.click();
                        URL.revokeObjectURL(url);
                    });
                });

                // Delete handler
                document.querySelectorAll("[data-delete-full-id]").forEach(btn => {
                    btn.addEventListener("click", async (e) => {
                        e.stopPropagation();
                        const id = btn.getAttribute("data-delete-full-id");
                        const title = btn.getAttribute("data-delete-full-title") || "Proyek ini";
                        if (!id) return;
                        if (!confirm(`Hapus proyek "${title}" secara permanen?`)) return;

                        try {
                            await fetch(`/api/projects/${id}`, { method: "DELETE" });
                        } catch (err) {}

                        try {
                            const storeRaw = localStorage.getItem("satusite_projects_store") || localStorage.getItem("emergent_projects_store");
                            if (storeRaw) {
                                const store = JSON.parse(storeRaw);
                                if (store && store.projects && store.projects[id]) {
                                    delete store.projects[id];
                                    localStorage.setItem("satusite_projects_store", JSON.stringify(store));
                                }
                            }
                        } catch (err) {}

                        allFullstackProjects = allFullstackProjects.filter(p => p.id !== id);
                        renderFullstackHistoryList(allFullstackProjects);
                    });
                });
            }

            // Realtime search filter
            if (searchFullstackInput) {
                searchFullstackInput.addEventListener("input", (e) => {
                    const q = (e.target.value || "").toLowerCase().trim();
                    if (clearSearchBtn) {
                        if (q) clearSearchBtn.classList.remove("hidden");
                        else clearSearchBtn.classList.add("hidden");
                    }
                    if (!q) {
                        renderFullstackHistoryList(allFullstackProjects);
                        return;
                    }
                    const filtered = allFullstackProjects.filter(p => {
                        const name = (p.name || "").toLowerCase();
                        const prompt = (p.prompt || "").toLowerCase();
                        return name.includes(q) || prompt.includes(q);
                    });
                    renderFullstackHistoryList(filtered);
                });
            }

            if (clearSearchBtn && searchFullstackInput) {
                clearSearchBtn.addEventListener("click", () => {
                    searchFullstackInput.value = "";
                    clearSearchBtn.classList.add("hidden");
                    renderFullstackHistoryList(allFullstackProjects);
                    searchFullstackInput.focus();
                });
            }

            // Quick Prompt Suggestion Chips handler
            document.querySelectorAll(".prompt-chip").forEach(chip => {
                chip.addEventListener("click", () => {
                    if (input) {
                        input.value = chip.getAttribute("data-prompt") || chip.textContent.trim();
                        input.focus();
                    }
                });
            });

            loadFullstackHistory();

            // Smooth Rotating Subtitles
            const subtitles = [
                "Frontend responsif, logika CRUD in-memory, dan panel kontrol interaktif.",
                "Database relasional multi-tabel dengan sinkronisasi instan ke browser.",
                "Beralih instan antara panel Kasir POS, Manajemen Master, dan REST API Console.",
                "Arsitektur mandiri siap unduh HTML tanpa dependensi server eksternal."
            ];
            let subIdx = 0;
            const subEl = document.getElementById("fullstack-animated-subtitle");
            if (subEl) {
                setInterval(() => {
                    subEl.style.opacity = "0";
                    setTimeout(() => {
                        subIdx = (subIdx + 1) % subtitles.length;
                        subEl.textContent = subtitles[subIdx];
                        subEl.style.opacity = "1";
                    }, 300);
                }, 4500);
            }

            // Form Submission
            if (form && input) {
                form.addEventListener("submit", (e) => {
                    e.preventDefault();
                    if (isGeneratingPrompt) {
                        if (navTimer) clearTimeout(navTimer);
                        isGeneratingPrompt = false;
                        if (generateIcon) generateIcon.className = "fa-solid fa-arrow-up text-xs";
                        return;
                    }

                    let promptText = input.value.trim();
                    if (!promptText && attachedFiles.length > 0) {
                        promptText = `Bangun aplikasi fullstack lengkap dengan CRUD dan database in-memory berdasarkan dokumen lampiran ${attachedFiles[0].name}.`;
                    }
                    if (attachedFiles.length > 0) {
                        promptText = `[Lampiran: ${attachedFiles[0].name}] ` + promptText;
                        try {
                            sessionStorage.setItem("satusite_pending_attached_docs", JSON.stringify(attachedFiles));
                        } catch (err) {
                            console.warn("Storage save error:", err);
                        }
                    }
                    if (!promptText) return;

                    isGeneratingPrompt = true;
                    if (generateIcon) generateIcon.className = "fa-solid fa-square text-[10px] text-white";

                    navTimer = setTimeout(() => {
                        window.location.href = `/app?prompt=${encodeURIComponent(promptText)}&mode=fullstack`;
                    }, 400);
                });
            }
        });

        // Background Particles
        (function () {
            const canvas = document.getElementById("particles-canvas");
            if (!canvas) return;
            const ctx = canvas.getContext("2d");
            if (!ctx) return;

            let particles = [];
            const count = 45;

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }

            function init() {
                resize();
                particles = Array.from({ length: count }, () => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.35,
                    vy: (Math.random() - 0.5) * 0.35,
                    size: Math.random() * 1.5 + 0.5,
                    opacity: Math.random() * 0.3 + 0.1,
                }));
            }

            function loop() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                for (let i = 0; i < particles.length; i++) {
                    const p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = canvas.width;
                    if (p.x > canvas.width) p.x = 0;
                    if (p.y < 0) p.y = canvas.height;
                    if (p.y > canvas.height) p.y = 0;

                    ctx.fillStyle = `rgba(168, 85, 247, ${p.opacity * 0.35})`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                }

                requestAnimationFrame(loop);
            }

            window.addEventListener("resize", resize);
            document.addEventListener("DOMContentLoaded", () => {
                init();
                loop();
            });
        })();
    </script>

    <style>
        /* Smooth micro-interactions & subtle glow accents */
        #studio-prompt-input::-webkit-scrollbar {
            width: 4px;
        }
        #studio-prompt-input::-webkit-scrollbar-thumb {
            background: rgba(168, 85, 247, 0.2);
            border-radius: 9999px;
        }
        #studio-prompt-input::-webkit-scrollbar-thumb:hover {
            background: rgba(168, 85, 247, 0.4);
        }
    </style>
</Layout>
