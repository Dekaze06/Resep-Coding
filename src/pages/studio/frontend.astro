---
import Layout from "../../layouts/Layout.astro";
import GenerativeArtScene from "../../components/ui/GenerativeArtScene";
---

<Layout
    title="Studio Frontend - Satusite AI Studio"
    description="Studio AI Agent khusus perancangan antarmuka visual responsif, animasi CSS modern, micro-interactions, dan layout mobile-first."
>
    <!-- Fluid Ambient Canvas Particles Background -->
    <div
        id="particles-bg"
        class="fixed top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none"
    >
        <canvas
            id="particles-canvas"
            class="absolute inset-0 w-full h-full opacity-20"></canvas>
    </div>

    <!-- Subtle Ambient Blue & Sky Gradients -->
    <div
        class="fixed top-[-10%] left-[20%] w-[500px] h-[400px] bg-blue-600/15 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>
    <div
        class="fixed bottom-[-10%] right-[15%] w-[500px] h-[400px] bg-sky-500/10 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>

    <div class="relative z-10 flex flex-col min-h-screen bg-black text-white selection:bg-blue-500/30 selection:text-blue-200">
        <!-- SLEEK COMPACT STUDIO TOPBAR (HEADER HIDDEN) -->
        <header class="h-14 sm:h-16 px-4 sm:px-8 border-b border-zinc-800/60 bg-zinc-950/70 backdrop-blur-xl flex items-center justify-between z-20 shrink-0">
            <div class="flex items-center gap-3">
                <a
                    href="/studio"
                    class="px-2.5 py-1.5 rounded-lg bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800/90 hover:border-zinc-700 text-zinc-400 hover:text-white text-xs font-medium transition-all flex items-center gap-2 cursor-pointer group"
                    title="Kembali ke Pilihan Studio"
                >
                    <i class="fa-solid fa-arrow-left text-[11px] group-hover:-translate-x-0.5 transition-transform"></i>
                    <span>Pilih Studio</span>
                </a>
                <div class="h-4 w-[1px] bg-zinc-800"></div>
                <div class="flex items-center gap-2 select-none">
                    <img src="/logo.png" alt="Satusite Logo" class="w-5 h-5 object-contain" />
                    <span class="text-xs font-semibold text-zinc-300 tracking-tight">Studio Frontend UI/UX</span>
                </div>
            </div>

            <!-- Right Status Indicator -->
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-zinc-900 text-zinc-300 border border-zinc-800">
                    FRONTEND AI AGENT
                </span>
            </div>
        </header>

        <!-- HERO SECTION: DEDICATED FRONTEND PROMPT STUDIO -->
        <section
            id="frontend-prompt-studio"
            class="relative flex-1 flex flex-col justify-center py-12 sm:py-16 md:py-20 px-4 sm:px-6 text-center overflow-hidden"
        >
            <!-- 3D GENERATIVE MATTER SPHERE (Behind AI Chat Agent Box) -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] h-[320px] sm:w-[480px] sm:h-[480px] md:w-[720px] md:h-[720px] pointer-events-none z-0 flex items-center justify-center overflow-hidden opacity-60">
                <GenerativeArtScene client:only="react" color="#3b82f6" />
            </div>

            <div class="relative z-10 max-w-4xl mx-auto w-full space-y-4 sm:space-y-6">
                
                <!-- Title with Smooth Blur Fade Up Rotation -->
                <div class="space-y-2 flex items-center justify-center min-h-[44px] sm:min-h-[52px]">
                    <h1
                        id="frontend-animated-title"
                        class="text-xl sm:text-2xl md:text-3xl font-normal tracking-tight text-zinc-100 font-sans leading-tight animate-title-in transition-all"
                    >
                        Studio Frontend UI/UX
                    </h1>
                </div>

                <!-- PROMPT STUDIO BOX (FRONTEND DEDICATED) -->
                <div
                    class="mt-4 sm:mt-6 max-w-3xl mx-auto bg-zinc-900/70 border border-zinc-800/90 rounded-2xl p-4 sm:p-5 text-left shadow-2xl backdrop-blur-xl"
                >
                    <form id="studio-prompt-form" class="space-y-3.5">
                        <div class="relative">
                            <textarea
                                id="studio-prompt-input"
                                rows="3"
                                placeholder="Tuliskan konsep antarmuka atau desain UI/UX..."
                                class="w-full bg-zinc-950 border border-zinc-800 focus:border-blue-500/60 rounded-xl p-3.5 sm:p-4 text-xs sm:text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none transition-all resize-none font-sans"
                            ></textarea>
                        </div>

                        <!-- Prompt controls bar -->
                        <div class="flex items-center justify-between gap-3 pt-1">
                            <!-- Left: File Upload & Mode Indicator -->
                            <div class="flex items-center gap-1.5">
                                <label
                                    for="studio-file-upload"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Upload Referensi Desain"
                                >
                                    <i class="fa-solid fa-paperclip text-xs"></i>
                                    <input
                                        id="studio-file-upload"
                                        type="file"
                                        class="hidden"
                                        accept=".md,.markdown,.txt,.json,.csv,.pdf,.doc,.docx,.html,.yaml,.yml,.sql,image/*"
                                    />
                                </label>
                                <span
                                    id="studio-file-indicator"
                                    class="hidden text-[11px] text-zinc-300 bg-zinc-800 px-2 py-0.5 rounded truncate max-w-[140px]"
                                ></span>

                                <!-- Static Frontend Mode Badge with White Text -->
                                <div class="h-8 px-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-[11px] font-medium text-white flex items-center gap-1.5 shadow-sm">
                                    <i class="fa-solid fa-code text-xs text-zinc-300 shrink-0"></i>
                                    <span class="text-white font-medium">Frontend UI/UX</span>
                                </div>
                            </div>

                            <!-- Right: Voice Icon & Generate Button -->
                            <div class="flex items-center gap-1.5">
                                <!-- Voice Dictation Icon -->
                                <button
                                    type="button"
                                    id="btn-studio-voice"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Input Suara"
                                >
                                    <i
                                        id="icon-studio-voice"
                                        class="fa-solid fa-microphone text-xs"
                                    ></i>
                                </button>

                                <!-- Generate Button -->
                                <button
                                    type="submit"
                                    id="btn-studio-generate"
                                    class="w-8 h-8 rounded-lg bg-white hover:bg-zinc-200 text-zinc-950 flex items-center justify-center transition-all cursor-pointer shadow-md"
                                    title="Generate Frontend"
                                >
                                    <i
                                        id="btn-studio-generate-icon"
                                        class="fa-solid fa-arrow-up text-xs text-zinc-950"
                                    ></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- SUB-HEADER SECTION / FEATURES -->
        <section class="max-w-4xl mx-auto px-4 py-8 sm:py-12 border-t border-zinc-800/60">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
                <div class="p-5 sm:p-6 rounded-2xl bg-[#0c0c0e]/80 border border-zinc-800/80">
                    <div class="w-9 h-9 rounded-xl bg-blue-950/60 border border-blue-800/40 text-blue-400 flex items-center justify-center mb-3">
                        <i class="fa-solid fa-palette text-sm"></i>
                    </div>
                    <h3 class="text-sm font-bold text-white mb-1.5">Sistem Desain & Palet Warna Harmonik</h3>
                    <p class="text-xs text-zinc-400 leading-relaxed">
                        Aturan visual 60-30-10 dengan kontras tinggi, tipografi modern, dan integrasi Vanilla CSS serta Tailwind CSS.
                    </p>
                </div>

                <div class="p-5 sm:p-6 rounded-2xl bg-[#0c0c0e]/80 border border-zinc-800/80">
                    <div class="w-9 h-9 rounded-xl bg-blue-950/60 border border-blue-800/40 text-blue-400 flex items-center justify-center mb-3">
                        <i class="fa-solid fa-mobile-screen text-sm"></i>
                    </div>
                    <h3 class="text-sm font-bold text-white mb-1.5">Responsif & Interaktif Mobile-First</h3>
                    <p class="text-xs text-zinc-400 leading-relaxed">
                        Komponen antarmuka yang adaptif di berbagai ukuran layar dengan animasi mikro halus dan modern.
                    </p>
                </div>
            </div>
        </section>

        <!-- DAFTAR PROYEK FRONTEND YANG SUDAH DI-GENERATE (List2 Style Layout) -->
        <section id="frontend-history-list-section" class="max-w-5xl mx-auto px-4 pb-20 pt-4">
            <div class="space-y-6">
                <!-- Header with Title and Search Filter at the Top -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-zinc-800/80">
                    <div class="flex items-center gap-2.5">
                        <span class="w-8 h-8 rounded-lg bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center text-xs">
                            <i class="fa-solid fa-code"></i>
                        </span>
                        <h2 class="text-xl sm:text-2xl font-semibold text-white tracking-tight">Daftar Proyek Frontend</h2>
                    </div>

                    <!-- Search Filter Input -->
                    <div class="relative w-full sm:w-72">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-xs text-zinc-500"></i>
                        <input
                            type="text"
                            id="search-frontend-history"
                            placeholder="Cari proyek frontend..."
                            class="w-full pl-8 pr-3 py-2 rounded-xl bg-zinc-900/90 border border-zinc-800 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500/50 transition-colors shadow-inner"
                        />
                    </div>
                </div>

                <!-- History Rows Container with Separator layout -->
                <div id="frontend-history-container" class="flex flex-col divide-y divide-zinc-800/80 border-y border-zinc-800/80">
                    <div class="py-12 text-center text-zinc-500 text-xs">
                        <i class="fa-solid fa-circle-notch fa-spin text-sm text-blue-400 mb-2"></i>
                        <p>Memuat daftar proyek frontend...</p>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Client Script -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.getElementById("studio-prompt-form");
            const input = document.getElementById("studio-prompt-input");
            const fileUpload = document.getElementById("studio-file-upload");
            const fileIndicator = document.getElementById("studio-file-indicator");
            const voiceBtn = document.getElementById("btn-studio-voice");
            const voiceIcon = document.getElementById("icon-studio-voice");
            const generateIcon = document.getElementById("btn-studio-generate-icon");

            let attachedFiles = [];
            let isGeneratingPrompt = false;
            let navTimer = null;

            function readFile(file) {
                return new Promise((resolve) => {
                    const isText = file.type.startsWith("text/") || 
                        file.name.endsWith(".md") || 
                        file.name.endsWith(".markdown") || 
                        file.name.endsWith(".txt") || 
                        file.name.endsWith(".json") || 
                        file.name.endsWith(".csv") || 
                        file.name.endsWith(".html") || 
                        file.name.endsWith(".yaml") || 
                        file.name.endsWith(".yml") || 
                        file.name.endsWith(".sql");
                    if (isText) {
                        const reader = new FileReader();
                        reader.onload = (ev) => resolve(ev.target.result || "");
                        reader.onerror = () => resolve("");
                        reader.readAsText(file);
                    } else {
                        resolve(`[Dokumen Terlampir: ${file.name}, Tipe: ${file.type || 'Dokumen'}, Ukuran: ${(file.size / 1024).toFixed(1)} KB]`);
                    }
                });
            }

            async function handleSelectedFile(file) {
                if (!file) return;
                const sizeKb = (file.size / 1024).toFixed(1) + " KB";
                const content = await readFile(file);
                attachedFiles = [{
                    name: file.name,
                    size: sizeKb,
                    type: file.type || "file",
                    content: content
                }];
                if (fileIndicator) {
                    fileIndicator.textContent = file.name;
                    fileIndicator.classList.remove("hidden");
                }
            }

            if (fileUpload) {
                fileUpload.addEventListener("change", async (e) => {
                    const file = e.target.files && e.target.files[0];
                    if (file) {
                        await handleSelectedFile(file);
                    } else {
                        attachedFiles = [];
                        if (fileIndicator) fileIndicator.classList.add("hidden");
                    }
                });
            }

            // Drag and drop support on form
            if (form) {
                form.addEventListener("dragover", (e) => {
                    e.preventDefault();
                    form.classList.add("border-blue-500/50");
                });
                form.addEventListener("dragleave", () => {
                    form.classList.remove("border-blue-500/50");
                });
                form.addEventListener("drop", async (e) => {
                    e.preventDefault();
                    form.classList.remove("border-blue-500/50");
                    const file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
                    if (file) {
                        await handleSelectedFile(file);
                    }
                });
            }

            // Paste support on input
            if (input) {
                input.addEventListener("paste", async (e) => {
                    if (e.clipboardData.files && e.clipboardData.files.length > 0) {
                        e.preventDefault();
                        await handleSelectedFile(e.clipboardData.files[0]);
                    }
                });
            }

            // Voice Speech-to-Text Support
            if (voiceBtn && input) {
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (SpeechRecognition) {
                    const recognition = new SpeechRecognition();
                    recognition.lang = "id-ID";
                    recognition.interimResults = false;

                    recognition.onstart = () => {
                        if (voiceIcon) voiceIcon.className = "fa-solid fa-circle-notch fa-spin text-xs text-blue-400";
                    };
                    recognition.onresult = (event) => {
                        const transcript = event.results[0][0].transcript;
                        input.value = input.value ? `${input.value} ${transcript}` : transcript;
                    };
                    recognition.onend = () => {
                        if (voiceIcon) voiceIcon.className = "fa-solid fa-microphone text-xs";
                    };
                    recognition.onerror = () => {
                        if (voiceIcon) voiceIcon.className = "fa-solid fa-microphone text-xs";
                    };

                    voiceBtn.addEventListener("click", () => {
                        try {
                            recognition.start();
                        } catch (e) {
                            try {
                                recognition.stop();
                            } catch (err) {}
                        }
                    });
                }
            }

            // --- FRONTEND PROJECTS HISTORY FETCHER & RENDERER ---
            const frontendHistoryContainer = document.getElementById("frontend-history-container");
            const searchFrontendInput = document.getElementById("search-frontend-history");
            let allFrontendProjects = [];

            async function loadFrontendHistory() {
                if (!frontendHistoryContainer) return;
                let fetchedProjects = [];
                try {
                    const res = await fetch("/api/projects?mode=frontend");
                    if (res.ok) {
                        const data = await res.json();
                        if (data && Array.isArray(data.projects)) {
                            fetchedProjects = data.projects;
                        }
                    }
                } catch (e) {
                    console.warn("Failed fetching frontend history:", e);
                }

                // Merge fallback from localStorage
                try {
                    const storeRaw = localStorage.getItem("satusite_projects_store") || localStorage.getItem("emergent_projects_store");
                    if (storeRaw) {
                        const parsed = JSON.parse(storeRaw);
                        if (parsed && parsed.projects) {
                            const list = Object.values(parsed.projects).filter((p) => p.mode === "frontend" || (!p.mode && !p.prd));
                            list.forEach(lp => {
                                if (!fetchedProjects.some(fp => fp.id === lp.id)) {
                                    fetchedProjects.unshift({
                                        id: lp.id,
                                        name: lp.name || "Aplikasi Frontend",
                                        category: lp.category || "Frontend SPA",
                                        mode: "frontend",
                                        prompt: lp.prompt || (lp.messages && lp.messages[0]?.text) || "",
                                        code: lp.code || "",
                                        createdAt: lp.createdAt || lp.updatedAt || Date.now()
                                    });
                                }
                            });
                        }
                    }
                } catch (e) {}

                allFrontendProjects = fetchedProjects;
                renderFrontendHistoryList(allFrontendProjects);
            }

            function renderFrontendHistoryList(list) {
                if (!frontendHistoryContainer) return;

                if (!list || list.length === 0) {
                    frontendHistoryContainer.innerHTML = `
                        <div class="py-16 text-center text-zinc-500 text-xs">
                            <i class="fa-solid fa-code text-2xl text-zinc-600 mb-2 block"></i>
                            <p class="font-medium text-zinc-400">Belum ada proyek Frontend yang dibuat</p>
                            <p class="text-[11px] text-zinc-600 mt-1">Tulis deskripsi antarmuka di atas untuk mulai membuat proyek Frontend pertama Anda.</p>
                        </div>
                    `;
                    return;
                }

                frontendHistoryContainer.innerHTML = list.map((item, idx) => {
                    const title = item.name || "Aplikasi Frontend UI";
                    const dateStr = item.createdAt ? new Date(item.createdAt).toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" }) : "Tersimpan";
                    const promptText = item.prompt ? item.prompt.replace(/[*_#`]/g, "").trim() : "Komponen antarmuka web modern Vanilla JS, CSS & Tailwind CSS.";

                    return `
                        <div data-row-front-idx="${idx}" class="grid items-center gap-4 px-3 sm:px-5 py-4 sm:py-5 grid-cols-1 md:grid-cols-4 hover:bg-zinc-900/40 transition-colors group cursor-pointer">
                            <!-- Col 1: Icon/Badge + Title + Meta -->
                            <div class="order-2 md:order-none flex items-center gap-3 min-w-0">
                                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-zinc-900 border border-zinc-800 text-blue-400 shadow-sm group-hover:border-blue-500/30 group-hover:bg-blue-500/10 transition-all">
                                    <i class="fa-solid fa-code text-sm"></i>
                                </span>
                                <div class="flex flex-col gap-0.5 min-w-0">
                                    <h3 class="font-semibold text-white text-xs sm:text-sm truncate group-hover:text-blue-300 transition-colors">${title}</h3>
                                    <p class="text-[11px] text-zinc-500 flex items-center gap-1.5 flex-wrap">
                                        <span class="px-1.5 py-0.2 rounded text-[9px] font-mono font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">Frontend</span>
                                        <span>•</span>
                                        <span>${dateStr}</span>
                                    </p>
                                </div>
                            </div>

                            <!-- Col 2: Description / Prompt (col-span-2) -->
                            <p class="order-1 md:order-none md:col-span-2 text-xs sm:text-sm font-normal text-zinc-300 line-clamp-2 leading-relaxed">
                                ${promptText}
                            </p>

                            <!-- Col 3: Actions -->
                            <div class="order-3 md:order-none flex items-center justify-end gap-1.5 ml-auto shrink-0" onclick="event.stopPropagation()">
                                <a
                                    href="/app?id=${item.id}"
                                    class="px-3 py-1.5 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-200 hover:text-white border border-zinc-700/60 flex items-center gap-1.5 text-xs transition-colors"
                                    title="Buka di Studio Canvas"
                                >
                                    <span>Studio</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                </a>
                                <button
                                    type="button"
                                    data-download-front-idx="${idx}"
                                    class="w-8 h-8 rounded-xl bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 hover:text-white border border-zinc-700/60 flex items-center justify-center transition-colors cursor-pointer"
                                    title="Unduh HTML"
                                >
                                    <i class="fa-solid fa-download text-xs"></i>
                                </button>
                                <button
                                    type="button"
                                    data-delete-front-id="${item.id}"
                                    data-delete-front-title="${title.replace(/"/g, '&quot;')}"
                                    class="w-8 h-8 rounded-xl bg-zinc-800/80 hover:bg-red-500/20 text-zinc-400 hover:text-red-400 border border-zinc-700/60 flex items-center justify-center transition-colors cursor-pointer"
                                    title="Hapus Proyek"
                                >
                                    <i class="fa-solid fa-trash-can text-xs"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }).join("");

                // Row click handler to open studio
                document.querySelectorAll("[data-row-front-idx]").forEach(row => {
                    row.addEventListener("click", () => {
                        const idx = parseInt(row.getAttribute("data-row-front-idx") || "0", 10);
                        const item = allFrontendProjects[idx];
                        if (item && item.id) {
                            window.location.href = `/app?id=${item.id}`;
                        }
                    });
                });

                // Download handler
                document.querySelectorAll("[data-download-front-idx]").forEach(btn => {
                    btn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        const idx = parseInt(btn.getAttribute("data-download-front-idx") || "0", 10);
                        const item = allFrontendProjects[idx];
                        if (!item) return;
                        const code = item.code || `<!DOCTYPE html><html><head><title>${item.name}</title></head><body><h1>${item.name}</h1></body></html>`;
                        const blob = new Blob([code], { type: "text/html;charset=utf-8;" });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement("a");
                        a.href = url;
                        a.download = `${(item.name || "frontend-project").toLowerCase().replace(/[^a-z0-9]/g, "-")}.html`;
                        a.click();
                        URL.revokeObjectURL(url);
                    });
                });

                // Delete handler
                document.querySelectorAll("[data-delete-front-id]").forEach(btn => {
                    btn.addEventListener("click", async (e) => {
                        e.stopPropagation();
                        const id = btn.getAttribute("data-delete-front-id");
                        const title = btn.getAttribute("data-delete-front-title") || "Proyek ini";
                        if (!id) return;
                        if (!confirm(`Hapus proyek "${title}" secara permanen?`)) return;

                        try {
                            await fetch(`/api/projects/${id}`, { method: "DELETE" });
                        } catch (err) {}

                        try {
                            const storeRaw = localStorage.getItem("satusite_projects_store") || localStorage.getItem("emergent_projects_store");
                            if (storeRaw) {
                                const store = JSON.parse(storeRaw);
                                if (store && store.projects && store.projects[id]) {
                                    delete store.projects[id];
                                    localStorage.setItem("satusite_projects_store", JSON.stringify(store));
                                }
                            }
                        } catch (err) {}

                        allFrontendProjects = allFrontendProjects.filter(p => p.id !== id);
                        renderFrontendHistoryList(allFrontendProjects);
                    });
                });
            }

            // Realtime search filter
            if (searchFrontendInput) {
                searchFrontendInput.addEventListener("input", (e) => {
                    const q = (e.target.value || "").toLowerCase().trim();
                    if (!q) {
                        renderFrontendHistoryList(allFrontendProjects);
                        return;
                    }
                    const filtered = allFrontendProjects.filter(p => {
                        const name = (p.name || "").toLowerCase();
                        const prompt = (p.prompt || "").toLowerCase();
                        return name.includes(q) || prompt.includes(q);
                    });
                    renderFrontendHistoryList(filtered);
                });
            }

            loadFrontendHistory();

            // Smooth Blur Fade Up Rotating Titles
            const titles = [
                "Studio Frontend UI/UX",
                "Komponen Visual & Desain Interaktif",
                "Tata Letak Responsif & CSS Modern",
                "Prototipe Antarmuka Web App"
            ];
            let currentTitleIdx = 0;
            const titleEl = document.getElementById("frontend-animated-title");
            if (titleEl) {
                setInterval(() => {
                    titleEl.classList.remove("animate-title-in");
                    titleEl.classList.add("animate-title-out");
                    setTimeout(() => {
                        currentTitleIdx = (currentTitleIdx + 1) % titles.length;
                        titleEl.textContent = titles[currentTitleIdx];
                        titleEl.classList.remove("animate-title-out");
                        titleEl.classList.add("animate-title-in");
                    }, 400);
                }, 3500);
            }

            // Form Submission
            if (form && input) {
                form.addEventListener("submit", (e) => {
                    e.preventDefault();
                    if (isGeneratingPrompt) {
                        if (navTimer) clearTimeout(navTimer);
                        isGeneratingPrompt = false;
                        if (generateIcon) generateIcon.className = "fa-solid fa-arrow-up text-xs";
                        return;
                    }

                    let promptText = input.value.trim();
                    if (!promptText && attachedFiles.length > 0) {
                        promptText = `Bangun antarmuka visual (frontend) website interaktif berdasarkan dokumen lampiran ${attachedFiles[0].name}.`;
                    }
                    if (attachedFiles.length > 0) {
                        promptText = `[Lampiran: ${attachedFiles[0].name}] ` + promptText;
                        try {
                            sessionStorage.setItem("satusite_pending_attached_docs", JSON.stringify(attachedFiles));
                        } catch (err) {
                            console.warn("Storage save error:", err);
                        }
                    }
                    if (!promptText) return;

                    isGeneratingPrompt = true;
                    if (generateIcon) generateIcon.className = "fa-solid fa-square text-[10px] text-white";

                    navTimer = setTimeout(() => {
                        window.location.href = `/app?prompt=${encodeURIComponent(promptText)}&mode=frontend`;
                    }, 400);
                });
            }
        });

        // Background Particles
        (function () {
            const canvas = document.getElementById("particles-canvas");
            if (!canvas) return;
            const ctx = canvas.getContext("2d");
            if (!ctx) return;

            let particles = [];
            const count = 45;

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }

            function init() {
                resize();
                particles = Array.from({ length: count }, () => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.35,
                    vy: (Math.random() - 0.5) * 0.35,
                    size: Math.random() * 1.5 + 0.5,
                    opacity: Math.random() * 0.3 + 0.1,
                }));
            }

            function loop() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                for (let i = 0; i < particles.length; i++) {
                    const p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = canvas.width;
                    if (p.x > canvas.width) p.x = 0;
                    if (p.y < 0) p.y = canvas.height;
                    if (p.y > canvas.height) p.y = 0;

                    ctx.fillStyle = `rgba(59, 130, 246, ${p.opacity * 0.35})`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                }

                requestAnimationFrame(loop);
            }

            window.addEventListener("resize", resize);
            document.addEventListener("DOMContentLoaded", () => {
                init();
                loop();
            });
        })();
    </script>

    <style>
        @keyframes titleFadeInUp {
            0% {
                opacity: 0;
                transform: translateY(12px);
                filter: blur(6px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0);
            }
        }
        @keyframes titleFadeOutUp {
            0% {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0);
            }
            100% {
                opacity: 0;
                transform: translateY(-12px);
                filter: blur(6px);
            }
        }
        .animate-title-in {
            animation: titleFadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .animate-title-out {
            animation: titleFadeOutUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</Layout>
