---
import Layout from "../layouts/Layout.astro";
import ElasticGallery from "../components/ui/elastic-gallery";
import ScrollAdventure from "../components/ui/scroll-adventure";
import SectionHeader from "../components/ui/section-header";
import ServicesGrid from "../components/ui/services-grid";
import HowItWorksCards from "../components/ui/how-it-works-cards";
import ForWhoCards from "../components/ui/for-who-cards";
import Footer from "../components/Footer.astro";
import HeaderNav from "../components/HeaderNav.astro";
import FAQ from "../components/ui/faq-section";
import PricingSection from "../components/ui/pricing-section";
import GenerativeArtScene from "../components/ui/GenerativeArtScene";
---

<Layout title="Satusite Studio - Platform Pembuat Website AI Otonom">
    <!-- Fluid Ambient Canvas Particles Background -->
    <div
        id="particles-bg"
        class="fixed top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none"
    >
        <canvas
            id="particles-canvas"
            class="absolute inset-0 w-full h-full opacity-20"></canvas>
    </div>

    <!-- Subtle Ambient Dark Blue Gradients -->
    <div
        class="fixed top-[-10%] left-[20%] w-[500px] h-[400px] bg-blue-600/5 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>
    <div
        class="fixed bottom-[-10%] right-[15%] w-[500px] h-[400px] bg-blue-500/5 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
        <!-- ========================================== -->
        <!-- 1. SEAMLESS TOP NAVBAR                     -->
        <!-- ========================================== -->
        <HeaderNav activePage="home" />

        <!-- ========================================== -->
        <!-- 2. HERO SECTION: PROMPT BUILDER            -->
        <!-- ========================================== -->
        <section
            id="prompt-builder"
            class="relative min-h-[72vh] md:min-h-[78vh] flex flex-col justify-center pt-28 pb-32 md:pt-40 md:pb-44 px-6 text-center overflow-hidden"
        >
            <GenerativeArtScene client:only="react" />

            <div class="relative z-10 max-w-4xl mx-auto w-full space-y-6 sm:space-y-7">
                <!-- Alternating 1-Line Semi-Bold Information Banner (Fade in/out Up) -->
                <div
                    class="relative h-9 sm:h-10 flex items-center justify-center overflow-hidden"
                >
                    <div
                        id="hero-ticker-container"
                        class="w-full flex items-center justify-center"
                    >
                        <h1
                            id="hero-ticker-text"
                            class="hero-slide text-sm sm:text-base md:text-lg font-medium tracking-tight text-zinc-300 transition-all duration-500 ease-out truncate px-2"
                        >
                            Bangun Aplikasi & Website Lengkap With AI Agent
                        </h1>
                    </div>
                </div>

                <!-- PROMPT STUDIO BOX (Positioned Lower) -->
                <div
                    class="mt-4 sm:mt-6 max-w-3xl mx-auto bg-zinc-900/70 border border-zinc-800/90 rounded-2xl p-4 sm:p-5 text-left shadow-2xl backdrop-blur-xl"
                >
                    <form id="hero-prompt-form" class="space-y-3.5">
                        <div class="relative">
                            <textarea
                                id="hero-prompt-input"
                                rows="3"
                                placeholder="Tuliskan website yang ingin Anda buat... (Contoh: 'Buatkan landing page toko kopi lokal dengan menu lengkap, tombol pesan WhatsApp langsung, galeri foto, dan peta lokasi')"
                                class="w-full bg-zinc-950 border border-zinc-800 focus:border-zinc-700 rounded-xl p-3.5 sm:p-4 text-xs sm:text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none transition-all resize-none font-sans"
                            ></textarea>
                        </div>

                        <!-- Prompt controls bar -->
                        <div
                            class="flex items-center justify-between gap-3 pt-1"
                        >
                            <!-- Left: File Upload & Dark Mode Dropdown -->
                            <div class="flex items-center gap-1.5">
                                <label
                                    for="hero-file-upload"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Upload Dokumen / Gambar"
                                >
                                    <i class="fa-solid fa-paperclip text-xs"
                                    ></i>
                                    <input
                                        id="hero-file-upload"
                                        type="file"
                                        class="hidden"
                                        accept="image/*,.txt,.pdf,.json"
                                    />
                                </label>
                                <span
                                    id="hero-file-indicator"
                                    class="hidden text-[11px] text-zinc-300 bg-zinc-800 px-2 py-0.5 rounded truncate max-w-[140px]"
                                ></span>

                                <!-- Dark Minimalist Mode Dropdown (Fullstack / Frontend) -->
                                <div
                                    class="relative"
                                    id="hero-mode-dropdown-container"
                                >
                                    <button
                                        type="button"
                                        id="hero-btn-mode-dropdown"
                                        class="h-8 px-2.5 rounded-lg bg-zinc-950/80 hover:bg-zinc-800 border border-zinc-800 text-[11px] font-medium text-zinc-300 hover:text-white flex items-center gap-1.5 transition-all cursor-pointer shadow-sm"
                                        title="Pilih Mode Pengembangan"
                                    >
                                        <i
                                            id="hero-mode-icon"
                                            class="fa-solid fa-database text-xs text-blue-400 shrink-0"
                                        ></i>
                                        <span
                                            id="hero-mode-label"
                                            class="capitalize">Fullstack</span
                                        >
                                        <i
                                            id="hero-mode-chevron"
                                            class="fa-solid fa-chevron-down text-[9px] text-zinc-500 transition-transform duration-200"
                                        ></i>
                                    </button>

                                    <!-- Dropdown Popover Menu -->
                                    <div
                                        id="hero-mode-menu"
                                        class="hidden absolute top-full left-0 mt-1.5 w-56 p-1 bg-[#121215] border border-zinc-800 rounded-xl shadow-[0_8px_30px_rgba(0,0,0,0.85)] z-50 font-sans text-left"
                                    >
                                        <div
                                            class="px-2 py-0.5 text-[8.5px] font-medium text-zinc-500 uppercase tracking-wider border-b border-zinc-800/50 mb-0.5"
                                        >
                                            Pilih Mode
                                        </div>

                                        <!-- Option Fullstack -->
                                        <button
                                            type="button"
                                            data-mode="fullstack"
                                            class="hero-mode-item w-full px-2 py-1 rounded-lg flex items-center gap-2 text-left transition-colors cursor-pointer bg-zinc-800/90 text-white"
                                        >
                                            <div
                                                class="w-5 h-5 rounded bg-blue-950/70 border border-blue-800/30 text-blue-400 flex items-center justify-center shrink-0"
                                            >
                                                <i
                                                    class="fa-solid fa-database text-[10px]"
                                                ></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div
                                                    class="text-[11px] font-semibold text-zinc-100 leading-tight"
                                                    >Fullstack</div
                                                >
                                                <div
                                                    class="text-[9px] text-zinc-400 truncate leading-tight"
                                                >
                                                    CRUD, storage sync & UI.
                                                </div>
                                            </div>
                                        </button>

                                        <!-- Option Frontend -->
                                        <button
                                            type="button"
                                            data-mode="frontend"
                                            class="hero-mode-item w-full px-2 py-1 rounded-lg flex items-center gap-2 text-left transition-colors cursor-pointer mt-0.5 text-zinc-400 hover:bg-zinc-800/40 hover:text-zinc-200"
                                        >
                                            <div
                                                class="w-5 h-5 rounded bg-blue-950/70 border border-blue-800/30 text-blue-400 flex items-center justify-center shrink-0"
                                            >
                                                <i
                                                    class="fa-solid fa-table-columns text-[10px]"
                                                ></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div
                                                    class="text-[11px] font-semibold text-zinc-100 leading-tight"
                                                    >Frontend</div
                                                >
                                                <div
                                                    class="text-[9px] text-zinc-400 truncate leading-tight"
                                                >
                                                    Antarmuka visual responsif.
                                                </div>
                                            </div>
                                        </button>

                                        <!-- Option PRD -->
                                        <button
                                            type="button"
                                            data-mode="prd"
                                            class="hero-mode-item w-full px-2 py-1 rounded-lg flex items-center gap-2 text-left transition-colors cursor-pointer mt-0.5 text-zinc-400 hover:bg-zinc-800/40 hover:text-zinc-200"
                                        >
                                            <div
                                                class="w-5 h-5 rounded bg-zinc-800/80 border border-zinc-700/60 text-zinc-400 flex items-center justify-center shrink-0"
                                            >
                                                <i
                                                    class="fa-solid fa-file-lines text-[10px] text-zinc-400"
                                                ></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div
                                                    class="text-[11px] font-semibold text-zinc-100 leading-tight"
                                                    >PRD Blueprint</div
                                                >
                                                <div
                                                    class="text-[9px] text-zinc-400 truncate leading-tight"
                                                >
                                                    Spesifikasi sistem komprehensif.
                                                </div>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Voice Icon & Generate Arrow-Up / Stop Button (Borderless) -->
                            <div class="flex items-center gap-1.5">
                                <!-- Voice Dictation Icon -->
                                <button
                                    type="button"
                                    id="btn-hero-voice"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Input Suara"
                                >
                                    <i
                                        id="icon-voice"
                                        class="fa-solid fa-microphone text-xs"
                                    ></i>
                                </button>

                                <!-- Generate Arrow-Up / Stop Icon Button (Single Dynamic Icon, Borderless) -->
                                <button
                                     type="submit"
                                     id="btn-hero-generate"
                                     class="w-8 h-8 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-white transition-colors flex items-center justify-center cursor-pointer group shadow-sm border-0 outline-none"
                                     title="Generate Website"
                                >
                                     <i
                                         id="btn-hero-generate-icon"
                                         class="fa-solid fa-arrow-up text-xs text-zinc-300 group-hover:text-white group-hover:-translate-y-0.5 transition-transform"
                                     ></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 2.5 SERVICES / LAYANAN SECTION             -->
        <!-- ========================================== -->
        <section
            id="services"
            class="py-20 px-6 border-t border-zinc-800/80 bg-zinc-950/60 relative overflow-hidden"
        >
            <div class="max-w-7xl mx-auto relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
                    <!-- Left Column: Animated Section Header (Sticky on Desktop) -->
                    <div class="lg:col-span-4 lg:sticky lg:top-24">
                        <SectionHeader
                            client:visible
                            title="Solusi Pembuatan Web & Aplikasi Cerdas"
                            description="Dari perancangan konsep visual, penyusunan arsitektur sistem, hingga rilis produksi global ke cloud dalam hitungan detik."
                            ctaText="Buka Studio AI"
                            ctaHref="/app"
                            align="left"
                            direction="left"
                        />
                    </div>

                    <!-- Right Column: Animated Services Grid -->
                    <div class="lg:col-span-8">
                        <ServicesGrid client:visible />
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 3. HOW IT WORKS (3 LANGKAH MUDAH)          -->
        <!-- ========================================== -->
        <section
            id="how-it-works"
            class="py-20 px-6 border-t border-zinc-800/80 bg-zinc-950/40"
        >
            <div class="max-w-7xl mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
                    <!-- Left Column: Animated Content Cards (order-2 on mobile, order-1 on desktop) -->
                    <div class="lg:col-span-8 order-2 lg:order-1">
                        <HowItWorksCards client:visible />
                    </div>

                    <!-- Right Column: Animated Section Header (order-1 on mobile, order-2 on desktop) -->
                    <div class="lg:col-span-4 lg:sticky lg:top-24 order-1 lg:order-2">
                        <SectionHeader
                            client:visible
                            title="Cara Kerja dalam 3 Langkah"
                            description="Dari sekadar ide di kepala hingga menjadi website fungsional yang siap digunakan dan diunduh mandiri."
                            align="left"
                            direction="right"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 4. FOR WHO: PEMULA VS DEVELOPER MATRIX     -->
        <!-- ========================================== -->
        <section id="for-who" class="py-20 px-6 border-t border-zinc-800/80">
            <div class="max-w-7xl mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
                    <!-- Left Column: Animated Section Header (Sticky on Desktop) -->
                    <div class="lg:col-span-4 lg:sticky lg:top-24">
                        <SectionHeader
                            client:visible
                            title="Didesain untuk Pemula & Developer"
                            description="Solusi tanpa hambatan untuk non-teknis, sekaligus kanvas fleksibel berkecepatan tinggi bagi programmer profesional."
                            align="left"
                            direction="left"
                        />
                    </div>

                    <!-- Right Column: Animated Comparison Cards -->
                    <div class="lg:col-span-8">
                        <ForWhoCards client:visible />
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 5. SHOWCASE GALLERY                        -->
        <!-- ========================================== -->
        <section
            id="showcase"
            class="py-16 px-6 border-t border-zinc-800/80 bg-zinc-950/40"
        >
            <div class="max-w-7xl mx-auto">
                <ElasticGallery client:visible />
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 5.2 JOURNEY: SPLIT SCROLL SECTION SHOWCASE -->
        <!-- ========================================== -->
        <section
            id="journey"
            class="py-20 px-6 border-t border-zinc-800/80 bg-zinc-950/50 relative overflow-hidden"
        >
            <div class="max-w-7xl mx-auto space-y-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-end">
                    <div class="lg:col-span-6 space-y-3 text-left">
                        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight font-sans">
                            Alur Lengkap dari Konsep ke Rilis Produksi
                        </h2>
                    </div>
                    <div class="lg:col-span-6 text-left lg:text-right">
                        <p class="text-xs sm:text-sm text-zinc-400 max-w-xl ml-auto leading-relaxed">
                            Jelajahi setiap fase transformasi pembuatan aplikasi web dengan animasi split-curtain interaktif. Gunakan scroll mouse atau tombol navigasi.
                        </p>
                    </div>
                </div>

                <ScrollAdventure client:visible />
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 5.5 PRICING / PAKET BERLANGGANAN SECTION   -->
        <!-- ========================================== -->
        <section
            id="pricing"
            class="py-20 px-6 border-t border-zinc-800/80 bg-zinc-950/60 relative overflow-hidden"
        >
            <PricingSection client:visible />
        </section>

        <!-- ========================================== -->
        <!-- 6. FAQ SECTION                             -->
        <!-- ========================================== -->
        <FAQ client:visible />

        <!-- ========================================== -->
        <!-- 6.5 CTA: HIGH-IMPACT LAUNCH BANNER         -->
        <!-- ========================================== -->
        <section class="py-20 px-6 relative overflow-hidden">
            <div class="max-w-5xl mx-auto rounded-3xl bg-zinc-950 border border-zinc-800 p-8 sm:p-12 lg:p-16 text-center space-y-8 relative shadow-2xl">
                
                <div class="space-y-4 max-w-2xl mx-auto relative z-10">
                    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight">
                        Siap Mewujudkan Website Impian Anda?
                    </h2>
                    <p class="text-xs sm:text-sm md:text-base text-zinc-400 leading-relaxed">
                        Cukup ketik ide yang ingin Anda buat. AI Agent kami akan langsung merancang kode HTML/CSS/JS mandiri siap pakai dalam hitungan detik.
                    </p>
                </div>

                <!-- CTA Action Buttons -->
                <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 relative z-10">
                    <a
                        href="/app"
                        class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-white hover:bg-zinc-200 text-zinc-950 font-bold text-sm transition-all flex items-center justify-center gap-2 shadow-lg cursor-pointer"
                    >
                        <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
                        <span>Mulai Buat Gratis Sekarang</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                    <a
                        href="/templates"
                        class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 hover:text-white font-semibold text-sm transition-colors flex items-center justify-center gap-2 cursor-pointer"
                    >
                        <i class="fa-regular fa-clone text-xs text-zinc-400"></i>
                        <span>Jelajahi Galeri Template</span>
                    </a>
                </div>

                <!-- Trust Points -->
                <div class="pt-4 border-t border-zinc-800/80 flex flex-wrap items-center justify-center gap-6 text-xs text-zinc-400 relative z-10">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-check text-zinc-300 text-xs"></i>
                        <span>100% Gratis untuk Memulai</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-check text-zinc-300 text-xs"></i>
                        <span>Tanpa Perlu Setup Lingkungan</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-check text-zinc-300 text-xs"></i>
                        <span>Hak Cipta Kode Milik Anda</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 6.6 CTA: NEWSLETTER SUBSCRIBE SECTION      -->
        <!-- ========================================== -->
        <section class="py-14 px-6 border-t border-zinc-800/80 bg-zinc-950/40">
            <div class="max-w-4xl mx-auto rounded-2xl bg-zinc-900/50 border border-zinc-800/90 p-6 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
                
                <div class="space-y-2 text-left max-w-md">
                    <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                        Dapatkan Template Baru & Tips AI
                    </h3>
                    <p class="text-xs text-zinc-400 leading-relaxed">
                        Bergabunglah dengan 5,000+ developer & pelaku usaha. Dapatkan koleksi template HTML5 siap pakai eksklusif setiap minggu.
                    </p>
                </div>

                <div class="w-full md:w-auto flex-1 max-w-md">
                    <form id="subscribe-form" class="space-y-2">
                        <div class="flex flex-col sm:flex-row items-center gap-2">
                            <input
                                type="email"
                                id="subscribe-email-input"
                                required
                                placeholder="Masukkan alamat email Anda..."
                                class="w-full bg-zinc-950 border border-zinc-800 focus:border-blue-500 rounded-xl px-4 py-3 text-xs text-white placeholder-zinc-500 focus:outline-none transition-colors font-sans"
                            />
                            <button
                                type="submit"
                                id="btn-subscribe"
                                class="w-full sm:w-auto px-5 py-3 rounded-xl bg-white hover:bg-zinc-200 text-zinc-950 font-bold text-xs transition-colors shrink-0 cursor-pointer shadow-md"
                            >
                                <span>Berlangganan</span>
                            </button>
                        </div>
                        <p id="subscribe-status" class="text-[11px] text-zinc-500 text-left">
                            Bebas spam. Anda dapat berhenti berlangganan kapan saja.
                        </p>
                    </form>
                </div>

            </div>
        </section>

        <!-- ========================================== -->
        <!-- 7. MY PROJECTS MODAL                       -->
        <!-- ========================================== -->
        <div
            id="projects-modal"
            class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4"
        >
            <div
                class="bg-zinc-900 border border-zinc-800 rounded-2xl max-w-md w-full p-6 shadow-2xl animate-fade-in-up space-y-4"
            >
                <div
                    class="flex justify-between items-center pb-3 border-b border-zinc-800"
                >
                    <h3
                        class="font-bold text-white text-sm flex items-center gap-2"
                    >
                        <i class="fa-regular fa-folder text-blue-400"></i> Aplikasi
                        Tersimpan
                    </h3>
                    <button
                        id="btn-close-projects-modal"
                        class="text-zinc-400 hover:text-white cursor-pointer"
                    >
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>

                <div
                    id="projects-list-container"
                    class="max-h-72 overflow-y-auto space-y-2 pr-1"
                >
                    <!-- Injected via JS -->
                </div>

                <div
                    class="flex justify-between items-center pt-3 border-t border-zinc-800"
                >
                    <a
                        href="/app"
                        class="px-3.5 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-white font-bold text-xs flex items-center gap-1.5 border border-zinc-700"
                    >
                        <i class="fa-solid fa-plus text-xs"></i> Buat Baru
                    </a>
                    <button
                        id="btn-close-projects"
                        class="px-3.5 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-xs font-semibold text-zinc-200 border border-zinc-700 cursor-pointer"
                    >
                        Tutup
                    </button>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- 8. MODERN ANIMATED FOOTER                  -->
        <!-- ========================================== -->
        <Footer />
    </div>

    <!-- Client Scripts -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            // Alternating 1-Line Semi-Bold Information Banner (Smooth Blur & Fade in/out Up)
            const tickerText = document.getElementById("hero-ticker-text");
            const phrases = [
                "Bangun Aplikasi & Website Lengkap With AI Agent",
                "Ketik Ide Bisnis Anda & Dapatkan Pratinjau Instan",
                "Rancang Antarmuka Responsif & Kode Bersih Otomatis",
                "Ekspor File HTML Mandiri Siap Digunakan Kapan Saja",
            ];
            let phraseIdx = 0;

            if (tickerText) {
                tickerText.style.filter = "blur(0px)";
                tickerText.style.opacity = "1";
                tickerText.style.transform = "translateY(0px)";

                setInterval(() => {
                    // 1. Smooth Fade out UP with BLUR
                    tickerText.style.filter = "blur(8px)";
                    tickerText.style.opacity = "0";
                    tickerText.style.transform = "translateY(-16px)";

                    // 2. Prepare next phrase from bottom
                    setTimeout(() => {
                        phraseIdx = (phraseIdx + 1) % phrases.length;
                        tickerText.textContent = phrases[phraseIdx];

                        // Reset position at bottom with blur and zero opacity without animation
                        tickerText.style.transition = "none";
                        tickerText.style.transform = "translateY(16px)";
                        tickerText.style.filter = "blur(8px)";
                        tickerText.style.opacity = "0";

                        // Force reflow
                        void tickerText.offsetWidth;

                        // Re-enable transition
                        tickerText.style.transition = "";

                        // 3. Smoothly animate into sharp focus at center
                        requestAnimationFrame(() => {
                            tickerText.style.filter = "blur(0px)";
                            tickerText.style.opacity = "1";
                            tickerText.style.transform = "translateY(0px)";
                        });
                    }, 850);
                }, 5200);
            }

            // File Upload Indicator
            const fileInput = document.getElementById("hero-file-upload");
            const fileIndicator = document.getElementById(
                "hero-file-indicator",
            );
            let attachedFileName = null;

            if (fileInput && fileIndicator) {
                fileInput.addEventListener("change", (e) => {
                    const file = e.target.files?.[0];
                    if (file) {
                        attachedFileName = file.name;
                        fileIndicator.textContent = file.name;
                        fileIndicator.classList.remove("hidden");
                    } else {
                        attachedFileName = null;
                        fileIndicator.classList.add("hidden");
                    }
                });
            }

            // Voice Dictation (Speech Recognition)
            const voiceBtn = document.getElementById("btn-hero-voice");
            const voiceIcon = document.getElementById("icon-voice");
            let recognition = null;
            let isListening = false;

            if (voiceBtn && voiceIcon) {
                const SpeechRecognition =
                    window.SpeechRecognition || window.webkitSpeechRecognition;
                if (SpeechRecognition) {
                    recognition = new SpeechRecognition();
                    recognition.lang = "id-ID";
                    recognition.interimResults = false;

                    recognition.onstart = () => {
                        isListening = true;
                        voiceBtn.classList.add(
                            "bg-red-500/10",
                            "border-red-500/40",
                        );
                        voiceIcon.classList.add(
                            "text-red-400",
                            "animate-pulse",
                        );
                    };

                    recognition.onresult = (event) => {
                        const transcript = event.results[0][0].transcript;
                        if (input) {
                            input.value =
                                (input.value ? input.value + " " : "") +
                                transcript;
                            input.focus();
                        }
                    };

                    recognition.onerror = () => {
                        isListening = false;
                        voiceBtn.classList.remove(
                            "bg-red-500/10",
                            "border-red-500/40",
                        );
                        voiceIcon.classList.remove(
                            "text-red-400",
                            "animate-pulse",
                        );
                    };

                    recognition.onend = () => {
                        isListening = false;
                        voiceBtn.classList.remove(
                            "bg-red-500/10",
                            "border-red-500/40",
                        );
                        voiceIcon.classList.remove(
                            "text-red-400",
                            "animate-pulse",
                        );
                    };

                    voiceBtn.addEventListener("click", () => {
                        if (!isListening) {
                            try {
                                recognition.start();
                            } catch (err) {
                                console.warn(err);
                            }
                        } else {
                            recognition.stop();
                        }
                    });
                } else {
                    voiceBtn.addEventListener("click", () => {
                        if (input) {
                            input.focus();
                            input.setAttribute(
                                "placeholder",
                                "Mikrofon tidak didukung di browser ini. Silakan ketik langsung ide Anda...",
                            );
                        }
                    });
                }
            }

            // Mode Dropdown Switcher (Fullstack vs Frontend)
            const modeDropdownBtn = document.getElementById(
                "hero-btn-mode-dropdown",
            );
            const modeMenu = document.getElementById("hero-mode-menu");
            const modeChevron = document.getElementById("hero-mode-chevron");
            const modeLabel = document.getElementById("hero-mode-label");
            const modeIcon = document.getElementById("hero-mode-icon");
            const modeItems = document.querySelectorAll(".hero-mode-item");
            let selectedMode = "fullstack";

            if (modeDropdownBtn && modeMenu) {
                modeDropdownBtn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const isOpen = !modeMenu.classList.contains("hidden");
                    if (isOpen) {
                        modeMenu.classList.add("hidden");
                        if (modeChevron)
                            modeChevron.classList.remove("rotate-180");
                    } else {
                        modeMenu.classList.remove("hidden");
                        if (modeChevron)
                            modeChevron.classList.add("rotate-180");
                    }
                });

                document.addEventListener("click", (e) => {
                    const container = document.getElementById(
                        "hero-mode-dropdown-container",
                    );
                    if (container && !container.contains(e.target)) {
                        modeMenu.classList.add("hidden");
                        if (modeChevron)
                            modeChevron.classList.remove("rotate-180");
                    }
                });

                modeItems.forEach((item) => {
                    item.addEventListener("click", () => {
                        const mode = item.getAttribute("data-mode");
                        if (!mode) return;
                        selectedMode = mode;

                        // Update label and icon
                        if (mode === "fullstack") {
                            if (modeLabel) modeLabel.textContent = "Fullstack";
                            if (modeIcon)
                                modeIcon.className =
                                    "fa-solid fa-database text-xs text-blue-400 shrink-0";
                            if (input)
                                input.setAttribute(
                                    "placeholder",
                                    "Tuliskan ide aplikasi fullstack... (Contoh: 'Buat aplikasi kasir toko kopi dengan pencarian produk, ringkasan transaksi & ekspor CSV')",
                                );
                        } else if (mode === "prd") {
                            if (modeLabel) modeLabel.textContent = "PRD";
                            if (modeIcon)
                                modeIcon.className =
                                    "fa-solid fa-file-lines text-xs text-zinc-400 shrink-0";
                            if (input)
                                input.setAttribute(
                                    "placeholder",
                                    "Tuliskan konsep atau fitur aplikasi yang ingin dibuatkan dokumen PRD & Blueprint arsitektur...",
                                );
                        } else {
                            if (modeLabel) modeLabel.textContent = "Frontend";
                            if (modeIcon)
                                modeIcon.className =
                                    "fa-solid fa-table-columns text-xs text-blue-400 shrink-0";
                            if (input)
                                input.setAttribute(
                                    "placeholder",
                                    "Tuliskan ide desain frontend... (Contoh: 'Buat landing page kafe modern dengan daftar menu, galeri foto & form kontak')",
                                );
                        }

                        // Update active styles
                        modeItems.forEach((btn) => {
                            const isSelected =
                                btn.getAttribute("data-mode") === mode;
                            if (isSelected) {
                                btn.classList.add(
                                    "bg-zinc-800/90",
                                    "text-white",
                                );
                                btn.classList.remove(
                                    "text-zinc-400",
                                    "hover:bg-zinc-800/40",
                                    "hover:text-zinc-200",
                                );
                            } else {
                                btn.classList.remove(
                                    "bg-zinc-800/90",
                                    "text-white",
                                );
                                btn.classList.add(
                                    "text-zinc-400",
                                    "hover:bg-zinc-800/40",
                                    "hover:text-zinc-200",
                                );
                            }
                        });

                        modeMenu.classList.add("hidden");
                        if (modeChevron)
                            modeChevron.classList.remove("rotate-180");
                    });
                });
            }

            // Form Submit with Arrow-Up to Stop Icon Dynamic Transition
            const form = document.getElementById("hero-prompt-form");
            const input = document.getElementById("hero-prompt-input");
            const generateIcon = document.getElementById(
                "btn-hero-generate-icon",
            );
            let isGeneratingPrompt = false;
            let navTimer = null;

            function setGenerateBtnState(generating) {
                isGeneratingPrompt = generating;
                if (!generateIcon) return;
                if (generating) {
                    generateIcon.className =
                        "fa-solid fa-square text-[10px] text-zinc-300";
                } else {
                    generateIcon.className =
                        "fa-solid fa-arrow-up text-xs group-hover:-translate-y-0.5 transition-transform";
                }
            }

            if (form && input) {
                form.addEventListener("submit", (e) => {
                    e.preventDefault();
                    if (isGeneratingPrompt) {
                        // Stop clicked -> cancel
                        if (navTimer) clearTimeout(navTimer);
                        setGenerateBtnState(false);
                        return;
                    }

                    let promptText = input.value.trim();
                    if (attachedFileName) {
                        promptText =
                            `[Lampiran: ${attachedFileName}] ` + promptText;
                    }
                    if (!promptText) return;

                    setGenerateBtnState(true);

                    navTimer = setTimeout(() => {
                        window.location.href = `/app?prompt=${encodeURIComponent(promptText)}&mode=${encodeURIComponent(selectedMode)}`;
                    }, 500);
                });
            }

            document.querySelectorAll(".clone-showcase-btn").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const prompt = btn.getAttribute("data-prompt");
                    if (prompt) {
                        window.location.href = `/app?prompt=${encodeURIComponent(prompt)}&mode=frontend`;
                    }
                });
            });

            const modal = document.getElementById("projects-modal");
            const btnOpen = document.getElementById("btn-open-projects");
            const btnClose1 = document.getElementById(
                "btn-close-projects-modal",
            );
            const btnClose2 = document.getElementById("btn-close-projects");
            const listContainer = document.getElementById(
                "projects-list-container",
            );

            function renderProjectsList() {
                if (!listContainer) return;
                try {
                    const storeRaw =
                        localStorage.getItem("satusite_projects_store") ||
                        localStorage.getItem("emergent_projects_store") ||
                        localStorage.getItem("webDevProjectsStore");
                    const store = storeRaw
                        ? JSON.parse(storeRaw)
                        : { projects: {} };
                    const projects = store.projects || {};
                    const ids = Object.keys(projects).sort(
                        (a, b) =>
                            (projects[b].updatedAt || 0) -
                            (projects[a].updatedAt || 0),
                    );

                    if (ids.length === 0) {
                        listContainer.innerHTML = `
                            <div class="text-center py-6 text-zinc-500 text-xs">
                                Belum ada aplikasi yang tersimpan. Mulai buat aplikasi pertama Anda di studio!
                            </div>
                        `;
                        return;
                    }

                    listContainer.innerHTML = ids
                        .map((id) => {
                            const p = projects[id];
                            const dateStr = new Date(
                                p.updatedAt || p.createdAt || Date.now(),
                            ).toLocaleDateString("id-ID", {
                                day: "numeric",
                                month: "short",
                                year: "numeric",
                            });
                            return `
                            <div class="flex items-center justify-between p-3 rounded-lg bg-zinc-950 hover:bg-zinc-800/80 border border-zinc-800 transition-all group">
                                <div class="flex-1 min-w-0 pr-3 cursor-pointer" onclick="window.location.href='/app?id=${id}'">
                                    <h4 class="font-bold text-white text-xs truncate group-hover:text-blue-400 transition-colors">${escapeHtml(p.name || "Aplikasi Tanpa Judul")}</h4>
                                    <p class="text-[11px] text-zinc-500">${dateStr}</p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <a href="/app?id=${id}" class="px-2.5 py-1 rounded bg-zinc-800 hover:bg-zinc-700 font-bold text-[11px] text-zinc-200 transition-colors border border-zinc-700">
                                        Buka
                                    </a>
                                    <button type="button" onclick="deleteSavedProject('${id}')" class="p-1 rounded hover:bg-red-500/10 text-zinc-500 hover:text-red-400 transition-colors">
                                        <i class="fa-solid fa-trash text-xs"></i>
                                    </button>
                                </div>
                            </div>
                        `;
                        })
                        .join("");
                } catch (e) {
                    console.warn("Error rendering projects:", e);
                }
            }

            window.deleteSavedProject = function (id) {
                try {
                    const storeRaw =
                        localStorage.getItem("satusite_projects_store") ||
                        localStorage.getItem("emergent_projects_store");
                    if (storeRaw) {
                        const store = JSON.parse(storeRaw);
                        delete store.projects[id];
                        localStorage.setItem(
                            "satusite_projects_store",
                            JSON.stringify(store),
                        );
                    }
                    renderProjectsList();
                } catch (e) {
                    console.warn("Error deleting project:", e);
                }
            };

            function escapeHtml(str) {
                const div = document.createElement("div");
                div.textContent = str;
                return div.innerHTML;
            }

            if (btnOpen && modal) {
                btnOpen.addEventListener("click", () => {
                    renderProjectsList();
                    modal.classList.remove("hidden");
                    modal.classList.add("flex");
                });
            }

            if (btnClose1 && modal)
                btnClose1.addEventListener("click", () => {
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                });
            if (btnClose2 && modal)
                btnClose2.addEventListener("click", () => {
                    modal.classList.add("hidden");
                    modal.classList.remove("flex");
                });

            // Mobile menu toggle logic
            const mobileMenuBtn = document.getElementById("btn-mobile-menu-toggle");
            const mobileNavDrawer = document.getElementById("mobile-nav-drawer");
            const mobileMenuIcon = document.getElementById("icon-mobile-menu");

            if (mobileMenuBtn && mobileNavDrawer) {
                mobileMenuBtn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const isClosed = mobileNavDrawer.classList.contains("hidden");
                    if (isClosed) {
                        mobileNavDrawer.classList.remove("hidden");
                        if (mobileMenuIcon) mobileMenuIcon.className = "fa-solid fa-xmark text-sm";
                    } else {
                        mobileNavDrawer.classList.add("hidden");
                        if (mobileMenuIcon) mobileMenuIcon.className = "fa-solid fa-bars text-sm";
                    }
                });

                mobileNavDrawer.querySelectorAll("a").forEach((link) => {
                    link.addEventListener("click", () => {
                        mobileNavDrawer.classList.add("hidden");
                        if (mobileMenuIcon) mobileMenuIcon.className = "fa-solid fa-bars text-sm";
                    });
                });
            }

                // Newsletter Subscribe Form Handling
                const subForm = document.getElementById("subscribe-form");
                const subEmail = document.getElementById("subscribe-email-input");
                const subStatus = document.getElementById("subscribe-status");
                const subBtn = document.getElementById("btn-subscribe");

                if (subForm && subEmail && subStatus && subBtn) {
                    subForm.addEventListener("submit", async (e) => {
                        e.preventDefault();
                        const emailVal = subEmail.value.trim();
                        if (!emailVal) return;

                        subBtn.disabled = true;
                        subBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-xs"></i> <span>Mendaftar...</span>';

                        let successMsg = 'Terima kasih! Anda telah terdaftar untuk menerima update eksklusif mingguan.';
                        try {
                            const res = await fetch('/api/subscribe', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ email: emailVal, source: 'landing_cta' })
                            });
                            if (res.ok) {
                                const data = await res.json();
                                if (data.message) successMsg = data.message;
                            }
                        } catch (err) {
                            console.warn('Subscription backend fallback:', err);
                        }

                        try {
                            const list = JSON.parse(localStorage.getItem("satusite_newsletter_subs") || "[]");
                            if (!list.includes(emailVal)) {
                                list.push(emailVal);
                                localStorage.setItem("satusite_newsletter_subs", JSON.stringify(list));
                            }
                        } catch (e) {}

                        subBtn.className = "w-full sm:w-auto px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs transition-colors shrink-0 shadow-lg shadow-emerald-500/20";
                        subBtn.innerHTML = '<i class="fa-solid fa-check text-xs mr-1"></i> <span>Terdaftar!</span>';
                        subEmail.value = "";
                        subStatus.innerHTML = `<span class="text-emerald-400 font-semibold"><i class="fa-solid fa-circle-check text-[11px] mr-1"></i> ${successMsg}</span>`;

                        setTimeout(() => {
                            subBtn.disabled = false;
                            subBtn.className = "w-full sm:w-auto px-5 py-3 rounded-xl bg-white hover:bg-zinc-200 text-zinc-950 font-bold text-xs transition-colors shrink-0 cursor-pointer shadow-md";
                            subBtn.innerHTML = "<span>Berlangganan</span>";
                        }, 5000);
                    });
                }
        });
    </script>

    <!-- Canvas Particles -->
    <script is:inline>
        (function () {
            const canvas = document.getElementById("particles-canvas");
            if (!canvas) return;
            const ctx = canvas.getContext("2d");
            if (!ctx) return;

            let particles = [];
            const count = 45;

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }

            function init() {
                resize();
                particles = Array.from({ length: count }, () => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.35,
                    vy: (Math.random() - 0.5) * 0.35,
                    size: Math.random() * 1.5 + 0.5,
                    opacity: Math.random() * 0.3 + 0.1,
                }));
            }

            function loop() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                for (let i = 0; i < particles.length; i++) {
                    const p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = canvas.width;
                    if (p.x > canvas.width) p.x = 0;
                    if (p.y < 0) p.y = canvas.height;
                    if (p.y > canvas.height) p.y = 0;

                    ctx.fillStyle = `rgba(59, 130, 246, ${p.opacity * 0.35})`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                }

                requestAnimationFrame(loop);
            }

            window.addEventListener("resize", resize);
            document.addEventListener("DOMContentLoaded", () => {
                init();
                loop();
            });
        })();
    </script>
</Layout>
