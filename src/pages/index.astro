---
import Layout from "../layouts/Layout.astro";
import CardScrollReveal from "../components/ui/CardScrollReveal";
import Footer from "../components/Footer.astro";
import HeaderNav from "../components/HeaderNav.astro";
---

<Layout title="Satusite Studio - Platform Pembuat Website AI Otonom">
    <!-- Fluid Ambient Canvas Particles Background -->
    <div
        id="particles-bg"
        class="fixed top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none"
    >
        <canvas
            id="particles-canvas"
            class="absolute inset-0 w-full h-full opacity-20"></canvas>
    </div>

    <!-- Subtle Ambient Dark Blue Gradients -->
    <div
        class="fixed top-[-10%] left-[20%] w-[500px] h-[400px] bg-blue-600/5 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>
    <div
        class="fixed bottom-[-10%] right-[15%] w-[500px] h-[400px] bg-blue-500/5 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
        <!-- ========================================== -->
        <!-- 1. SEAMLESS TOP NAVBAR                     -->
        <!-- ========================================== -->
        <HeaderNav activePage="home" />

        <!-- ========================================== -->
        <!-- 2. HERO SECTION: PROMPT BUILDER            -->
        <!-- ========================================== -->
        <section
            id="prompt-builder"
            class="min-h-[72vh] md:min-h-[78vh] flex flex-col justify-center pt-28 pb-32 md:pt-40 md:pb-44 px-6 text-center"
        >
            <div class="max-w-4xl mx-auto w-full space-y-6 sm:space-y-7">
                <!-- Alternating 1-Line Semi-Bold Information Banner (Fade in/out Up) -->
                <div
                    class="relative h-9 sm:h-10 flex items-center justify-center overflow-hidden"
                >
                    <div
                        id="hero-ticker-container"
                        class="w-full flex items-center justify-center"
                    >
                        <h1
                            id="hero-ticker-text"
                            class="hero-slide text-sm sm:text-base md:text-lg font-medium tracking-tight text-zinc-300 transition-all duration-500 ease-out truncate px-2"
                        >
                            Bangun Aplikasi & Website Lengkap With AI Agent
                        </h1>
                    </div>
                </div>

                <!-- PROMPT STUDIO BOX (Positioned Lower) -->
                <div
                    class="mt-4 sm:mt-6 max-w-3xl mx-auto bg-zinc-900/70 border border-zinc-800/90 rounded-2xl p-4 sm:p-5 text-left shadow-2xl backdrop-blur-xl"
                >
                    <form id="hero-prompt-form" class="space-y-3.5">
                        <div class="relative">
                            <textarea
                                id="hero-prompt-input"
                                rows="3"
                                placeholder="Tuliskan website yang ingin Anda buat... (Contoh: 'Buatkan landing page toko kopi lokal dengan menu lengkap, tombol pesan WhatsApp langsung, galeri foto, dan peta lokasi')"
                                class="w-full bg-zinc-950 border border-zinc-800 focus:border-zinc-700 rounded-xl p-3.5 sm:p-4 text-xs sm:text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none transition-all resize-none font-sans"
                            ></textarea>
                        </div>

                        <!-- Prompt controls bar -->
                        <div
                            class="flex items-center justify-between gap-3 pt-1"
                        >
                            <!-- Left: File Upload & Dark Mode Dropdown -->
                            <div class="flex items-center gap-1.5">
                                <label
                                    for="hero-file-upload"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Upload Dokumen / Gambar"
                                >
                                    <i class="fa-solid fa-paperclip text-xs"
                                    ></i>
                                    <input
                                        id="hero-file-upload"
                                        type="file"
                                        class="hidden"
                                        accept="image/*,.txt,.pdf,.json"
                                    />
                                </label>
                                <span
                                    id="hero-file-indicator"
                                    class="hidden text-[11px] text-zinc-300 bg-zinc-800 px-2 py-0.5 rounded truncate max-w-[140px]"
                                ></span>

                                <!-- Dark Minimalist Mode Dropdown (Fullstack / Frontend) -->
                                <div
                                    class="relative"
                                    id="hero-mode-dropdown-container"
                                >
                                    <button
                                        type="button"
                                        id="hero-btn-mode-dropdown"
                                        class="h-8 px-2.5 rounded-lg bg-zinc-950/80 hover:bg-zinc-800 border border-zinc-800 text-[11px] font-medium text-zinc-300 hover:text-white flex items-center gap-1.5 transition-all cursor-pointer shadow-sm"
                                        title="Pilih Mode Pengembangan"
                                    >
                                        <i
                                            id="hero-mode-icon"
                                            class="fa-solid fa-database text-xs text-blue-400 shrink-0"
                                        ></i>
                                        <span
                                            id="hero-mode-label"
                                            class="capitalize">Fullstack</span
                                        >
                                        <i
                                            id="hero-mode-chevron"
                                            class="fa-solid fa-chevron-down text-[9px] text-zinc-500 transition-transform duration-200"
                                        ></i>
                                    </button>

                                    <!-- Dropdown Popover Menu -->
                                    <div
                                        id="hero-mode-menu"
                                        class="hidden absolute top-full left-0 mt-1.5 w-56 p-1 bg-[#121215] border border-zinc-800 rounded-xl shadow-[0_8px_30px_rgba(0,0,0,0.85)] z-50 font-sans text-left"
                                    >
                                        <div
                                            class="px-2 py-0.5 text-[8.5px] font-medium text-zinc-500 uppercase tracking-wider border-b border-zinc-800/50 mb-0.5"
                                        >
                                            Pilih Mode
                                        </div>

                                        <!-- Option Fullstack -->
                                        <button
                                            type="button"
                                            data-mode="fullstack"
                                            class="hero-mode-item w-full px-2 py-1 rounded-lg flex items-center gap-2 text-left transition-colors cursor-pointer bg-zinc-800/90 text-white"
                                        >
                                            <div
                                                class="w-5 h-5 rounded bg-blue-950/70 border border-blue-800/30 text-blue-400 flex items-center justify-center shrink-0"
                                            >
                                                <i
                                                    class="fa-solid fa-database text-[10px]"
                                                ></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div
                                                    class="text-[11px] font-semibold text-zinc-100 leading-tight"
                                                    >Fullstack</div
                                                >
                                                <div
                                                    class="text-[9px] text-zinc-400 truncate leading-tight"
                                                >
                                                    CRUD, storage sync & UI.
                                                </div>
                                            </div>
                                        </button>

                                        <!-- Option Frontend -->
                                        <button
                                            type="button"
                                            data-mode="frontend"
                                            class="hero-mode-item w-full px-2 py-1 rounded-lg flex items-center gap-2 text-left transition-colors cursor-pointer mt-0.5 text-zinc-400 hover:bg-zinc-800/40 hover:text-zinc-200"
                                        >
                                            <div
                                                class="w-5 h-5 rounded bg-blue-950/70 border border-blue-800/30 text-blue-400 flex items-center justify-center shrink-0"
                                            >
                                                <i
                                                    class="fa-solid fa-table-columns text-[10px]"
                                                ></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div
                                                    class="text-[11px] font-semibold text-zinc-100 leading-tight"
                                                    >Frontend</div
                                                >
                                                <div
                                                    class="text-[9px] text-zinc-400 truncate leading-tight"
                                                >
                                                    Antarmuka visual responsif.
                                                </div>
                                            </div>
                                        </button>

                                        <!-- Option PRD -->
                                        <button
                                            type="button"
                                            data-mode="prd"
                                            class="hero-mode-item w-full px-2 py-1 rounded-lg flex items-center gap-2 text-left transition-colors cursor-pointer mt-0.5 text-zinc-400 hover:bg-zinc-800/40 hover:text-zinc-200"
                                        >
                                            <div
                                                class="w-5 h-5 rounded bg-zinc-800/80 border border-zinc-700/60 text-zinc-400 flex items-center justify-center shrink-0"
                                            >
                                                <i
                                                    class="fa-solid fa-file-lines text-[10px] text-zinc-400"
                                                ></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div
                                                    class="text-[11px] font-semibold text-zinc-100 leading-tight"
                                                    >PRD Blueprint</div
                                                >
                                                <div
                                                    class="text-[9px] text-zinc-400 truncate leading-tight"
                                                >
                                                    Spesifikasi sistem komprehensif.
                                                </div>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Voice Icon & Generate Arrow-Up / Stop Button (Borderless) -->
                            <div class="flex items-center gap-1.5">
                                <!-- Voice Dictation Icon -->
                                <button
                                    type="button"
                                    id="btn-hero-voice"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Input Suara"
                                >
                                    <i
                                        id="icon-voice"
                                        class="fa-solid fa-microphone text-xs"
                                    ></i>
                                </button>

                                <!-- Generate Arrow-Up / Stop Icon Button (Single Dynamic Icon, Borderless) -->
                                <button
                                     type="submit"
                                     id="btn-hero-generate"
                                     class="w-8 h-8 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-white transition-colors flex items-center justify-center cursor-pointer group shadow-sm border-0 outline-none"
                                     title="Generate Website"
                                >
                                     <i
                                         id="btn-hero-generate-icon"
                                         class="fa-solid fa-arrow-up text-xs text-zinc-300 group-hover:text-white group-hover:-translate-y-0.5 transition-transform"
                                     ></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 2.5 SERVICES / LAYANAN SECTION             -->
        <!-- ========================================== -->
        <section
            id="services"
            class="py-20 px-6 border-t border-zinc-800/80 bg-zinc-950/60 relative overflow-hidden"
        >
            <div class="max-w-7xl mx-auto space-y-12 relative z-10">
                <div class="text-center max-w-2xl mx-auto space-y-3">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 text-xs font-medium">
                        <i class="fa-solid fa-sparkles text-xs text-zinc-400"></i>
                        <span>Layanan & Kapabilitas Utama</span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white tracking-tight">
                        Solusi Pembuatan Web & Aplikasi Cerdas
                    </h2>
                    <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
                        Dari perancangan konsep visual, penyusunan arsitektur sistem, hingga rilis produksi global ke cloud dalam hitungan detik.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Service 1: Fullstack AI -->
                    <div class="bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700 rounded-2xl p-6 space-y-4 transition-all hover:bg-zinc-900/60 group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-sm group-hover:border-zinc-700 transition-colors">
                                <i class="fa-solid fa-database"></i>
                            </div>
                            <div class="space-y-1.5">
                                <h3 class="text-base font-semibold text-white group-hover:text-zinc-200 transition-colors">Generasi Fullstack AI</h3>
                                <p class="text-xs text-zinc-400 leading-relaxed">
                                    Pembuatan sistem web lengkap dengan skema data relasional in-memory, operasi CRUD, formulir interaktif, dan penyimpanan otomatis di browser.
                                </p>
                            </div>
                        </div>
                        <div class="space-y-3 pt-3 border-t border-zinc-800/60">
                            <ul class="text-xs text-zinc-400 space-y-1.5">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Database Mock JSON Terhubung</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Logika Bisnis & Filter Data</li>
                            </ul>
                            <div class="pt-1">
                                <a href="/app?mode=fullstack" class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-400 group-hover:text-white transition-colors">
                                    <span>Coba Fullstack Builder</span>
                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Service 2: Frontend & Landing Page -->
                    <div class="bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700 rounded-2xl p-6 space-y-4 transition-all hover:bg-zinc-900/60 group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-sm group-hover:border-zinc-700 transition-colors">
                                <i class="fa-solid fa-table-columns"></i>
                            </div>
                            <div class="space-y-1.5">
                                <h3 class="text-base font-semibold text-white group-hover:text-zinc-200 transition-colors">Desain UI/UX & Landing Page</h3>
                                <p class="text-xs text-zinc-400 leading-relaxed">
                                    Tampilan antarmuka modern yang estetik, konversi tinggi, dilengkapi animasi halus, dark mode elegan, dan tata letak mobile-first.
                                </p>
                            </div>
                        </div>
                        <div class="space-y-3 pt-3 border-t border-zinc-800/60">
                            <ul class="text-xs text-zinc-400 space-y-1.5">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Tipografi & Warna Kurasi Modern</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Integrasi Tombol Pesan WhatsApp</li>
                            </ul>
                            <div class="pt-1">
                                <a href="/app?mode=frontend" class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-400 group-hover:text-white transition-colors">
                                    <span>Rancang Tampilan UI</span>
                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Service 3: PRD & Architecture Blueprint -->
                    <div class="bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700 rounded-2xl p-6 space-y-4 transition-all hover:bg-zinc-900/60 group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-sm group-hover:border-zinc-700 transition-colors">
                                <i class="fa-solid fa-diagram-project"></i>
                            </div>
                            <div class="space-y-1.5">
                                <h3 class="text-base font-semibold text-white group-hover:text-zinc-200 transition-colors">Arsitektur PRD & Mindmap Interaktif</h3>
                                <p class="text-xs text-zinc-400 leading-relaxed">
                                    Penyusunan dokumen kebutuhan produk (PRD) komprehensif beserta diagram mindmap struktur fitur visual yang dapat diedit langsung.
                                </p>
                            </div>
                        </div>
                        <div class="space-y-3 pt-3 border-t border-zinc-800/60">
                            <ul class="text-xs text-zinc-400 space-y-1.5">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Diagram Tree Graph Node Interaktif</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Sinkronisasi Struktur ke Kode AI</li>
                            </ul>
                            <div class="pt-1">
                                <a href="/app?mode=prd" class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-400 group-hover:text-white transition-colors">
                                    <span>Buat Blueprint PRD</span>
                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Service 4: 1-Click Cloud Deployment -->
                    <div class="bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700 rounded-2xl p-6 space-y-4 transition-all hover:bg-zinc-900/60 group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-sm group-hover:border-zinc-700 transition-colors">
                                <i class="fa-solid fa-rocket"></i>
                            </div>
                            <div class="space-y-1.5">
                                <h3 class="text-base font-semibold text-white group-hover:text-zinc-200 transition-colors">1-Click Cloud Deployment</h3>
                                <p class="text-xs text-zinc-400 leading-relaxed">
                                    Publikasikan website Anda langsung ke jaringan global Edge Vercel, Netlify, atau Cloudflare dengan alokasi sertifikat SSL otomatis.
                                </p>
                            </div>
                        </div>
                        <div class="space-y-3 pt-3 border-t border-zinc-800/60">
                            <ul class="text-xs text-zinc-400 space-y-1.5">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Dukungan Custom Domain Pribadi</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Live Streaming Build Console</li>
                            </ul>
                            <div class="pt-1">
                                <a href="/deploy" class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-400 group-hover:text-white transition-colors">
                                    <span>Kunjungi Deploy Hub</span>
                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Service 5: GitHub Version Control -->
                    <div class="bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700 rounded-2xl p-6 space-y-4 transition-all hover:bg-zinc-900/60 group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-sm group-hover:border-zinc-700 transition-colors">
                                <i class="fa-brands fa-github"></i>
                            </div>
                            <div class="space-y-1.5">
                                <h3 class="text-base font-semibold text-white group-hover:text-zinc-200 transition-colors">Sinkronisasi & Push GitHub</h3>
                                <p class="text-xs text-zinc-400 leading-relaxed">
                                    Hubungkan dan push seluruh bundle kode HTML/CSS/JS mandiri ke repositori GitHub pribadi atau organisasi Anda secara instan.
                                </p>
                            </div>
                        </div>
                        <div class="space-y-3 pt-3 border-t border-zinc-800/60">
                            <ul class="text-xs text-zinc-400 space-y-1.5">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Generator Pesan Commit Cerdas AI</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Staging File Tree & Dokumentasi README</li>
                            </ul>
                            <div class="pt-1">
                                <a href="/github" class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-400 group-hover:text-white transition-colors">
                                    <span>Kunjungi GitHub Hub</span>
                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Service 6: Automated Testing & QA -->
                    <div class="bg-zinc-900/40 border border-zinc-800/80 hover:border-zinc-700 rounded-2xl p-6 space-y-4 transition-all hover:bg-zinc-900/60 group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-300 flex items-center justify-center text-sm group-hover:border-zinc-700 transition-colors">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div class="space-y-1.5">
                                <h3 class="text-base font-semibold text-white group-hover:text-zinc-200 transition-colors">Testing & QA Quality Assurance</h3>
                                <p class="text-xs text-zinc-400 leading-relaxed">
                                    Pengujian integritas kode, audit performa Core Web Vitals, kepatuhan aksesibilitas A11y, dan simulator viewport multi-perangkat.
                                </p>
                            </div>
                        </div>
                        <div class="space-y-3 pt-3 border-t border-zinc-800/60">
                            <ul class="text-xs text-zinc-400 space-y-1.5">
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> Skor Audit Lighthouse Real-time</li>
                                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-zinc-400 text-[10px]"></i> 0 Console Runtime Error Guarantee</li>
                            </ul>
                            <div class="pt-1">
                                <a href="/testing" class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-400 group-hover:text-white transition-colors">
                                    <span>Uji Kualitas Website</span>
                                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 3. HOW IT WORKS (3 LANGKAH MUDAH)          -->
        <!-- ========================================== -->
        <section
            id="how-it-works"
            class="py-16 px-6 border-t border-zinc-800/80 bg-zinc-950/40"
        >
            <div class="max-w-7xl mx-auto space-y-10">
                <div class="text-center max-w-xl mx-auto space-y-2">
                    <h2
                        class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400 font-mono"
                    >
                        Proses Sangat Sederhana
                    </h2>
                    <h3 class="text-2xl md:text-3xl font-bold text-white">
                        Cara Kerja dalam 3 Langkah
                    </h3>
                    <p class="text-xs text-zinc-400">
                        Dari sekadar ide di kepala hingga menjadi website
                        fungsional yang siap digunakan.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Step 1 -->
                    <div
                        class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-6 space-y-3 relative hover:border-zinc-700 transition-colors"
                    >
                        <div
                            class="w-9 h-9 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-200 font-bold text-sm font-mono"
                        >
                            01
                        </div>
                        <h4 class="text-sm font-semibold text-white">
                            Tulis Keinginan Anda
                        </h4>
                        <p class="text-xs text-zinc-400 leading-relaxed">
                            Cukup ketik jenis website, warna, dan fitur apa saja
                            yang Anda butuhkan menggunakan bahasa Indonesia
                            sehari-hari.
                        </p>
                    </div>

                    <!-- Step 2 -->
                    <div
                        class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-6 space-y-3 relative hover:border-zinc-700 transition-colors"
                    >
                        <div
                            class="w-9 h-9 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-200 font-bold text-sm font-mono"
                        >
                            02
                        </div>
