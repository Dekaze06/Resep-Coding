---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Satusite Studio - Platform Pembuat Website AI Otonom">
    <!-- ========================================== -->
    <!-- 0. 3D NODE & WELCOME SCREEN (INITIAL LOAD) -->
    <!-- ========================================== -->
    <div
        id="welcome-screen"
        class="fixed inset-0 z-50 bg-[#09090b] flex flex-col items-center justify-center transition-opacity duration-700 pointer-events-auto select-none"
    >
        <!-- 3D Node Mesh Canvas -->
        <canvas
            id="welcome-3d-canvas"
            class="absolute inset-0 w-full h-full pointer-events-none opacity-50"
        ></canvas>

        <!-- Center Content with 3D Floating Logo -->
        <div
            class="relative z-10 flex flex-col items-center text-center space-y-4 px-6"
        >
            <div class="relative">
                <div
                    class="absolute -inset-4 bg-blue-600/15 rounded-full blur-2xl animate-pulse"
                >
                </div>
                <img
                    src="/logo.png"
                    alt="Satusite Logo"
                    class="w-16 h-16 sm:w-20 sm:h-20 object-contain relative animate-logo-float drop-shadow-[0_15px_35px_rgba(0,0,0,0.9)]"
                />
            </div>

            <div class="space-y-1">
                <h2
                    id="welcome-text-title"
                    class="text-lg sm:text-xl font-bold text-white tracking-tight"
                >
                    Halo..
                </h2>
                <p
                    id="welcome-text-sub"
                    class="text-xs text-zinc-400 font-medium"
                >
                    Menyiapkan Satusite Studio
                </p>
            </div>

            <!-- Sleek Minimalist Progress Bar -->
            <div
                class="w-32 h-1 bg-zinc-900 rounded-full overflow-hidden border border-zinc-800/80 mt-2"
            >
                <div
                    id="welcome-progress-bar"
                    class="h-full bg-blue-500 rounded-full w-0 transition-all duration-700 ease-out"
                >
                </div>
            </div>
        </div>

        <!-- Skip Button -->
        <button
            id="btn-skip-welcome"
            class="absolute bottom-6 text-[10px] font-medium text-zinc-600 hover:text-zinc-400 transition-colors z-20 cursor-pointer"
        >
            Lewati
        </button>
    </div>

    <!-- Fluid Ambient Canvas Particles Background -->
    <div
        id="particles-bg"
        class="fixed top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none"
    >
        <canvas
            id="particles-canvas"
            class="absolute inset-0 w-full h-full opacity-20"></canvas>
    </div>

    <!-- Subtle Ambient Dark Blue Gradients -->
    <div
        class="fixed top-[-10%] left-[20%] w-[500px] h-[400px] bg-blue-600/5 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>
    <div
        class="fixed bottom-[-10%] right-[15%] w-[500px] h-[400px] bg-blue-500/5 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
        <!-- ========================================== -->
        <!-- 1. SEAMLESS TOP NAVBAR                     -->
        <!-- ========================================== -->
        <header
            class="sticky top-0 z-40 px-6 py-4 bg-[#09090b]/40 backdrop-blur-md transition-all"
        >
            <div class="max-w-7xl mx-auto flex items-center justify-between">
                <!-- Brand Logo (Border-less) with Typography -->
                <a href="/" class="flex items-center gap-2.5 group">
                    <img
                        src="/logo.png"
                        alt="satusitE Logo"
                        class="w-5 h-5 sm:w-5.5 sm:h-5.5 object-contain transition-transform group-hover:scale-105"
                    />
                    <span
                        class="font-agus text-sm sm:text-base font-normal tracking-[0.35em] text-white"
                    >
                        satusitE
                    </span>
                </a>

                <!-- Navigation Links -->
                <nav
                    class="hidden md:flex items-center gap-8 text-xs font-medium text-zinc-400"
                >
                    <a
                        href="#prompt-builder"
                        class="hover:text-white transition-colors">Studio</a
                    >
                    <a
                        href="#how-it-works"
                        class="hover:text-white transition-colors">Cara Kerja</a
                    >
                    <a
                        href="#for-who"
                        class="hover:text-white transition-colors"
                        >Untuk Siapa</a
                    >
                    <a
                        href="#showcase"
                        class="hover:text-white transition-colors"
                        >Contoh Website</a
                    >
                    <a href="#faq" class="hover:text-white transition-colors"
                        >FAQ</a
                    >
                </nav>

                <!-- Right Action Items -->
                <div class="flex items-center gap-2.5">
                    <!-- 1. Logged-out Login Button -->
                    <a
                        id="nav-btn-login"
                        href="/login"
                        class="px-3 py-1.5 rounded-lg border border-zinc-800 hover:border-zinc-700 bg-zinc-900/60 text-xs font-medium text-zinc-300 hover:text-white transition-all flex items-center gap-1.5"
                    >
                        <i class="fa-regular fa-user text-zinc-400 text-xs"></i>
                        <span>Masuk</span>
                    </a>

                    <!-- 2. Logged-in Account Dropdown Menu (Hidden if not logged in) -->
                    <div class="relative hidden" id="nav-account-dropdown-container">
                        <button
                            type="button"
                            id="nav-btn-account"
                            class="h-8 px-2.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-xs font-medium text-zinc-200 flex items-center gap-2 transition-all cursor-pointer shadow-sm"
                        >
                            <img
                                id="nav-user-avatar"
                                src="https://api.dicebear.com/7.x/initials/svg?seed=User&backgroundColor=27272a"
                                alt="Avatar"
                                class="w-4 h-4 rounded-md object-cover bg-zinc-800 shrink-0"
                            />
                            <span id="nav-user-name" class="max-w-[100px] truncate text-xs font-medium text-zinc-200">Akun</span>
                            <i class="fa-solid fa-chevron-down text-[9px] text-zinc-500 transition-transform duration-200" id="nav-account-chevron"></i>
                        </button>

                        <!-- Dropdown Popover Menu -->
                        <div
                            id="nav-account-menu"
                            class="hidden absolute right-0 mt-2 w-52 p-1.5 bg-[#121215] border border-zinc-800 rounded-xl shadow-[0_10px_38px_rgba(0,0,0,0.85)] z-50 text-left font-sans animate-fade-in-up"
                        >
                            <div class="px-2.5 py-1.5 border-b border-zinc-800/60 mb-1">
                                <p id="nav-menu-user-name" class="text-xs font-bold text-white truncate">Klien SatuSite</p>
                                <p id="nav-menu-user-email" class="text-[10px] text-zinc-500 truncate">demo@satusite.studio</p>
                            </div>
                            
                            <!-- Aplikasi Saya in Dropdown -->
                            <button
                                type="button"
                                id="nav-menu-btn-projects"
                                class="w-full px-2.5 py-2 rounded-lg text-xs text-zinc-300 hover:text-white hover:bg-zinc-800/80 flex items-center gap-2.5 transition-colors cursor-pointer text-left"
                            >
                                <i class="fa-regular fa-folder text-zinc-400 w-3.5 text-center"></i>
                                <span>Aplikasi Saya</span>
                            </button>

                            <!-- Portal Klien in Dropdown -->
                            <a
                                href="/portal"
                                class="w-full px-2.5 py-2 rounded-lg text-xs text-zinc-300 hover:text-white hover:bg-zinc-800/80 flex items-center gap-2.5 transition-colors text-left"
                            >
                                <i class="fa-solid fa-layer-group text-zinc-400 w-3.5 text-center"></i>
                                <span>Portal Klien</span>
                            </a>

                            <!-- Logout Action in Dropdown -->
                            <div class="border-t border-zinc-800/60 mt-1 pt-1">
                                <button
                                    type="button"
                                    id="nav-menu-btn-logout"
                                    class="w-full px-2.5 py-1.5 rounded-lg text-xs text-red-400 hover:text-red-300 hover:bg-red-500/10 flex items-center gap-2.5 transition-colors cursor-pointer text-left"
                                >
                                    <i class="fa-solid fa-arrow-right-from-bracket w-3.5 text-center"></i>
                                    <span>Keluar (Logout)</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Buka Studio Button (Dark Grey) -->
                    <a
                        href="/app"
                        class="px-4 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-white text-xs font-semibold transition-all flex items-center gap-1.5 shadow-sm"
                    >
                        <span>Buka Studio</span>
                        <i class="fa-solid fa-arrow-right text-[10px] text-zinc-400"></i>
                    </a>
                </div>
            </div>
        </header>

        <!-- ========================================== -->
        <!-- 2. HERO SECTION: PROMPT BUILDER            -->
        <!-- ========================================== -->
        <section
            id="prompt-builder"
            class="min-h-[72vh] md:min-h-[78vh] flex flex-col justify-center pt-28 pb-32 md:pt-40 md:pb-44 px-6 text-center"
        >
            <div class="max-w-4xl mx-auto w-full space-y-6 sm:space-y-7">
                <!-- Alternating 1-Line Semi-Bold Information Banner (Fade in/out Up) -->
                <div
                    class="relative h-9 sm:h-10 flex items-center justify-center overflow-hidden"
                >
                    <div
                        id="hero-ticker-container"
                        class="w-full flex items-center justify-center"
                    >
                        <h1
                            id="hero-ticker-text"
                            class="hero-slide text-sm sm:text-base md:text-lg font-medium tracking-tight text-zinc-300 transition-all duration-500 ease-out truncate px-2"
                        >
                            Bangun Aplikasi & Website Lengkap With AI Agent
                        </h1>
                    </div>
                </div>

                <!-- PROMPT STUDIO BOX (Positioned Lower) -->
                <div
                    class="mt-8 sm:mt-12 max-w-3xl mx-auto bg-zinc-900/70 border border-zinc-800/90 rounded-2xl p-4 sm:p-5 text-left shadow-2xl backdrop-blur-xl"
                >
                    <form id="hero-prompt-form" class="space-y-3.5">
                        <div class="relative">
                            <textarea
                                id="hero-prompt-input"
                                rows="3"
                                placeholder="Tuliskan website yang ingin Anda buat... (Contoh: 'Buatkan landing page toko kopi lokal dengan menu lengkap, tombol pesan WhatsApp langsung, galeri foto, dan peta lokasi')"
                                class="w-full bg-zinc-950 border border-zinc-800 focus:border-zinc-700 rounded-xl p-3.5 sm:p-4 text-xs sm:text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none transition-all resize-none font-sans"
                            ></textarea>
                        </div>

                        <!-- Prompt controls bar -->
                        <div
                            class="flex items-center justify-between gap-3 pt-1"
                        >
                            <!-- Left: File Upload & Dark Mode Dropdown -->
                            <div class="flex items-center gap-1.5">
                                <label
                                    for="hero-file-upload"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Upload Dokumen / Gambar"
                                >
                                    <i class="fa-solid fa-paperclip text-xs"
                                    ></i>
                                    <input
                                        id="hero-file-upload"
                                        type="file"
                                        class="hidden"
                                        accept="image/*,.txt,.pdf,.json"
                                    />
                                </label>
                                <span
                                    id="hero-file-indicator"
                                    class="hidden text-[11px] text-zinc-300 bg-zinc-800 px-2 py-0.5 rounded truncate max-w-[140px]"
                                ></span>

                                <!-- Dark Minimalist Mode Dropdown (Fullstack / Frontend) -->
                                <div
                                    class="relative"
                                    id="hero-mode-dropdown-container"
                                >
                                    <button
                                        type="button"
                                        id="hero-btn-mode-dropdown"
                                        class="h-8 px-2.5 rounded-lg bg-zinc-950/80 hover:bg-zinc-800 border border-zinc-800 text-[11px] font-medium text-zinc-300 hover:text-white flex items-center gap-1.5 transition-all cursor-pointer shadow-sm"
                                        title="Pilih Mode Pengembangan"
                                    >
                                        <i
                                            id="hero-mode-icon"
                                            class="fa-solid fa-database text-xs text-blue-400 shrink-0"
                                        ></i>
                                        <span
                                            id="hero-mode-label"
                                            class="capitalize">Fullstack</span
                                        >
                                        <i
                                            id="hero-mode-chevron"
                                            class="fa-solid fa-chevron-down text-[9px] text-zinc-500 transition-transform duration-200"
                                        ></i>
                                    </button>

                                    <!-- Dropdown Popover Menu -->
                                    <div
                                        id="hero-mode-menu"
                                        class="hidden absolute bottom-full left-0 mb-2 w-64 p-1.5 bg-[#121215] border border-zinc-800 rounded-xl shadow-[0_10px_38px_rgba(0,0,0,0.85)] z-50 font-sans text-left"
                                    >
                                        <div
                                            class="px-2.5 py-1 text-[9px] font-semibold text-zinc-500 uppercase tracking-wider border-b border-zinc-800/50 mb-1"
                                        >
                                            Pilih Mode Pengembangan
                                        </div>

                                        <!-- Option Fullstack -->
                                        <button
                                            type="button"
                                            data-mode="fullstack"
                                            class="hero-mode-item w-full p-2 rounded-lg flex items-start gap-2.5 text-left transition-colors cursor-pointer bg-zinc-800/90 text-white"
                                        >
                                            <div
                                                class="p-1.5 rounded-md bg-blue-950/70 border border-blue-800/30 text-blue-400 mt-0.5 shrink-0"
                                            >
                                                <i
                                                    class="fa-solid fa-database text-xs"
                                                ></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <span
                                                    class="text-xs font-semibold text-zinc-100"
                                                    >Fullstack</span
                                                >
                                                <p
                                                    class="text-[10px] text-zinc-400 leading-snug mt-0.5"
                                                >
                                                    Skema data, operasi CRUD,
                                                    storage sync & UI lengkap.
                                                </p>
                                            </div>
                                        </button>

                                        <!-- Option Frontend -->
                                        <button
                                            type="button"
                                            data-mode="frontend"
                                            class="hero-mode-item w-full p-2 rounded-lg flex items-start gap-2.5 text-left transition-colors cursor-pointer mt-1 text-zinc-400 hover:bg-zinc-800/40 hover:text-zinc-200"
                                        >
                                            <div
                                                class="p-1.5 rounded-md bg-blue-950/70 border border-blue-800/30 text-blue-400 mt-0.5 shrink-0"
                                            >
                                                <i
                                                    class="fa-solid fa-table-columns text-xs"
                                                ></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <span
                                                    class="text-xs font-semibold text-zinc-100"
                                                    >Frontend</span
                                                >
                                                <p
                                                    class="text-[10px] text-zinc-400 leading-snug mt-0.5"
                                                >
                                                    Tampilan antarmuka visual
                                                    lengkap, estetik &
                                                    responsif.
                                                </p>
                                            </div>
                                        </button>

                                        <!-- Option PRD -->
                                        <button
                                            type="button"
                                            data-mode="prd"
                                            class="hero-mode-item w-full p-2 rounded-lg flex items-start gap-2.5 text-left transition-colors cursor-pointer mt-1 text-zinc-400 hover:bg-zinc-800/40 hover:text-zinc-200"
                                        >
                                            <div
                                                class="p-1.5 rounded-md bg-zinc-800/80 border border-zinc-700/60 text-zinc-400 mt-0.5 shrink-0"
                                            >
                                                <i
                                                    class="fa-solid fa-file-lines text-xs text-zinc-400"
                                                ></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <span
                                                    class="text-xs font-semibold text-zinc-100"
                                                    >PRD Blueprint</span
                                                >
                                                <p
                                                    class="text-[10px] text-zinc-400 leading-snug mt-0.5"
                                                >
                                                    Dokumen spesifikasi & arsitektur sistem komprehensif.
                                                </p>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Voice Icon & Generate Arrow-Up / Stop Button (Borderless) -->
                            <div class="flex items-center gap-1.5">
                                <!-- Voice Dictation Icon -->
                                <button
                                    type="button"
                                    id="btn-hero-voice"
                                    class="w-8 h-8 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors flex items-center justify-center cursor-pointer"
                                    title="Input Suara"
                                >
                                    <i
                                        id="icon-voice"
                                        class="fa-solid fa-microphone text-xs"
                                    ></i>
                                </button>

                                <!-- Generate Arrow-Up / Stop Icon Button (Single Dynamic Icon, Borderless) -->
                                <button
                                     type="submit"
                                     id="btn-hero-generate"
                                     class="w-8 h-8 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-white transition-colors flex items-center justify-center cursor-pointer group shadow-sm border-0 outline-none"
                                     title="Generate Website"
                                >
                                     <i
                                         id="btn-hero-generate-icon"
                                         class="fa-solid fa-arrow-up text-xs text-zinc-300 group-hover:text-white group-hover:-translate-y-0.5 transition-transform"
                                     ></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 3. HOW IT WORKS (3 LANGKAH MUDAH)          -->
        <!-- ========================================== -->
        <section
            id="how-it-works"
            class="py-16 px-6 border-t border-zinc-800/80 bg-zinc-950/40"
        >
            <div class="max-w-7xl mx-auto space-y-10">
                <div class="text-center max-w-xl mx-auto space-y-2">
                    <h2
                        class="text-[11px] font-semibold uppercase tracking-wider text-blue-400"
                    >
                        Proses Sangat Sederhana
                    </h2>
                    <h3 class="text-2xl md:text-3xl font-bold text-white">
                        Cara Kerja dalam 3 Langkah
                    </h3>
                    <p class="text-xs text-zinc-400">
                        Dari sekadar ide di kepala hingga menjadi website
                        fungsional yang siap digunakan.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Step 1 -->
                    <div
                        class="bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-6 space-y-3 relative"
                    >
                        <div
                            class="w-9 h-9 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center text-white font-bold text-sm"
                        >
                            01
                        </div>
                        <h4 class="text-sm font-bold text-white">
                            Tulis Keinginan Anda
                        </h4>
                        <p class="text-xs text-zinc-400 leading-relaxed">
                            Cukup ketik jenis website, warna, dan fitur apa saja
                            yang Anda butuhkan menggunakan bahasa Indonesia
                            sehari-hari.
                        </p>
                    </div>

                    <!-- Step 2 -->
                    <div
                        class="bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-6 space-y-3 relative"
                    >
                        <div
                            class="w-9 h-9 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center text-blue-400 font-bold text-sm"
                        >
                            02
                        </div>
                        <h4 class="text-sm font-bold text-white">
                            AI Agent Merancang & Membangun
                        </h4>
                        <p class="text-xs text-zinc-400 leading-relaxed">
                            AI Agent menyusun tata letak antarmuka responsif,
                            merangkai logika tombol dan form, lalu menyajikannya
                            secara instan.
                        </p>
                    </div>

                    <!-- Step 3 -->
                    <div
                        class="bg-zinc-900/60 border border-zinc-800/80 rounded-xl p-6 space-y-3 relative"
                    >
                        <div
                            class="w-9 h-9 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center text-white font-bold text-sm"
                        >
                            03
                        </div>
                        <h4 class="text-sm font-bold text-white">
                            Pakai & Unduh File Website
                        </h4>
                        <p class="text-xs text-zinc-400 leading-relaxed">
                            Uji coba tampilan di HP dan laptop. Unduh file HTML
                            mandiri untuk diunggah ke hosting atau dipakai
                            langsung tanpa batasan.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- 4. FOR WHO: PEMULA VS DEVELOPER MATRIX     -->
        <!-- ========================================== -->
        <section id="for-who" class="py-16 px-6 border-t border-zinc-800/80">
            <div class="max-w-7xl mx-auto space-y-10">
                <div class="text-center max-w-xl mx-auto space-y-2">
                    <h2
                        class="text-[11px] font-semibold uppercase tracking-wider text-blue-400"
                    >
                        Fleksibel & Terbuka
                    </h2>
                    <h3 class="text-2xl md:text-3xl font-bold text-white">
                        Didesain untuk Pemula & Developer
                    </h3>
                    <p class="text-xs text-zinc-400">
                        Solusi tanpa hambatan untuk non-teknis, sekaligus kanvas
                        fleksibel untuk programmer.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Card 1: For Laypersons / Business -->
                    <div
                        class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 space-y-5"
                    >
                        <div
                            class="flex items-center gap-3 pb-3 border-b border-zinc-800"
                        >
                            <div
                                class="w-9 h-9 rounded-lg bg-blue-600/15 border border-blue-500/30 flex items-center justify-center text-blue-400"
                            >
                                <i class="fa-solid fa-store text-sm"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white text-base">
                                    Untuk Pemula & Pelaku Usaha
                                </h4>
                                <p class="text-zinc-500 text-[11px]">
                                    Kemudahan tanpa perlu belajar coding
                                </p>
                            </div>
                        </div>

                        <ul class="space-y-3 text-xs text-zinc-300">
                            <li class="flex items-start gap-2.5">
                                <i
                                    class="fa-solid fa-check text-blue-400 text-xs mt-0.5"
                                ></i>
                                <span
                                    ><strong>Pemesanan WhatsApp Otomatis</strong
                                    >: Tombol langsung terhubung ke nomor
                                    WhatsApp admin dengan template pesan siap
                                    kirim.</span
                                >
                            </li>
                            <li class="flex items-start gap-2.5">
                                <i
                                    class="fa-solid fa-check text-blue-400 text-xs mt-0.5"
                                ></i>
                                <span
                                    ><strong>Desain Rapi & Responsif</strong>:
                                    Tampilan otomatis menyesuaikan layar
                                    smartphone, tablet, dan laptop pelanggan.</span
                                >
                            </li>
                            <li class="flex items-start gap-2.5">
                                <i
                                    class="fa-solid fa-check text-blue-400 text-xs mt-0.5"
                                ></i>
                                <span
                                    ><strong>Revisi Lewat Chat</strong>: Mau
                                    ganti warna atau ubah tulisan? Cukup ketik
                                    permintaannya di chat asisten.</span
                                >
                            </li>
                            <li class="flex items-start gap-2.5">
                                <i
                                    class="fa-solid fa-check text-blue-400 text-xs mt-0.5"
                                ></i>
                                <span
                                    ><strong
                                        >Bebas Biaya Berlangganan Ekspor</strong
                                    >: File website bisa Anda download gratis
                                    dan menjadi milik Anda 100%.</span
                                >
                            </li>
                        </ul>
                    </div>

                    <!-- Card 2: For Developers -->
                    <div
                        class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 space-y-5"
                    >
                        <div
