---
import Layout from '../layouts/Layout.astro';
---

<Layout>


    <!-- Dark Gradient Background (clean, elegant) -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none bg-[#050912]">
        <div class="absolute inset-0">
            <div class="absolute inset-0 opacity-100"
                 style="background: radial-gradient(100% 100% at 0% 0%, rgb(26, 42, 74) 0%, rgb(6, 9, 18) 100%); -webkit-mask: radial-gradient(125% 100% at 0% 0%, rgb(0,0,0) 0%, rgba(0,0,0,0.224) 88.2883%, rgba(0,0,0,0) 100%); mask: radial-gradient(125% 100% at 0% 0%, rgb(0,0,0) 0%, rgba(0,0,0,0.224) 88.2883%, rgba(0,0,0,0) 100%);">

                <!-- Skewed fading dark-blue streaks (matches primary/secondary/accent) -->
                <div class="absolute inset-0 opacity-20"
                     style="background: linear-gradient(rgb(143,178,224) 0%, rgba(143,178,224,0) 100%); -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 20%, rgba(0,0,0,0) 36%, rgb(0,0,0) 55%, rgba(0,0,0,0.13) 67%, rgb(0,0,0) 78%, rgba(0,0,0,0) 97%); mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 20%, rgba(0,0,0,0) 36%, rgb(0,0,0) 55%, rgba(0,0,0,0.13) 67%, rgb(0,0,0) 78%, rgba(0,0,0,0) 97%); transform: skewX(45deg);"></div>

                <div class="absolute inset-0 opacity-20"
                     style="background: linear-gradient(rgb(111,147,196) 0%, rgba(111,147,196,0) 100%); -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 11%, rgb(0,0,0) 25%, rgba(0,0,0,0.55) 41%, rgba(0,0,0,0.13) 67%, rgb(0,0,0) 78%, rgba(0,0,0,0) 97%); mask: linear-gradient(90deg, rgba(0,0,0,0) 11%, rgb(0,0,0) 25%, rgba(0,0,0,0.55) 41%, rgba(0,0,0,0.13) 67%, rgb(0,0,0) 78%, rgba(0,0,0,0) 97%); transform: skewX(45deg);"></div>

                <div class="absolute inset-0 opacity-20"
                     style="background: linear-gradient(rgb(59,90,138) 0%, rgba(59,90,138,0) 100%); -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 9%, rgb(0,0,0) 20%, rgba(0,0,0,0.55) 28%, rgba(0,0,0,0.424) 40%, rgb(0,0,0) 48%, rgba(0,0,0,0.267) 54%, rgba(0,0,0,0.13) 78%, rgb(0,0,0) 88%, rgba(0,0,0,0) 97%); mask: linear-gradient(90deg, rgba(0,0,0,0) 9%, rgb(0,0,0) 20%, rgba(0,0,0,0.55) 28%, rgba(0,0,0,0.424) 40%, rgb(0,0,0) 48%, rgba(0,0,0,0.267) 54%, rgba(0,0,0,0.13) 78%, rgb(0,0,0) 88%, rgba(0,0,0,0) 97%); transform: skewX(45deg);"></div>

                <div class="absolute inset-0 opacity-20"
                     style="background: linear-gradient(rgb(143,178,224) 0%, rgba(143,178,224,0) 100%); -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 17%, rgba(0,0,0,0.55) 26%, rgb(0,0,0) 35%, rgba(0,0,0,0) 47%, rgba(0,0,0,0.13) 69%, rgb(0,0,0) 79%, rgba(0,0,0,0) 97%); mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 17%, rgba(0,0,0,0.55) 26%, rgb(0,0,0) 35%, rgba(0,0,0,0) 47%, rgba(0,0,0,0.13) 69%, rgb(0,0,0) 79%, rgba(0,0,0,0) 97%); transform: skewX(45deg);"></div>

                <div class="absolute inset-0 opacity-20"
                     style="background: linear-gradient(rgb(111,147,196) 0%, rgba(111,147,196,0) 100%); -webkit-mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 20%, rgba(0,0,0,0.55) 27%, rgb(0,0,0) 42%, rgba(0,0,0,0) 48%, rgba(0,0,0,0.13) 67%, rgb(0,0,0) 74%, rgb(0,0,0) 82%, rgba(0,0,0,0.47) 88%, rgba(0,0,0,0) 97%); mask: linear-gradient(90deg, rgba(0,0,0,0) 0%, rgb(0,0,0) 20%, rgba(0,0,0,0.55) 27%, rgb(0,0,0) 42%, rgba(0,0,0,0) 48%, rgba(0,0,0,0.13) 67%, rgb(0,0,0) 74%, rgb(0,0,0) 82%, rgba(0,0,0,0.47) 88%, rgba(0,0,0,0) 97%); transform: skewX(45deg);"></div>
            </div>
        </div>

        <!-- Subtle noise texture -->
        <div class="absolute inset-0 opacity-5 bg-repeat"
             style="background-image: url('https://framerusercontent.com/images/6mcf62RlDfRfU61Yg5vb2pefpi4.png'); background-size: 149.76px;"></div>

        <!-- Subtle dot pattern overlay -->
        <div class="absolute inset-0 opacity-20"
             style="background-image: radial-gradient(circle at 1px 1px, rgba(111,147,196,0.5) 1px, transparent 0); background-size: 20px 20px;"></div>

        <!-- Subtle radial highlight -->
        <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 0%, rgba(59,90,138,0.30) 0%, transparent 60%);"></div>
    </div>

    <!-- Fluid Particles Background (Landing screen only) -->
    <!-- Sits above the dark gradient (-z-10) but below the page content. -->
    <!-- Fades/slides out in sync with #screen-landing when moving to the app screen. -->
    <div id="particles-bg" class="fixed top-0 left-0 w-full h-full overflow-hidden z-[-5] pointer-events-none">
        <canvas id="particles-canvas" class="absolute inset-0 w-full h-full"></canvas>
    </div>
    
    <!-- ============================= -->
    <!-- SCREEN 1: LANDING / START     -->
    <!-- ============================= -->
    <div id="screen-landing" class="min-h-screen w-full flex flex-col items-center justify-center px-6 relative z-10">
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-center reveal">
            <span class="gradient-text">Resep Coding</span>
        </h1>
        
        <!-- Kalimat menarik yang baru ditambahkan -->
        <p class="mt-6 text-gray-400 text-base md:text-lg text-center max-w-xl reveal" style="animation-delay: 0.1s;">
            Susun langkah, pantau progres, dan ubah ide luar biasamu menjadi website yang nyata dengan checklist pengembangan web terstruktur ini.
        </p>

        <!-- Primary actions -->
        <div class="flex items-center gap-3 mt-10 reveal" style="animation-delay: 0.2s;">
            <button id="btn-new-project" type="button" class="px-5 py-2.5 rounded-full glass-panel border border-white/10 text-sm font-semibold text-gray-200 hover:border-primary/50 hover:text-white transition-all duration-300 flex items-center gap-2">
                <i class="fa-solid fa-plus text-xs"></i> New Project
            </button>
            <button id="btn-load-project" type="button" class="px-5 py-2.5 rounded-full glass-panel border border-white/10 text-sm font-semibold text-gray-200 hover:border-primary/50 hover:text-white transition-all duration-300 flex items-center gap-2">
                <i class="fa-solid fa-folder-open text-xs"></i> Load Project
            </button>
        </div>

        <!-- Dynamic panel: new project input OR load project list -->
        <div id="landing-panel" class="w-full max-w-md mt-6 hidden"></div>

        <!-- Start button (Interactive Hover Button) -->
        <button id="btn-start" type="button" data-status="idle" class="ihb-start hidden mt-8">
            <span class="ihb-dot"></span>
            <span class="ihb-idle-label">Mulai Develop</span>
            <span class="ihb-hover-layer">
                <span class="ihb-state ihb-state-idle">
                    <span>Mulai Develop</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </span>
                <span class="ihb-state ihb-state-loading">
                    <span class="ihb-spinner"></span>
                    <span>Menyiapkan...</span>
                </span>
                <span class="ihb-state ihb-state-success">
                    <i class="fa-solid fa-check"></i>
                    <span>Siap!</span>
                </span>
            </span>
        </button>
    </div>

    <!-- ============================= -->
    <!-- SCREEN 2: STEP-BY-STEP APP    -->
    <!-- ============================= -->
    <div id="screen-app" class="hidden">

    <!-- Hero Section -->
    <section class="relative pt-16 pb-16 lg:pt-20 lg:pb-24 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full glass-panel border border-white/10 text-xs font-medium text-gray-300 mb-3 mx-auto reveal">
                <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                <span id="active-project-name">Project</span>
            </div>
            <button id="btn-back-to-landing" type="button" class="block mx-auto mb-5 text-[11px] text-white/90 hover:text-white transition-colors">
                <i class="fa-solid fa-arrow-left mr-1"></i>Ganti Project
            </button>
            <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 reveal" style="animation-delay: 0.1s;">
                Langkah-Langkah <br class="hidden md:block" />
                <span class="gradient-text">Resep Coding</span>
            </h1>
            <p class="mt-4 max-w-2xl text-lg text-gray-400 mx-auto mb-10 reveal" style="animation-delay: 0.2s;">
                Centang setiap prosesnya. Progres Anda akan otomatis tersimpan di browser. Mari kita bangun website luar biasa mulai dari PRD hingga Testing.
            </p>
        </div>
    </section>

    <!-- Main Content Container -->
    <div id="app-layout-wrapper" class="max-w-7xl mx-auto px-6 lg:px-8 relative pb-20 flex gap-6 transition-all duration-500">
    <div id="task-column" class="w-full max-w-4xl mx-auto transition-all duration-500">

        <!-- Stepper Nav (Centered single item with animation) -->
        <div id="stepper-nav" class="mb-8 md:mb-12 select-none relative">
            <div class="flex items-center justify-center gap-6 md:gap-12">
                <!-- Kembali -->
                <button id="btn-slide-prev" type="button" class="shrink-0 w-10 h-10 md:w-11 md:h-11 rounded-full glass-panel border border-white/10 text-gray-300 hover:border-white/30 hover:text-white transition-all duration-300 flex items-center justify-center disabled:opacity-30 disabled:pointer-events-none z-10" aria-label="Kembali ke langkah sebelumnya">
                    <i class="fa-solid fa-arrow-left text-sm"></i>
                </button>

                <!-- Dynamic Centered Nav -->
                <div id="dynamic-nav-container" class="w-40 md:w-56 flex justify-center items-center relative h-16 md:h-20 overflow-hidden">
                    <!-- Dynamic content injected via JS -->
                </div>

                <!-- Lanjut -->
                <button id="btn-slide-next" type="button" class="shrink-0 w-10 h-10 md:w-11 md:h-11 rounded-full glass-panel border border-white/10 text-gray-300 hover:border-white/30 hover:text-white transition-all duration-300 flex items-center justify-center z-10" aria-label="Lanjut ke langkah berikutnya">
                    <i class="fa-solid fa-arrow-right text-sm"></i>
                </button>
            </div>

            <div class="text-center mt-3">
                <span id="slide-position-label" class="text-xs text-gray-500 font-medium tracking-wide">1 / 6</span>
            </div>
        </div>

        <!-- Slides Viewport -->
        <div id="slides-viewport" class="relative">

        <!-- 1. PRD Section -->
        <section id="prd" class="slide-panel slide-active relative z-10 pb-4">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-[#8fb2e0]/10 border border-[#8fb2e0]/30 flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-file-lines text-[#8fb2e0] text-sm"></i>
                </div>
                <h2 class="text-2xl font-bold">1. Planning & PRD</h2>
            </div>
            <p class="text-gray-400 mb-6 text-sm">Product Requirements Document adalah fondasi. Gunakan AI untuk mempercepat perumusan.</p>
            
            <div class="flex flex-col gap-4">
                <!-- Task PRD 1: Manual -->
                <div class="prd-task-wrapper">
                    <label class="task-container flex items-start gap-4 p-5 rounded-xl glass-panel cursor-pointer">
                        <input type="checkbox" data-group="prd-method" id="task-prd-1" class="task-checkbox hidden">
                        <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors mt-0.5">
                            <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="task-title font-medium text-gray-200 transition-all duration-300">Pembuatan Manual</h4>
                            <p class="text-sm text-gray-400 mt-1 task-desc">Jelaskan visi, misi, target user, dan daftar fitur utama secara rinci. Biarkan Claude menstrukturkannya menjadi dokumen PRD standar.</p>
                            <button type="button" class="prd-gen-toggle mt-4 px-4 py-2 text-xs font-semibold rounded-lg bg-gradient-to-r from-blue-600/20 to-indigo-600/20 border border-blue-500/30 text-blue-300 hover:text-white hover:border-blue-400 hover:from-blue-600/40 hover:to-indigo-600/40 transition-all shadow-[0_0_15px_rgba(59,130,246,0.15)] flex items-center gap-2" onclick="event.preventDefault(); event.stopPropagation(); togglePrdInput('manual')">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Generate PRD with AI
                            </button>
                        </div>
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-prd-1" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-prd-1');" aria-label="Lihat detail proses task-prd-1"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>
                    <!-- Inline expandable input for Manual -->
                    <div id="prd-input-manual" class="prd-inline-input hidden overflow-hidden transition-all duration-400 ease-out" style="max-height:0; opacity:0;">
                        <div class="mt-2 p-5 rounded-xl glass-panel border border-blue-500/20">
                            <div class="flex items-center gap-2 mb-4">
                                <i class="fa-solid fa-wand-magic-sparkles text-blue-400 text-sm"></i>
                                <span class="text-sm font-semibold text-blue-300">AI PRD Generator — Manual</span>
                            </div>
                            <div class="mb-4">
                                <label class="block text-xs font-medium text-gray-400 mb-1">Deskripsi Aplikasi</label>
                                <textarea id="prd-desc-manual" rows="3" required placeholder="Jelaskan visi, misi, target pengguna, dan fitur utama..." class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-colors resize-none"></textarea>
                            </div>
                            <div class="flex items-center gap-3">
                                <button type="button" class="prd-submit-btn px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white transition-colors text-xs font-semibold flex items-center gap-2" onclick="handleInlineGenerate('manual')">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Generate</span>
                                </button>
                                <p class="prd-inline-error text-red-400 text-xs hidden"></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Task PRD 2: Cloning -->
                <div class="prd-task-wrapper">
                    <label class="task-container flex items-start gap-4 p-5 rounded-xl glass-panel cursor-pointer">
                        <input type="checkbox" data-group="prd-method" id="task-prd-2" class="task-checkbox hidden">
                        <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors mt-0.5">
                            <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="task-title font-medium text-gray-200 transition-all duration-300">Cloning Ref Link Website Lain</h4>
                            <p class="text-sm text-gray-400 mt-1 task-desc">Berikan URL referensi kompetitor. Prompt: <i>"Analisis website [URL], dan buatkan PRD untuk membuat versi yang lebih baik dengan tambahan fitur khusus."</i></p>
                            <button type="button" class="prd-gen-toggle mt-4 px-4 py-2 text-xs font-semibold rounded-lg bg-gradient-to-r from-blue-600/20 to-indigo-600/20 border border-blue-500/30 text-blue-300 hover:text-white hover:border-blue-400 hover:from-blue-600/40 hover:to-indigo-600/40 transition-all shadow-[0_0_15px_rgba(59,130,246,0.15)] flex items-center gap-2" onclick="event.preventDefault(); event.stopPropagation(); togglePrdInput('cloning')">
                                <i class="fa-solid fa-wand-magic-sparkles"></i> Generate PRD with AI
                            </button>
                        </div>
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-prd-2" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-prd-2');" aria-label="Lihat detail proses task-prd-2"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>
                    <!-- Inline expandable input for Cloning -->
                    <div id="prd-input-cloning" class="prd-inline-input hidden overflow-hidden transition-all duration-400 ease-out" style="max-height:0; opacity:0;">
                        <div class="mt-2 p-5 rounded-xl glass-panel border border-blue-500/20">
                            <div class="flex items-center gap-2 mb-4">
                                <i class="fa-solid fa-wand-magic-sparkles text-blue-400 text-sm"></i>
                                <span class="text-sm font-semibold text-blue-300">AI PRD Generator — Cloning</span>
                            </div>
                            <div class="mb-3">
                                <label class="block text-xs font-medium text-gray-400 mb-1">URL Referensi</label>
                                <input type="url" id="prd-url-cloning" placeholder="https://..." class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-colors">
                            </div>
                            <div class="mb-4">
                                <label class="block text-xs font-medium text-gray-400 mb-1">Deskripsi / Fitur Tambahan</label>
                                <textarea id="prd-desc-cloning" rows="3" required placeholder="Contoh: clone website ini, tambahkan fitur live chat dan dark mode..." class="w-full bg-black/30 border border-white/10 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition-colors resize-none"></textarea>
                            </div>
                            <div class="flex items-center gap-3">
                                <button type="button" class="prd-submit-btn px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white transition-colors text-xs font-semibold flex items-center gap-2" onclick="handleInlineGenerate('cloning')">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Generate</span>
                                </button>
                                <p class="prd-inline-error text-red-400 text-xs hidden"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. Front End Section -->
        <section id="frontend" class="slide-panel slide-next relative z-10 pb-4">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-[#6f93c4]/10 border border-[#6f93c4]/30 flex items-center justify-center shrink-0">
                    <i class="fa-brands fa-react text-[#6f93c4] text-sm"></i>
                </div>
                <h2 class="text-2xl font-bold">2. Front-End (Claude/Gemini)</h2>
            </div>
            <p class="text-gray-400 mb-6 text-sm">Menerjemahkan PRD menjadi antarmuka visual. Gunakan AI untuk generate boilerplate code & komponen.</p>
            
            <div class="flex flex-col gap-3">
                <!-- Task FE 1 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-1" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">1. UI/UX</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Tentukan Wireframing & Design System (Warna primer, sekunder, dan Spasi).</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-1" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-1');" aria-label="Lihat detail proses task-fe-1"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 2 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-2" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">2. Header</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Buat Navigasi Utama yang responsif (Hamburger menu di mobile).</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-2" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-2');" aria-label="Lihat detail proses task-fe-2"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 3 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-3" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">3. Title / Hero</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Rancang Hero section dengan Headline yang memikat dan CTA jelas.</p>
                    </div>
                
                        <button type="button" class="task-detail-btn shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-500 hover:text-primary hover:bg-primary/10 transition-all duration-300 self-center" data-task="task-fe-3" onclick="event.preventDefault(); event.stopPropagation(); openTaskModal('task-fe-3');" aria-label="Lihat detail proses task-fe-3"><i class="fa-solid fa-circle-info text-base"></i></button>
                    </label>

                <!-- Task FE 4 -->
                <label class="task-container flex items-center gap-4 p-4 rounded-xl glass-panel cursor-pointer">
                    <input type="checkbox" id="task-fe-4" class="task-checkbox hidden">
                    <div class="w-6 h-6 rounded border-2 border-gray-500 flex items-center justify-center shrink-0 transition-colors">
                        <i class="fa-solid fa-check text-white text-xs opacity-0 transition-opacity"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="task-title font-medium text-gray-200 transition-all duration-300">4. Layout</h4>
                        <p class="text-xs text-gray-400 mt-1 task-desc">Implementasi Grid System, Container, dan Card components.</p>
                    </div>
                
