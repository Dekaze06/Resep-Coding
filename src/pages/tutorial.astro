---
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Tutorial & Dokumentasi - Satusite Studio" description="Panduan langkah demi langkah menggunakan AI Studio, teknik prompt website modern, dan deployment.">
    <!-- Subtle Ambient Background Glows -->
    <div class="fixed top-[-10%] left-[20%] w-[500px] h-[400px] bg-blue-600/5 rounded-full blur-[140px] pointer-events-none z-0"></div>
    <div class="fixed bottom-[-10%] right-[15%] w-[500px] h-[400px] bg-emerald-500/5 rounded-full blur-[140px] pointer-events-none z-0"></div>

    <div class="relative z-10 flex flex-col min-h-screen bg-black text-white selection:bg-blue-500/30 selection:text-blue-200">
        <HeaderNav activePage="resources" />

        <main class="flex-1">
            <!-- Hero Header -->
            <section class="pt-12 pb-12 sm:pt-20 sm:pb-16 px-4 sm:px-6 text-center max-w-5xl mx-auto">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/90 border border-zinc-800 text-[11px] font-mono text-zinc-300 mb-6">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>PANDUAN & DOKUMENTASI RESMI</span>
            </div>

            <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white font-sans max-w-4xl mx-auto leading-[1.15]">
                Tutorial & Panduan AI Studio
            </h1>
            <p class="mt-4 sm:mt-6 text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto leading-relaxed">
                Pelajari cara memanfaatkan kecerdasan buatan untuk merancang, menguji, dan mendeploy website full-stack profesional dalam hitungan menit.
            </p>
        </section>

        <!-- Tutorials Grid (2 columns on mobile, compact & neat) -->
        <section class="max-w-6xl mx-auto px-3 sm:px-6 pb-20">
            <div class="grid grid-cols-2 gap-2.5 sm:gap-6">
                
                <!-- Tutorial 1 -->
                <div class="p-3.5 sm:p-6 rounded-xl sm:rounded-2xl bg-[#0d0d10] border border-zinc-800 hover:border-zinc-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-1.5 text-[10px] sm:text-xs font-mono text-blue-400 mb-2 sm:mb-3">
                            <i class="fa-solid fa-1 text-[9px] sm:text-xs"></i>
                            <span>MODUL 1 • DASAR</span>
                        </div>
                        <h3 class="text-xs sm:text-lg font-bold text-white mb-1.5 sm:mb-2">Membuat Website dengan AI Studio</h3>
                        <p class="text-[11px] sm:text-xs text-zinc-400 leading-relaxed mb-3 sm:mb-4 line-clamp-3 sm:line-clamp-none">
                            Ikuti alur wizard: tentukan nama website, kategori, tema warna, audiens, dan instruksi detail.
                        </p>
                    </div>
                    <a href="/app" class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-white hover:text-blue-400 transition-colors">
                        <span>Coba di Studio</span>
                        <i class="fa-solid fa-arrow-right text-[9px]"></i>
                    </a>
                </div>

                <!-- Tutorial 2 -->
                <div class="p-3.5 sm:p-6 rounded-xl sm:rounded-2xl bg-[#0d0d10] border border-zinc-800 hover:border-zinc-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-1.5 text-[10px] sm:text-xs font-mono text-emerald-400 mb-2 sm:mb-3">
                            <i class="fa-solid fa-2 text-[9px] sm:text-xs"></i>
                            <span>MODUL 2 • FULLSTACK</span>
                        </div>
                        <h3 class="text-xs sm:text-lg font-bold text-white mb-1.5 sm:mb-2">Kelola Data In-Memory & Admin</h3>
                        <p class="text-[11px] sm:text-xs text-zinc-400 leading-relaxed mb-3 sm:mb-4 line-clamp-3 sm:line-clamp-none">
                            Pelajari cara AI Engine mengintegrasikan state database lokal untuk katalog produk dan dashboard inventori.
                        </p>
                    </div>
                    <a href="/product/fullstack" class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-white hover:text-emerald-400 transition-colors">
                        <span>Mode Fullstack</span>
                        <i class="fa-solid fa-arrow-right text-[9px]"></i>
                    </a>
                </div>

                <!-- Tutorial 3 -->
                <div class="p-3.5 sm:p-6 rounded-xl sm:rounded-2xl bg-[#0d0d10] border border-zinc-800 hover:border-zinc-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-1.5 text-[10px] sm:text-xs font-mono text-purple-400 mb-2 sm:mb-3">
                            <i class="fa-solid fa-3 text-[9px] sm:text-xs"></i>
                            <span>MODUL 3 • GIT</span>
                        </div>
                        <h3 class="text-xs sm:text-lg font-bold text-white mb-1.5 sm:mb-2">Sinkronisasi & Push ke GitHub</h3>
                        <p class="text-[11px] sm:text-xs text-zinc-400 leading-relaxed mb-3 sm:mb-4 line-clamp-3 sm:line-clamp-none">
                            Hubungkan PAT GitHub Anda untuk push kode langsung ke repository baru tanpa terminal manual.
                        </p>
                    </div>
                    <a href="/github" class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-white hover:text-purple-400 transition-colors">
                        <span>Buka GitHub Hub</span>
                        <i class="fa-solid fa-arrow-right text-[9px]"></i>
                    </a>
                </div>

                <!-- Tutorial 4 -->
                <div class="p-3.5 sm:p-6 rounded-xl sm:rounded-2xl bg-[#0d0d10] border border-zinc-800 hover:border-zinc-700 transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-1.5 text-[10px] sm:text-xs font-mono text-amber-400 mb-2 sm:mb-3">
                            <i class="fa-solid fa-4 text-[9px] sm:text-xs"></i>
                            <span>MODUL 4 • DEPLOY</span>
                        </div>
                        <h3 class="text-xs sm:text-lg font-bold text-white mb-1.5 sm:mb-2">Deploy ke Vercel & Netlify</h3>
                        <p class="text-[11px] sm:text-xs text-zinc-400 leading-relaxed mb-3 sm:mb-4 line-clamp-3 sm:line-clamp-none">
                            Publikasikan website statis ke edge serverless global dengan domain live HTTPS gratis dalam hitungan detik.
                        </p>
                    </div>
                    <a href="/deploy" class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-white hover:text-amber-400 transition-colors">
                        <span>Buka Deploy Hub</span>
                        <i class="fa-solid fa-arrow-right text-[9px]"></i>
                    </a>
                </div>

            </div>
        </section>
    </main>

    <!-- Global Footer -->
    <Footer />
</div>
</Layout>
