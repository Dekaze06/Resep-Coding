---
import Layout from "../layouts/Layout.astro";
import StudioElasticGallery from "../components/ui/StudioElasticGallery";
---

<Layout
    title="Pilih Studio AI - Satusite Studio"
    description="Pilih salah satu dari 4 studio AI khusus untuk merancang website otomatis terpandu, dokumen PRD arsitektur, antarmuka visual frontend, atau aplikasi fullstack."
>
    <!-- Fluid Ambient Canvas Particles Background -->
    <div
        id="particles-bg"
        class="fixed top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none"
    >
        <canvas
            id="particles-canvas"
            class="absolute inset-0 w-full h-full opacity-25"></canvas>
    </div>

    <!-- Subtle Clean Minimalist Glow Effects -->
    <div
        class="fixed top-[-10%] left-[25%] w-[600px] h-[500px] bg-zinc-800/15 rounded-full blur-[180px] pointer-events-none z-0"
    >
    </div>
    <div
        class="fixed bottom-[-10%] right-[20%] w-[600px] h-[500px] bg-zinc-800/15 rounded-full blur-[180px] pointer-events-none z-0"
    >
    </div>

    <div class="relative z-10 flex flex-col min-h-screen bg-black text-white selection:bg-zinc-800 selection:text-white">
        
        <!-- SLEEK TOP BAR (STANDALONE STUDIO PORTAL NAV) -->
        <header class="h-14 sm:h-16 px-4 sm:px-8 border-b border-zinc-800/60 bg-zinc-950/70 backdrop-blur-xl flex items-center justify-between z-20 shrink-0">
            <div class="flex items-center gap-3">
                <a
                    href="/"
                    class="px-2.5 py-1.5 rounded-lg bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800/90 hover:border-zinc-700 text-zinc-400 hover:text-white text-xs font-medium transition-all flex items-center gap-2 cursor-pointer group"
                    title="Kembali ke Beranda"
                >
                    <i class="fa-solid fa-arrow-left text-[11px] group-hover:-translate-x-0.5 transition-transform"></i>
                    <span>Beranda</span>
                </a>
                <div class="h-4 w-[1px] bg-zinc-800"></div>
                <div class="flex items-center gap-2 select-none">
                    <img src="/logo.png" alt="Satusite Logo" class="w-5 h-5 object-contain" />
                    <span class="text-xs font-semibold text-zinc-300 tracking-tight">Satusite Studio</span>
                </div>
            </div>

            <!-- Right Quick Link -->
            <div class="flex items-center gap-2">
                <a
                    href="/pricing"
                    class="px-3 py-1.5 rounded-lg text-xs text-zinc-400 hover:text-white hover:bg-zinc-900 transition-colors flex items-center gap-1.5"
                >
                    <i class="fa-solid fa-crown text-[11px] text-amber-400"></i>
                    <span class="hidden sm:inline">Paket Berlangganan</span>
                </a>
                <a
                    href="/login"
                    id="portal-auth-btn"
                    class="px-3.5 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-xs font-semibold text-zinc-200 hover:text-white transition-colors"
                >
                    Masuk
                </a>
            </div>
        </header>

        <!-- MAIN STUDIO SELECTION CONTENT -->
        <main class="flex-1 flex flex-col justify-center py-10 sm:py-14 px-4 sm:px-6 max-w-7xl mx-auto w-full">
            
            <!-- Completely Stationary Header Section (No Vertical Scroll/Parallax Jumps) -->
            <div class="text-center max-w-2xl mx-auto space-y-3 mb-8 sm:mb-12">
                <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white font-sans">
                    Pilih Studio AI
                </h1>

                <p class="text-xs sm:text-sm text-zinc-400 max-w-xl mx-auto leading-relaxed">
                    Pilih lingkungan kerja AI khusus untuk memulai pembuatan aplikasi, dokumen blueprint arsitektur, antarmuka visual, atau logika database fullstack.
                </p>
            </div>

            <!-- 4 Elastic Animated Studio Cards (Accordion Expansion) -->
            <div class="w-full">
                <StudioElasticGallery client:load />
            </div>
        </main>
    </div>

    <!-- Auth check script for top bar -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            try {
                const userRaw = localStorage.getItem("satusite_auth_user");
                const authBtn = document.getElementById("portal-auth-btn");
                if (userRaw && authBtn) {
                    const user = JSON.parse(userRaw);
                    authBtn.href = "/portal";
                    authBtn.textContent = user.name ? user.name.split(" ")[0] : "Portal Klien";
                }
            } catch (e) {}
        });
    </script>

    <!-- Canvas Particles & Micro-Interaction Enhancements -->
    <script is:inline>
        (function () {
            const canvas = document.getElementById("particles-canvas");
            if (!canvas) return;
            const ctx = canvas.getContext("2d");
            if (!ctx) return;

            let particles = [];
            const count = 45;

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }

            function init() {
                resize();
                particles = Array.from({ length: count }, () => ({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.35,
                    vy: (Math.random() - 0.5) * 0.35,
                    size: Math.random() * 1.5 + 0.5,
                    opacity: Math.random() * 0.3 + 0.1,
                }));
            }

            function loop() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                for (let i = 0; i < particles.length; i++) {
                    const p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = canvas.width;
                    if (p.x > canvas.width) p.x = 0;
                    if (p.y < 0) p.y = canvas.height;
                    if (p.y > canvas.height) p.y = 0;

                    ctx.fillStyle = `rgba(255, 255, 255, ${p.opacity * 0.25})`;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                }

                requestAnimationFrame(loop);
            }

            window.addEventListener("resize", resize);
            document.addEventListener("DOMContentLoaded", () => {
                init();
                loop();
            });
        })();
    </script>
</Layout>
