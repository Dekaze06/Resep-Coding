---
import Layout from "../layouts/Layout.astro";
import HeroDock from "../components/ui/HeroDock";
---

<Layout
    title="Pilih Studio AI - Satusite Studio"
    description="Pilih salah satu dari 3 produk AI Studio: Planning untuk menyusun PRD & blueprint arsitektur, Build App untuk membuat aplikasi fullstack, atau Desain untuk merancang antarmuka visual layaknya Figma."
>
    <!-- Subtle Minimalist Top Gradient Glow & Micro Texture Background -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden select-none">
        <!-- Ambient Top Glow -->
        <div
            class="absolute inset-0"
            style="background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(120, 180, 255, 0.14), rgba(99, 102, 241, 0.06), transparent 70%), #000000;"
        >
        </div>

        <!-- Subtle Dot Grid Texture with Radial Fade -->
        <div class="absolute inset-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:24px_24px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_35%,#000_60%,transparent_100%)] opacity-70"></div>

        <!-- Soft Side Vignettes -->
        <div class="absolute inset-y-0 left-0 w-32 blur-2xl opacity-20 [background:linear-gradient(90deg,rgba(255,255,255,0.08),transparent)]"></div>
        <div class="absolute inset-y-0 right-0 w-32 blur-2xl opacity-20 [background:linear-gradient(270deg,rgba(255,255,255,0.08),transparent)]"></div>
    </div>

    <div class="relative z-10 flex flex-col min-h-screen bg-transparent text-white selection:bg-zinc-800 selection:text-white">
        
        <!-- SLEEK TOP BAR (STANDALONE STUDIO PORTAL NAV) -->
        <header class="h-14 sm:h-16 px-4 sm:px-8 border-b border-white/[0.06] bg-zinc-950/60 backdrop-blur-xl flex items-center justify-between z-20 shrink-0">
            <div class="flex items-center gap-3">
                <a
                    href="/"
                    class="px-2.5 py-1.5 rounded-lg bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800/90 hover:border-zinc-700 text-zinc-400 hover:text-white text-xs font-medium transition-all flex items-center gap-2 cursor-pointer group"
                    title="Kembali ke Beranda"
                >
                    <i class="fa-solid fa-arrow-left text-[11px] group-hover:-translate-x-0.5 transition-transform"></i>
                    <span>Beranda</span>
                </a>
                <div class="h-4 w-[1px] bg-zinc-800/80"></div>
                <div class="flex items-center gap-2 select-none">
                    <img src="/logo.png" alt="Satusite Logo" class="w-5 h-5 object-contain" />
                    <span class="text-xs font-semibold text-zinc-300 tracking-tight">Satusite Studio</span>
                </div>
            </div>

            <!-- Right Quick Link -->
            <div class="flex items-center gap-2">
                <a
                    href="/login"
                    id="portal-auth-btn"
                    class="px-3.5 py-1.5 rounded-lg bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-800 text-xs font-semibold text-zinc-200 hover:text-white transition-colors"
                >
                    Masuk
                </a>
            </div>
        </header>

        <!-- MAIN STUDIO SELECTION CONTENT (CENTERED ICON DOCK CONSOLE) -->
        <main class="flex-1 flex flex-col items-center justify-center px-4 sm:px-6 max-w-4xl mx-auto w-full my-auto py-8">
            
            <!-- Header Section -->
            <div class="text-center max-w-xl mx-auto space-y-3 mb-8 sm:mb-12">
                <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-b from-white via-zinc-100 to-zinc-400 font-sans">
                    Pilih Studio AI
                </h1>

                <p class="text-xs sm:text-sm text-zinc-400 max-w-xl mx-auto leading-relaxed">
                    Pilih ruang kerja cerdas khusus yang sesuai dengan kebutuhan proyek Anda.
                </p>
            </div>

            <!-- Studio Selection Dock Console -->
            <div class="w-full flex justify-center">
                <HeroDock client:load />
            </div>
        </main>
    </div>

    <!-- Auth check script for top bar -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            try {
                const userRaw = localStorage.getItem("satusite_auth_user");
                const authBtn = document.getElementById("portal-auth-btn");
                if (userRaw && authBtn) {
                    const user = JSON.parse(userRaw);
                    authBtn.href = "/portal";
                    authBtn.textContent = user.name ? user.name.split(" ")[0] : "Portal Klien";
                }
            } catch (e) {}
        });
    </script>

    <!-- Marquee & Hover Halo Styles -->
    <style is:global>
        @keyframes marqueeLeft { 0% { transform: translateX(-60%); } 100% { transform: translateX(0%); } }
        @keyframes marqueeRight { 0% { transform: translateX(60%); } 100% { transform: translateX(0%); } }
        .animate-marquee-left { animation: marqueeLeft 8s linear infinite alternate; }
        .animate-marquee-right { animation: marqueeRight 8s linear infinite alternate; }

        .hover-halo { position: relative; }
        .hover-halo::after {
            content: "";
            position: absolute;
            inset: -2px;
            border-radius: inherit;
            opacity: 0;
            transition: opacity .25s, transform .25s;
            box-shadow: 0 0 0 0 rgba(255,255,255,.18), 0 12px 30px -10px rgba(0,0,0,.7);
        }
        .hover-halo:hover::after { opacity: 1; }
        .tooltip { opacity: 0; transform: translateY(6px); transition: opacity .2s, transform .2s; }
        .group:hover .tooltip { opacity: 1; transform: translateY(0); }
    </style>
</Layout>
